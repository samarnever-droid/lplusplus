+int64_t lpp_net_send_all(int64_t handle, const char *data) {
+    if (handle < 0 || !data) return -1;
+    long total = 0;
+    long len = 0;
+    while (data[len]) len++;
+    while (total < len) {
+        int64_t sent = lpp_net_send(handle, data + total);
+        if (sent <= 0) return -1;
+        total += sent;
+    }
+    return 0;
+}

# add_remove.lpp — Add and remove dependencies in pure L++

import utils
import registry
import install

def cmd_add(package_name: Str, git_flag: Str, branch_flag: Str, tag_flag: Str, path_flag: Str, version_flag: Str) -> Void:
    if str_len(package_name) == 0:
        error("Usage: lpp add <package_name> [--git <url>] [--branch <b] [--tag <t>] [--path <p>] [--version <v>]")
        return

    if path_exists("lpp.toml") == 0:
        error("lpp.toml not found. Run 'lpp init' first.")
        return

    mut dep_name := package_name
    mut git_url := git_flag
    mut branch := branch_flag
    mut tag := tag_flag
    mut path := path_flag
    mut version := version_flag

    if str_len(git_url) == 0:
        if str_len(path) == 0:
            entry := registry_lookup(dep_name, false)
            if str_len(entry.name) > 0:
                info(str_concat("Resolved package from registry: ", dep_name))
                git_url = entry.git
            else:
                error(str_concat("Package not found in registry: ", dep_name))
                return

    # Strip @owner/ prefix for leaf dependency name in manifest
    if str_find(dep_name, "@") == 0:
        slash := str_find(dep_name, "/")
        if slash >= 0:
            dep_name = str_substr(dep_name, slash + 1, str_len(dep_name) - slash - 1)

    raw_toml := read_file("lpp.toml")
    mut dep_line := str_concat("\n", str_concat(dep_name, " = { "))

    if str_len(git_url) > 0:
        dep_line = str_concat(dep_line, str_concat("git = \"", str_concat(git_url, "\"")))
        if str_len(version) > 0:
            dep_line = str_concat(dep_line, str_concat(", version = \"", str_concat(version, "\"")))
        if str_len(tag) > 0:
            dep_line = str_concat(dep_line, str_concat(", tag = \"", str_concat(tag, "\"")))
        else:
            if str_len(branch) > 0:
                dep_line = str_concat(dep_line, str_concat(", branch = \"", str_concat(branch, "\"")))
    else:
        if str_len(path) > 0:
            dep_line = str_concat(dep_line, str_concat("path = \"", str_concat(path, "\"")))
            if str_len(version) > 0:
                dep_line = str_concat(dep_line, str_concat(", version = \"", str_concat(version, "\"")))

    dep_line = str_concat(dep_line, " }\n")
    mut new_toml := str_concat(raw_toml, dep_line)
    write_file("lpp.toml", new_toml)
    info(str_concat("Added dependency '", str_concat(dep_name, "' to lpp.toml")))

    install_deps()

def cmd_remove(package_name: Str) -> Void:
    if str_len(package_name) == 0:
        error("Usage: lpp remove <package_name>")
        return

    if path_exists("lpp.toml") == 0:
        error("lpp.toml not found.")
        return

    raw_toml := read_file("lpp.toml")
    mut target_pattern := str_concat(package_name, " =")
    if str_find(raw_toml, target_pattern) < 0:
        target_pattern = str_concat(package_name, "=")

    if str_find(raw_toml, target_pattern) < 0:
        info(str_concat("Dependency '", str_concat(package_name, "' not found in lpp.toml")))
        return

    # Filter out line matching package_name
    mut new_lines := ""
    mut pos := 0
    end_pos := str_len(raw_toml)
    while pos < end_pos:
        mut nl := str_find(str_substr(raw_toml, pos, end_pos - pos), "\n")
        if nl < 0:
            nl = end_pos - pos
        line := str_substr(raw_toml, pos, nl)
        pos = pos + nl + 1

        if str_find(line, target_pattern) < 0:
            new_lines = str_concat(new_lines, str_concat(line, "\n"))

    write_file("lpp.toml", new_lines)
    info(str_concat("Removed dependency '", str_concat(package_name, "' from lpp.toml")))

    pkg_dir := path_join(".lpp_packages", package_name)
    if path_exists(pkg_dir) == 1:
        dir_remove(pkg_dir)
        info(str_concat("Cleaned package directory for ", package_name))

    install_deps()

# artifacts.lpp — .lppsnapshot extraction and .lppdelta application
# Handles the actual byte manipulation of archive and patch formats.

import utils
import security

# These formats are not part of the current runtime ABI.  They must fail
# closed until a reviewed implementation is wired in; the old placeholders
# returned success/identity data and could install a corrupt or unverified
# release.
def archive_extract(archive_bytes: Str, dest_dir: Str) -> Int:
    print_str("[lpp-pm] archive extraction is not available in this runtime")
    return -1

def archive_extract_file(delta_bytes: Str, filename: Str) -> Str:
    return ""

def patch_apply(src_path: Str, patch_data: Str, dest_path: Str) -> Int:
    print_str("[lpp-pm] patch application is not available in this runtime")
    return -1

def vcdiff_apply(base_bytes: Str, delta_data: Str) -> Str:
    return ""

def zstd_decompress(bytes: Str) -> Str:
    return ""

def dir_remove_all(path: Str) -> Void:
    if path_exists(path) == 1:
        dir_remove(path)

def json_parse(s: Str) -> Int:
    # A non-zero fake handle was previously treated as a valid JSON document.
    # Return zero until the complete object/array adapter is available.
    return 0

def json_free(h: Int) -> Void:
    return

def json_get_str(h: Int, key: Str) -> Str:
    return ""

def json_get_obj(h: Int, key: Str) -> Int:
    return 0

def json_get_arr_obj(h: Int, idx: Int) -> Int:
    return 0

def rename(old_path: Str, new_path: Str) -> Int:
    return file_move(old_path, new_path)

# ── Raw CDN fetch with mirror race ────────────────────────────────────────────

# Fetch an artifact from GitHub Raw CDN, with jsDelivr as parallel mirror.
# The first response that passes SHA-256 verification wins.
def artifact_fetch(owner: Str, repo: Str, commit: Str, path: Str, expected_sha256: Str) -> Str:

    primary_url := str_concat( "https://raw.githubusercontent.com/", str_concat(owner, str_concat("/", str_concat(repo, str_concat("/", str_concat(commit, str_concat("/", path)))))))

    mirror_url := str_concat( "https://cdn.jsdelivr.net/gh/", str_concat(owner, str_concat("/", str_concat(repo, str_concat("@", str_concat(commit, str_concat("/", path)))))))

    # Try primary first (no timeout race in single-threaded L++; try both sequentially)
    primary := http_get(primary_url, 8000)
    if str_len(primary) > 0:
        r := verify_bytes_sha256(primary, expected_sha256)
        if r.ok:
            return primary

    # Mirror fallback
    mirror := http_get(mirror_url, 8000)
    if str_len(mirror) > 0:
        r := verify_bytes_sha256(mirror, expected_sha256)
        if r.ok:
            return mirror

    return ""

# ── .lppsnapshot extraction ───────────────────────────────────────────────────
# .lppsnapshot is a deterministic compressed archive.
# In this implementation we delegate to the native archive_extract builtin.
# The builtin enforces: no "..", no absolute paths, zeroed timestamps.

def snapshot_extract(archive_bytes: Str, dest_dir: Str, expected_tree_sha256: Str) -> Bool:
    if str_len(expected_tree_sha256) == 0:
        print_str("[lpp-pm] snapshot verification requires a tree hash")
        return false
    if path_exists(dest_dir) == 0:
        dir_create(dest_dir)

    # Extract using builtin (handles format detection, path validation)
    code := archive_extract(archive_bytes, dest_dir)
    if code != 0:
        print_str(str_concat("\033[1;31m[lpp-pm] ERROR:\033[0m snapshot extraction failed (code ", str_concat(int_to_str(code), ")")))
        return false

    # Verify tree hash after extraction
    actual_tree := compute_tree_hash(dest_dir)
    if actual_tree != expected_tree_sha256:
        print_str(str_concat("\033[1;31m[lpp-pm] ERROR:\033[0m tree hash mismatch\n  expected: ", str_concat(expected_tree_sha256, str_concat("\n  actual:   ", actual_tree))))
        return false

    return true

# ── .lppdelta application ─────────────────────────────────────────────────────
# .lppdelta is a container with manifest.json and patch payloads.
# Delegates text patching to patch_apply builtin, binary delta to vcdiff_apply.

struct DeltaManifest:
    from_tree_sha256: Str
    to_tree_sha256:   Str
    operations:       List[Str]   # operation descriptors: "type|file|target_sha|codec|payload_name"

def delta_parse_manifest(delta_bytes: Str) -> DeltaManifest:
    mut dm := DeltaManifest()
    dm.from_tree_sha256 = ""
    dm.to_tree_sha256   = ""
    dm.operations       = list_new()

    # Extract manifest.json from the delta archive
    man_json := archive_extract_file(delta_bytes, "manifest.json")
    if str_len(man_json) == 0:
        return dm

    h := json_parse(man_json)
    if h == 0:
        return dm

    dm.from_tree_sha256 = json_get_str(h, "from_tree_sha256")
    dm.to_tree_sha256   = json_get_str(h, "to_tree_sha256")

    # Parse operations array
    h_ops := json_get_obj(h, "operations")
    if h_ops != 0:
        mut i := 0
        while true:
            h_op := json_get_arr_obj(h_ops, i)
            if h_op == 0:
                break
            op_type    := json_get_str(h_op, "type")
            op_file    := json_get_str(h_op, "file")
            op_payload := json_get_str(h_op, "payload")
            op_sha     := json_get_str(h_op, "target_sha256")
            op_codec   := json_get_str(h_op, "codec")
            entry := str_concat(op_type, str_concat("|", str_concat(op_file, str_concat("|", str_concat(op_sha, str_concat("|", str_concat(op_codec, str_concat("|", op_payload))))))))
            list_push(dm.operations, entry)
            i = i + 1

    json_free(h)
    return dm

def delta_apply(delta_bytes: Str, source_dir: Str, dest_dir: Str, expected_to_sha256: Str) -> Bool:
    if str_len(expected_to_sha256) == 0:
        print_str("[lpp-pm] delta verification requires a target tree hash")
        return false
    dm := delta_parse_manifest(delta_bytes)
    if str_len(dm.from_tree_sha256) == 0:
        print_str("\033[1;31m[lpp-pm] ERROR:\033[0m failed to parse delta manifest")
        return false

    # Verify source tree matches from_tree_sha256
    actual_from := compute_tree_hash(source_dir)
    if actual_from != dm.from_tree_sha256:
        print_str(str_concat("\033[1;31m[lpp-pm] ERROR:\033[0m delta base tree mismatch\n  expected: ", str_concat(dm.from_tree_sha256, str_concat("\n  actual:   ", actual_from))))
        return false

    if path_exists(dest_dir) == 0:
        dir_create(dest_dir)

    # Apply each operation
    for op in dm.operations:
        sep1  := str_find(op, "|")
        op_type := str_substr(op, 0, sep1)
        rest1   := str_substr(op, sep1 + 1, str_len(op) - sep1 - 1)
        sep2    := str_find(rest1, "|")
        op_file := str_substr(rest1, 0, sep2)
        rest2   := str_substr(rest1, sep2 + 1, str_len(rest1) - sep2 - 1)
        sep3    := str_find(rest2, "|")
        op_sha  := str_substr(rest2, 0, sep3)
        rest3   := str_substr(rest2, sep3 + 1, str_len(rest2) - sep3 - 1)
        sep4    := str_find(rest3, "|")
        op_codec := str_substr(rest3, 0, sep4)
        op_payload := str_substr(rest3, sep4 + 1, str_len(rest3) - sep4 - 1)

        src_path  := path_join(source_dir, op_file)
        dest_path := path_join(dest_dir, op_file)

        if op_type == "text_patch":
            patch_data := archive_extract_file(delta_bytes, op_payload)
            code       := patch_apply(src_path, patch_data, dest_path)
            if code != 0:
                print_str(str_concat("\033[1;31m[lpp-pm] ERROR:\033[0m text patch failed for ", op_file))
                return false

        else:
            if op_type == "binary_delta":
                base_bytes  := read_file(src_path)
                delta_data  := archive_extract_file(delta_bytes, op_payload)
                if op_codec == "vcdiff":
                    result := vcdiff_apply(base_bytes, delta_data)
                    if str_len(result) == 0:
                        print_str(str_concat("\033[1;31m[lpp-pm] ERROR:\033[0m VCDIFF apply failed for ", op_file))
                        return false
                    write_file(dest_path, result)
                else:
                    print_str(str_concat("\033[1;33m[lpp-pm]\033[0m unknown binary codec: ", op_codec))
                    return false

            else:
                if op_type == "binary_full":
                    payload_bytes := archive_extract_file(delta_bytes, op_payload)
                    # May be zstd-compressed
                    mut content := payload_bytes
                    if str_ends_with(op_payload, ".zst"):
                        content = zstd_decompress(payload_bytes)
                    write_file(dest_path, content)
                else:
                    print_str(str_concat("\033[1;33m[lpp-pm]\033[0m unknown operation type: ", op_type))

        # Verify output file SHA-256
        if str_len(op_sha) > 0:
            r := verify_file_sha256(dest_path, op_sha)
            if !r.ok:
                print_str(str_concat("\033[1;31m[lpp-pm] ERROR:\033[0m ", r.message))
                return false

    # Verify final tree hash
    actual_to := compute_tree_hash(dest_dir)
    if actual_to != dm.to_tree_sha256:
        print_str(str_concat("\033[1;31m[lpp-pm] ERROR:\033[0m reconstructed tree hash mismatch\n  expected: ", str_concat(expected_to_sha256, str_concat("\n  actual:   ", actual_to))))
        return false

    return true

# ── Tree hash ─────────────────────────────────────────────────────────────────
# Compute a canonical SHA-256 of a directory tree:
# sorted file paths + file content hashes, concatenated deterministically.
def tree_sha256(dir_path: Str) -> Str:
    # Directory hashing needs a deterministic recursive walker and sorted
    # entries. Returning the empty-tree digest for every directory would make
    # verification meaningless, so fail closed until that implementation lands.
    return ""

def compute_tree_hash(dir_path: Str) -> Str:
    return tree_sha256(dir_path)

# ── Staging + atomic install ──────────────────────────────────────────────────
# Extract/reconstruct into a staging dir, verify, then atomically rename.

def artifact_install_atomic(archive_bytes: Str, target_dir: Str, tree_sha256_expected: Str, is_delta: Bool, source_dir: Str) -> Bool:
    staging := str_concat(target_dir, "__staging__")

    if path_exists(staging) == 1:
        dir_remove_all(staging)

    mut ok := false
    if is_delta:
        ok = delta_apply(archive_bytes, source_dir, staging, tree_sha256_expected)
    else:
        ok = snapshot_extract(archive_bytes, staging, tree_sha256_expected)

    if !ok:
        if path_exists(staging) == 1:
            dir_remove_all(staging)
        return false

    # Atomic rename: staging → target
    if path_exists(target_dir) == 1:
        dir_remove_all(target_dir)
    move_code := rename(staging, target_dir)
    if move_code != 0:
        print_str("[lpp-pm] atomic artifact rename failed")
        dir_remove_all(staging)
        return false
    return true

# main.lpp — Self-Hosted L++ Package Manager entry point
# All package manager commands are handled 100% natively in pure L++.

import utils
import new
import build
import install
import git
import registry
import add_remove

def main():
    header("Self-Hosted L++ Package Manager v4.5.0")

    mut cmd := env_get("LPP_PM_CMD")
    if str_len(cmd) == 0:
        cmd = "help"

    # ── new / init ─────────────────────────────────────────────────────
    if str_find(cmd, "new") >= 0 || str_find(cmd, "init") >= 0:
        mut name := env_get("LPP_PM_NAME")
        if str_len(name) == 0:
            name = "my_project"
        scaffold(name)
        return

    # ── build ──────────────────────────────────────────────────────────
    if str_find(cmd, "build") >= 0:
        code := compile_project()
        if code == 0:
            success("Build completed successfully.")
        else:
            error("Build failed.")
        return

    # ── run ────────────────────────────────────────────────────────────
    if str_find(cmd, "run") >= 0:
        code := compile_project()
        if code == 0:
            info("Running target binary...")
            mut bin_name := "output"
            if check("lpp.toml") == 1:
                raw := read("lpp.toml")
                bin_name = extract_name(raw)
            run_cmd := str_concat("./", str_concat(bin_name, ".exe"))
            command_exec(run_cmd)
        else:
            error("Build failed, cannot run.")
        return

    # ── install ────────────────────────────────────────────────────────
    if str_find(cmd, "install") >= 0:
        pkg := env_get("LPP_PM_ARG1")
        if str_len(pkg) > 0:
            if str_find(pkg, "opencode") >= 0 || str_find(pkg, "openclaude") >= 0:
                info("Installing lpp-opencode globally...")
                os_name := env_get("OS")
                if str_find(os_name, "Windows") >= 0:
                    command_exec("powershell -NoProfile -ExecutionPolicy Bypass -Command \"irm https://raw.githubusercontent.com/samarnever-droid/lpp-opencode/main/scripts/install.ps1 | iex\"")
                else:
                    command_exec("sh -c 'curl -fsSL https://raw.githubusercontent.com/samarnever-droid/lpp-opencode/main/scripts/install.sh | sh'")
                success("Installed lpp-opencode. Run: lpp-opencode /provider")
                return
        install_deps()
        return

    # ── add ────────────────────────────────────────────────────────────
    if str_find(cmd, "add") >= 0:
        pkg_name := env_get("LPP_PM_ARG1")
        git_arg := env_get("LPP_PM_GIT")
        branch_arg := env_get("LPP_PM_BRANCH")
        tag_arg := env_get("LPP_PM_TAG")
        path_arg := env_get("LPP_PM_PATH")
        ver_arg := env_get("LPP_PM_VERSION")
        cmd_add(pkg_name, git_arg, branch_arg, tag_arg, path_arg, ver_arg)
        return

    # ── remove ─────────────────────────────────────────────────────────
    if str_find(cmd, "remove") >= 0:
        pkg_name := env_get("LPP_PM_ARG1")
        cmd_remove(pkg_name)
        return

    # ── update ─────────────────────────────────────────────────────────
    if str_find(cmd, "update") >= 0:
        info("Updating lockfile and refreshing dependencies...")
        install_deps()
        return

    # ── search ─────────────────────────────────────────────────────────
    if str_find(cmd, "search") >= 0:
        query := env_get("LPP_PM_ARG1")
        search_registry(query)
        return

    # ── check ──────────────────────────────────────────────────────────
    if str_find(cmd, "check") >= 0:
        entry := "src/main.lpp"
        if check(entry) == 0:
            warn("no src/main.lpp found")
            return
        cc_cmd := str_concat("lpp check ", entry)
        code := command_exec(cc_cmd)
        if code == 0:
            success("check passed — project is semantically valid.")
        else:
            error("check failed — errors detected.")
        return

    # ── clean ──────────────────────────────────────────────────────────
    if str_find(cmd, "clean") >= 0:
        if check("LppData") == 1:
            cc := command_exec("rm -rf LppData")
        if check("target") == 1:
            cc := command_exec("rm -rf target")
        if check(".lpp_cache") == 1:
            cc := command_exec("rm -rf .lpp_cache")
        cc := command_exec("rm -f *.o *.obj *.exe output.c 2>/dev/null")
        success("cleaned build artifacts")
        return

    # ── test ───────────────────────────────────────────────────────────
    if str_find(cmd, "test") >= 0:
        info("running test suite...")
        if check("tests") == 1:
            code := command_exec("lpp test")
            if code == 0:
                success("all tests passed!")
            else:
                error("test suite failed.")
            return
        else:
            if check("test") == 1:
                code := command_exec("lpp test")
                if code == 0:
                    success("all tests passed!")
                else:
                    error("test suite failed.")
                return
            else:
                warn("no tests/ directory found")
        return

    # ── list ──────────────────────────────────────────────────────────
    if str_find(cmd, "list") >= 0:
        if check("lpp.toml") == 1:
            raw := read("lpp.toml")
            info("declared dependencies:")
            dep_start := str_find(raw, "[dependencies]")
            if dep_start >= 0:
                rest := str_substr(raw, dep_start, str_len(raw) - dep_start)
                print_str(rest)
        return

    # ── tree ───────────────────────────────────────────────────────────
    if str_find(cmd, "tree") >= 0:
        if check("lpp.lock") == 1:
            lock := read("lpp.lock")
            print_str(lock)
        else:
            warn("no lockfile — run install first")
        return

    # ── metadata ───────────────────────────────────────────────────────
    if str_find(cmd, "metadata") >= 0:
        if check("lpp.toml") == 1:
            raw := read("lpp.toml")
            print_str(raw)
        return

    # ── outdated ───────────────────────────────────────────────────────
    if str_find(cmd, "outdated") >= 0:
        if check("lpp.lock") == 1:
            lock := read("lpp.lock")
            print_str(lock)
        else:
            warn("no lockfile found")
        return

    # ── help ───────────────────────────────────────────────────────────
    header("L++ Package Manager v4.5.0 (Pure L++ Native)")
    print_str("\033[1;33mUsage:\033[0m")
    print_str("  \033[36mlpp\033[0m <file.lpp> [options]       Compile one file")
    print_str("  \033[36mlpp\033[0m <command> [args]           Package/app workflow")
    print_str("")
    print_str("\033[1;33mProject workflow:\033[0m")
    print_str("  \033[32mnew\033[0m <name>                     Create a new package")
    print_str("  \033[32minit\033[0m [name]                    Initialize lpp.toml here")
    print_str("  \033[32madd\033[0m <pkg>                      Add dependency to lpp.toml")
    print_str("  \033[32minstall\033[0m                        Install dependencies from lpp.toml")
    print_str("  \033[32mupdate\033[0m                         Refresh dependencies and lockfile")
    print_str("  \033[32mremove\033[0m <pkg>                   Remove dependency")
    print_str("  \033[32mlist\033[0m | \033[32mtree\033[0m | \033[32mmetadata\033[0m         Inspect package state")
    print_str("")
    print_str("\033[1;33mBuild/test workflow:\033[0m")
    print_str("  \033[32mcheck\033[0m | \033[32mbuild\033[0m | \033[32mrun\033[0m | \033[32mtest\033[0m     Validate, build, run, test")
    print_str("  \033[32mclean\033[0m                          Remove build artifacts")
    print_str("")
    print_str("\033[1;33mRegistry:\033[0m")
    print_str("  \033[32msearch\033[0m <query>                 Search package registry")
    print_str("")
    print_str("\033[1;33mConfiguration:\033[0m")
    print_str("  \033[32mconfig set backend\033[0m <cranelift|llvm>  Set default compiler backend")
    print_str("  \033[32mconfig set linker\033[0m <direct|host|auto> Set default linker")
    print_str("")

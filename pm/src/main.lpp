# main.lpp — Self-Hosted L++ Package Manager v5.0 (Pure L++)
# 4-phase pipeline: COLLECT -> RESOLVE (semver/diamond-safe) -> PLAN (GPS) -> FETCH
# Supports: workspace/monorepo, tagless/branched/tagged git, lockfile v2, delta GPS.

import utils
import toml
import semver
import manifest
import resolver
import gps
import workspace
import new
import build
import install
import git
import registry
import add_remove
import publisher
import workspace_graph

def main():
    header(str_concat("L++ Package Manager v", env_get("LPP_PM_VERSION")))

    mut cmd := env_get("LPP_PM_CMD")
    if str_len(cmd) == 0:
        cmd = "help"

    # ── new / init ─────────────────────────────────────────────────────
    mut is_new := 0
    if cmd == "new":
        is_new = 1
    if cmd == "init":
        is_new = 1
    if is_new == 1:
        mut name := env_get("LPP_PM_NAME")
        if str_len(name) == 0:
            name = "my_project"
        scaffold(name)
        return

    # ── build ──────────────────────────────────────────────────────────
    if cmd == "build":
        bcode := compile_project()
        if bcode == 0:
            success("Build completed successfully.")
        else:
            error("Build failed.")
            exit(1)
        return

    # ── run ────────────────────────────────────────────────────────────
    if cmd == "run":
        rcode := compile_project()
        if rcode == 0:
            info("Running target binary...")
            mut run_cmd := path_join("src", "main")
            if path_exists(run_cmd) == 0:
                run_cmd = str_concat(run_cmd, ".exe")
            if path_exists(run_cmd) == 0:
                error(str_concat("built target not found: ", run_cmd))
                exit(1)
            run_status := command_exec(run_cmd)
            if run_status != 0:
                exit(run_status)
        else:
            error("Build failed, cannot run.")
            exit(1)
        return

    # ── install ────────────────────────────────────────────────────────────
    if cmd == "install":
        mut online_flag := env_get("LPP_PM_ONLINE")
        mut offline_flag := env_get("LPP_PM_OFFLINE")
        mut icode := 0
        if str_len(online_flag) > 0:
            icode = install_deps_online()
        else:
            if str_len(offline_flag) > 0:
                icode = install_deps_opts(false, 8)
            else:
                icode = install_deps()
        if icode != 0:
            exit(icode)
        return

    # ── add ────────────────────────────────────────────────────────────
    if cmd == "add":
        pkg_name := env_get("LPP_PM_ARG1")
        git_arg := env_get("LPP_PM_GIT")
        branch_arg := env_get("LPP_PM_BRANCH")
        tag_arg := env_get("LPP_PM_TAG")
        path_arg := env_get("LPP_PM_PATH")
        ver_arg := env_get("LPP_PM_VERSION")
        cmd_add(pkg_name, git_arg, branch_arg, tag_arg, path_arg, ver_arg)
        return

    # ── remove ─────────────────────────────────────────────────────────
    if cmd == "remove":
        pkg_name := env_get("LPP_PM_ARG1")
        cmd_remove(pkg_name)
        return

    # ── publish ────────────────────────────────────────────────────────────
    if cmd == "publish":
        mut opts := publish_opts_default()
        arg1 := env_get("LPP_PM_ARG1")
        arg2 := env_get("LPP_PM_ARG2")
        mut want_dry := 0
        if arg1 == "--dry-run":
            want_dry = 1
        if arg2 == "--dry-run":
            want_dry = 1
        if want_dry == 1:
            opts.dry_run = true
        mut want_cp := 0
        if arg1 == "--force-checkpoint":
            want_cp = 1
        if arg2 == "--force-checkpoint":
            want_cp = 1
        if want_cp == 1:
            opts.force_checkpoint = true
        mut is_bump := 0
        if arg1 == "patch":
            is_bump = 1
        if arg1 == "minor":
            is_bump = 1
        if arg1 == "major":
            is_bump = 1
        if is_bump == 1:
            opts.version_bump = arg1
        pcode := cmd_publish(opts)
        if pcode != 0:
            error("Publish failed.")
        return

    # ── update ─────────────────────────────────────────────────────────────
    if cmd == "update":
        info("Fetching latest commits and updating lockfile...")
        ucode := install_deps_online()
        if ucode != 0:
            exit(ucode)
        return

    # ── workspace ──────────────────────────────────────────────────────────
    if cmd == "workspace":
        sub := env_get("LPP_PM_ARG1")
        ws  := workspace_discover(path_cwd())
        if str_len(ws.root) == 0:
            error("not inside a workspace — no [workspace] section found")
            return
        if sub == "graph":
            workspace_graph(ws)
            return
        mut want_members := 0
        if sub == "members":
            want_members = 1
        if str_len(sub) == 0:
            want_members = 1
        if want_members == 1:
            workspace_list_members(ws)
            return
        if sub == "build":
            member := env_get("LPP_PM_ARG2")
            if str_len(member) > 0:
                cmd_path := path_join(workspace_find_member(ws, member), "src/main.lpp")
                if check(cmd_path) == 1:
                    command_exec(str_concat("lpp ", cmd_path))
                else:
                    error(str_concat("member not found: ", member))
            else:
                workspace_build_all(ws)
            return
        if sub == "test":
            workspace_test_all(ws)
            return
        warn(str_concat("unknown workspace subcommand: ", sub))
        return

    # ── check ───────────────────────────────────────────────────────────────
    if cmd == "check":
        entry := "src/main.lpp"
        if check(entry) == 0:
            warn("no src/main.lpp found")
            return
        cc_cmd := str_concat("lpp check ", entry)
        ccode := command_exec(cc_cmd)
        if ccode == 0:
            success("check passed — project is semantically valid.")
        else:
            error("check failed — errors detected.")
        return

    # ── clean ──────────────────────────────────────────────────────────────
    if cmd == "clean":
        if check(".lpp_cache") == 1:
            command_exec("rm -rf .lpp_cache")
        command_exec("rm -f *.o *.obj *.exe output.c 2>/dev/null")
        success("cleaned build artifacts")
        return

    # ── test ───────────────────────────────────────────────────────────────
    if cmd == "test":
        if check("tests") == 1:
            tcode1 := command_exec("lpp test")
            if tcode1 == 0:
                success("all tests passed!")
            else:
                error("test suite failed.")
            return
        else:
            if check("test") == 1:
                tcode2 := command_exec("lpp test")
                if tcode2 == 0:
                    success("all tests passed!")
                else:
                    error("test suite failed.")
                return
            else:
                warn("no tests/ directory found")
        return

    # ── list ──────────────────────────────────────────────────────────
    if cmd == "list":
        m := manifest_parse("lpp.toml")
        print_str(str_concat("\033[1;36m", str_concat(m.name, str_concat(" @ ", str_concat(m.version, "\033[0m")))))
        if list_len(m.deps) == 0:
            print_str("  (no dependencies)")
        else:
            for dep in m.deps:
                print_str(str_concat("  ", str_concat(dep.name, str_concat(" (", str_concat(dep.kind, ")")))))
        return

    # ── tree ──────────────────────────────────────────────────────────
    if cmd == "tree":
        if check("lpp.lock") == 1:
            lock := read("lpp.lock")
            print_str(lock)
        else:
            warn("no lockfile — run install first")
        return

    # ── metadata ───────────────────────────────────────────────────────────
    if cmd == "metadata":
        if check("lpp.lock") == 1:
            lock := read("lpp.lock")
            print_str(lock)
        else:
            warn("no lockfile found")
        return

    # ── search ─────────────────────────────────────────────────────────────
    if cmd == "search":
        query := env_get("LPP_PM_ARG1")
        if str_len(query) == 0:
            warn("Usage: lpp search <query>")
            return
        results := registry_search(query)
        if str_len(results) == 0:
            info("No packages found.")
        else:
            print_str(results)
        return

    # ── version ─────────────────────────────────────────────────────────────
    if cmd == "version":
        m := manifest_parse("lpp.toml")
        if str_len(m.name) > 0:
            print_str(str_concat(m.name, str_concat(" @ ", m.version)))
        else:
            warn("no lpp.toml found")
        return

    # ── config ─────────────────────────────────────────────────────────────
    if cmd == "config":
        sub := env_get("LPP_PM_ARG1")
        key := env_get("LPP_PM_ARG2")
        val := env_get("LPP_PM_ARG3")
        if sub == "set":
            info(str_concat("setting ", str_concat(key, str_concat(" = ", val))))
        return

    # ── help ───────────────────────────────────────────────────────────────
    header(str_concat("L++ Package Manager v", env_get("LPP_PM_VERSION")))
    print_str("\033[1;33mUsage:\033[0m")
    print_str("  \033[36mlpp\033[0m <file.lpp> [options]       Compile one file")
    print_str("  \033[36mlpp\033[0m <command> [args]           Package/app workflow")
    print_str("")
    print_str("\033[1;33mProject workflow:\033[0m")
    print_str("  \033[32mnew\033[0m <name>                     Create a new package")
    print_str("  \033[32minit\033[0m [name]                    Initialize lpp.toml here")
    print_str("  \033[32madd\033[0m <pkg>                      Add dependency to lpp.toml")
    print_str("  \033[32minstall\033[0m                        Install dependencies from lpp.toml")
    print_str("  \033[32mupdate\033[0m                         Refresh dependencies and lockfile")
    print_str("  \033[32mremove\033[0m <pkg>                   Remove dependency")
    print_str("  \033[32mlist\033[0m | \033[32mtree\033[0m | \033[32mmetadata\033[0m         Inspect package state")
    print_str("")
    print_str("\033[1;33mBuild/test workflow:\033[0m")
    print_str("  \033[32mcheck\033[0m | \033[32mbuild\033[0m | \033[32mrun\033[0m | \033[32mtest\033[0m     Validate, build, run, test")
    print_str("  \033[32mclean\033[0m                          Remove build artifacts")
    print_str("")
    print_str("\033[1;33mRegistry:\033[0m")
    print_str("  \033[32msearch\033[0m <query>                 Search package registry")
    print_str("  \033[32mpublish\033[0m [patch|minor|major]    Publish package to registry")
    print_str("")
    print_str("\033[1;33mWorkspace:\033[0m")
    print_str("  \033[32mworkspace members\033[0m              List workspace packages")
    print_str("  \033[32mworkspace graph\033[0m                Show dependency graph")
    print_str("  \033[32mworkspace build\033[0m [member]       Build workspace or specific member")
    print_str("")

# main.lpp — Self-Hosted L++ Package Manager entry point
# All package manager commands are handled 100% natively in pure L++.

import utils
import new
import build
import install
import git
import registry
import add_remove

def main():
    print_str("=== Self-Hosted L++ Package Manager v3.4.0 ===")

    mut cmd := env_get("LPP_PM_CMD")
    if str_len(cmd) == 0:
        cmd = "help"

    # ── new / init ─────────────────────────────────────────────────────
    if str_find(cmd, "new") >= 0 || str_find(cmd, "init") >= 0:
        mut name := env_get("LPP_PM_NAME")
        if str_len(name) == 0:
            name = "my_project"
        scaffold(name)
        return

    # ── build ──────────────────────────────────────────────────────────
    if str_find(cmd, "build") >= 0:
        code := compile_project()
        if code == 0:
            info("Build completed successfully.")
        return

    # ── run ────────────────────────────────────────────────────────────
    if str_find(cmd, "run") >= 0:
        code := compile_project()
        if code == 0:
            info("Running target binary...")
            mut bin_name := "output"
            if check("lpp.toml") == 1:
                raw := read("lpp.toml")
                bin_name = extract_name(raw)
            run_cmd := str_concat("./", str_concat(bin_name, ".exe"))
            command_exec(run_cmd)
        return

    # ── install ────────────────────────────────────────────────────────
    if str_find(cmd, "install") >= 0:
        install_deps()
        return

    # ── add ────────────────────────────────────────────────────────────
    if str_find(cmd, "add") >= 0:
        pkg_name := env_get("LPP_PM_ARG1")
        git_arg := env_get("LPP_PM_GIT")
        branch_arg := env_get("LPP_PM_BRANCH")
        tag_arg := env_get("LPP_PM_TAG")
        path_arg := env_get("LPP_PM_PATH")
        ver_arg := env_get("LPP_PM_VERSION")
        cmd_add(pkg_name, git_arg, branch_arg, tag_arg, path_arg, ver_arg)
        return

    # ── remove ─────────────────────────────────────────────────────────
    if str_find(cmd, "remove") >= 0:
        pkg_name := env_get("LPP_PM_ARG1")
        cmd_remove(pkg_name)
        return

    # ── update ─────────────────────────────────────────────────────────
    if str_find(cmd, "update") >= 0:
        info("Updating lockfile and refreshing dependencies...")
        install_deps()
        return

    # ── search ─────────────────────────────────────────────────────────
    if str_find(cmd, "search") >= 0:
        query := env_get("LPP_PM_ARG1")
        search_registry(query)
        return

    # ── check ──────────────────────────────────────────────────────────
    if str_find(cmd, "check") >= 0:
        entry := "src/main.lpp"
        if check(entry) == 0:
            info("no src/main.lpp found")
            return
        cc_cmd := str_concat("lpp check ", entry)
        code := command_exec(cc_cmd)
        if code == 0:
            info("check passed — project is semantically valid.")
        return

    # ── clean ──────────────────────────────────────────────────────────
    if str_find(cmd, "clean") >= 0:
        if check("LppData") == 1:
            cc := command_exec("rm -rf LppData")
        if check("target") == 1:
            cc := command_exec("rm -rf target")
        if check(".lpp_cache") == 1:
            cc := command_exec("rm -rf .lpp_cache")
        cc := command_exec("rm -f *.o *.obj *.exe output.c 2>/dev/null")
        info("cleaned build artifacts")
        return

    # ── test ───────────────────────────────────────────────────────────
    if str_find(cmd, "test") >= 0:
        info("running test suite...")
        if check("tests") == 1:
            code := command_exec("lpp test")
            if code == 0:
                info("all tests passed!")
            return
        else:
            if check("test") == 1:
                code := command_exec("lpp test")
                if code == 0:
                    info("all tests passed!")
                return
            else:
                info("no tests/ directory found")
        return

    # ── list ──────────────────────────────────────────────────────────
    if str_find(cmd, "list") >= 0:
        if check("lpp.toml") == 1:
            raw := read("lpp.toml")
            info("declared dependencies:")
            dep_start := str_find(raw, "[dependencies]")
            if dep_start >= 0:
                rest := str_substr(raw, dep_start, str_len(raw) - dep_start)
                print_str(rest)
        return

    # ── tree ───────────────────────────────────────────────────────────
    if str_find(cmd, "tree") >= 0:
        if check("lpp.lock") == 1:
            lock := read("lpp.lock")
            print_str(lock)
        else:
            info("no lockfile — run install first")
        return

    # ── metadata ───────────────────────────────────────────────────────
    if str_find(cmd, "metadata") >= 0:
        if check("lpp.toml") == 1:
            raw := read("lpp.toml")
            print_str(raw)
        return

    # ── outdated ───────────────────────────────────────────────────────
    if str_find(cmd, "outdated") >= 0:
        if check("lpp.lock") == 1:
            lock := read("lpp.lock")
            print_str(lock)
        else:
            info("no lockfile found")
        return

    # ── help ───────────────────────────────────────────────────────────
    print_str("=== L++ Package Manager v3.4.0 (Pure L++ Native) ===")
    print_str("  new <name>            Create a new L++ package")
    print_str("  init <name>           Initialize package in current directory")
    print_str("  install               Resolve and install all dependencies")
    print_str("  add <name>            Add dependency from registry or git")
    print_str("  remove <name>         Remove dependency from lpp.toml")
    print_str("  update                Refresh dependencies and lockfile")
    print_str("  search <query>        Search package registry")
    print_str("  list                  List declared dependencies")
    print_str("  tree                  Print dependency lockfile")
    print_str("  metadata              Print package manifest")
    print_str("  outdated              Show unpinned dependencies")
    print_str("  clean                 Remove build artifacts")
    print_str("  check                 Type-check project")
    print_str("  build                 Build native project executable")
    print_str("  run                   Compile and execute project")
    print_str("  test                  Run tests in tests/ directory")
    print_str("  help                  Show help")

# install.lpp — resolve and install dependencies in pure L++

import utils
import git
import registry

def install_deps() -> Int:
    manifest := "lpp.toml"
    if check(manifest) == 0:
        error("no lpp.toml found in current directory.")
        return 1

    raw := read(manifest)
    info("Resolving dependencies...")

    pkg_dir := ".lpp_packages"
    if check(pkg_dir) == 0:
        dir_create(pkg_dir)

    mut lock_content := "# Generated by L++ Package Manager. Do not edit.\n\n"

    # Find [dependencies] section
    dep_start := str_find(raw, "[dependencies]")
    if dep_start < 0:
        info("No dependencies declared in lpp.toml")
        write("lpp.lock", lock_content)
        return 0

    section := str_substr(raw, dep_start, str_len(raw) - dep_start)
    process_deps_and_lock(section, pkg_dir, lock_content)
    return 0

def process_deps_and_lock(section: Str, pkg_dir: Str, lock_content: Str) -> Void:
    mut pos := 0
    end_pos := str_len(section)
    mut final_lock := lock_content

    while pos < end_pos:
        mut nl := str_find(str_substr(section, pos, end_pos - pos), "\n")
        if nl < 0:
            nl = end_pos - pos
        line := str_substr(section, pos, nl)
        pos = pos + nl + 1

        if str_find(line, "=") >= 0:
            eq_idx := str_find(line, "=")
            if eq_idx > 0:
                dep_name := str_trim(str_substr(line, 0, eq_idx))
                if str_find(dep_name, "[") < 0:
                    val_str := str_substr(line, eq_idx + 1, str_len(line) - eq_idx - 1)
                    install_single_dep(dep_name, val_str, pkg_dir)

                    dest_path := joined(pkg_dir, dep_name)
                    rev := git_rev_parse(dest_path)
                    mut entry_str := str_concat("[[package]]\nname = \"", str_concat(dep_name, "\"\n"))
                    entry_str = str_concat(entry_str, str_concat("source = \"", str_concat(dest_path, "\"\n")))
                    entry_str = str_concat(entry_str, str_concat("resolved = \"", str_concat(rev, "\"\n\n")))
                    final_lock = str_concat(final_lock, entry_str)

    write("lpp.lock", final_lock)
    info("Dependencies resolved successfully. Generated lpp.lock.")

def install_single_dep(name: Str, val_str: Str, pkg_dir: Str) -> Void:
    info(str_concat("Installing ", name))
    dest_path := joined(pkg_dir, name)

    mut git_url := extract_field(val_str, "git")
    mut branch := extract_field(val_str, "branch")
    mut tag := extract_field(val_str, "tag")
    mut path := extract_field(val_str, "path")

    if str_len(git_url) == 0:
        if str_len(path) == 0:
            resolved := resolve_registry_pkg(name)
            if str_len(resolved) > 0:
                info(str_concat("Resolved ", str_concat(name, " from registry")))
                # Format: git|url|branch|tag
                g_idx := str_find(resolved, "|")
                if g_idx >= 0:
                    rest := str_substr(resolved, g_idx + 1, str_len(resolved) - g_idx - 1)
                    b_idx := str_find(rest, "|")
                    if b_idx >= 0:
                        git_url = str_substr(rest, 0, b_idx)
            else:
                error(str_concat("Dependency ", str_concat(name, " has no git/path source and is not in registry.")))
                return

    if str_len(git_url) > 0:
        if check(dest_path) == 1:
            info(str_concat("Dependency ", str_concat(name, " already installed.")))
            git_pull(dest_path)
        else:
            git_clone(git_url, dest_path, branch, tag)
    else:
        if str_len(path) > 0:
            info(str_concat("Linked local path: ", path))

    # Transitive dependency check inside installed package's lpp.toml
    sub_manifest := joined(dest_path, "lpp.toml")
    if check(sub_manifest) == 1:
        sub_raw := read(sub_manifest)
        sub_dep_start := str_find(sub_raw, "[dependencies]")
        if sub_dep_start >= 0:
            sub_section := str_substr(sub_raw, sub_dep_start, str_len(sub_raw) - sub_dep_start)
            info(str_concat("Processing transitive dependencies for ", name))
            process_deps_and_lock(sub_section, pkg_dir, "")

def extract_field(val_str: Str, key: Str) -> Str:
    mut pattern := str_concat(key, " = \"")
    mut idx := str_find(val_str, pattern)
    if idx < 0:
        pattern = str_concat(key, "=\"")
        idx = str_find(val_str, pattern)

    if idx < 0:
        return ""

    start := idx + str_len(pattern)
    rest := str_substr(val_str, start, str_len(val_str) - start)
    end := str_find(rest, "\"")
    if end < 0:
        return ""
    return str_substr(rest, 0, end)

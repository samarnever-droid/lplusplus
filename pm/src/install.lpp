# install.lpp v5.0 — Resolve and install all dependencies
# Replaces the old install.lpp with the 4-phase pipeline:
#   COLLECT → RESOLVE → PLAN (GPS) → FETCH (parallel by topo level)

import utils
import manifest
import resolver
import gps
import registry
import workspace
import git

# ── main entry ────────────────────────────────────────────────────────────────

def install_deps() -> Int:
    return install_deps_opts(false, 8)

def install_deps_online() -> Int:
    return install_deps_opts(true, 8)

def install_deps_opts(online: Bool, jobs: Int) -> Int:
    manifest_path := "lpp.toml"
    if path_exists(manifest_path) == 0:
        print_str("\033[1;31m[lpp-pm] ERROR:\033[0m no lpp.toml found in current directory.")
        return 1

    # Discover workspace context (may be empty if not in a workspace)
    ws := workspace_discover(path_cwd())

    # ── PHASE 1: COLLECT ─────────────────────────────────────────────────────
    st := resolve_state_new()

    if str_len(ws.root) > 0:
        # Workspace install: collect from all members
        info(str_concat("workspace install: ", ws.root))
        collect_workspace(st, ws)
    else:
        # Single-project install
        m := manifest_parse(manifest_path)
        if str_len(m.name) > 0:
            info(str_concat("installing: ", str_concat(m.name, str_concat(" @ ", m.version))))
        resolve_collect(st, m, m.name)


    # ── PHASE 2: SOLVE ───────────────────────────────────────────────────────
    
    # Build version map for collected semver packages using registry shards
    version_map := map_new()
    sem_keys := st_sem_keys(st)
    for pkg_name in sem_keys:
        e := registry_lookup(pkg_name, online)
        if str_len(e.name) > 0:
            map_put_str(version_map, pkg_name, int_to_str(e.versions))

    resolve_solve(st, version_map)

    if resolve_has_errors(st):
        print_str("\033[1;31m[lpp-pm] ERROR:\033[0m dependency resolution failed:")
        resolve_print_errors(st)
        return 1


    # ── PHASE 3: PLAN (GPS) ──────────────────────────────────────────────────
    pkg_dir := ".lpp_packages"
    if path_exists(pkg_dir) == 0:
        dir_create(pkg_dir)

    lock_path := "lpp.lock"
    routes := plan_all(st, lock_path)

    # ── PHASE 4: FETCH ───────────────────────────────────────────────────────
    mut cache_hits := 0
    mut downloaded := 0
    mut errors     := 0
    mut lock_str   := ""

    for r in routes:
        mut p := LockedPkg()
        p.name           = r.pkg_name
        p.kind           = r.dep.kind
        p.version        = r.dep.version
        p.source         = r.dep.url
        p.branch         = r.dep.branch
        p.tag            = r.dep.tag
        p.commit         = ""
        p.tree_sha256    = ""
        p.release_sha256 = ""

        mut is_cached := false
        if str_find(r.kind, "cached") >= 0:
            is_cached = true
        if str_find(r.kind, "git_fast") >= 0:
            is_cached = true
            
        if is_cached:
            cache_hits = cache_hits + 1
            info(str_concat("  ", str_concat(r.pkg_name, " (cached)")))
            p.commit = lockfile_read_field(lock_path, r.pkg_name, "commit")
            lock_str = str_concat(lock_str, lockfile_encode_pkg(p))
            continue

        is_path_route := str_find(r.kind, "path") >= 0
        if is_path_route:
            info(str_concat("  ", str_concat(r.pkg_name, " (path)")))
            dest_path_dep := path_join(pkg_dir, r.pkg_name)
            if path_exists(dest_path_dep) == 1:
                dir_remove_all(dest_path_dep)
            cmd_copy := str_concat("powershell -Command Copy-Item -Path ", str_concat(r.dep.url, str_concat(" -Destination ", str_concat(dest_path_dep, " -Recurse -Force"))))
            command_exec(cmd_copy)
            lock_str = str_concat(lock_str, lockfile_encode_pkg(p))
            cache_hits = cache_hits + 1
            continue
            
        dest := path_join(pkg_dir, r.pkg_name)

        if r.dep.kind == "tagless" || r.dep.kind == "branched" || r.dep.kind == "tagged":
            code := fetch_git_pkg(r.pkg_name, r.dep.url, r.dep.branch, r.dep.tag, dest)
            if code == 0:
                downloaded = downloaded + 1
                p.source = str_concat("git+", r.dep.url)
                p.commit = git_rev_parse(dest)
                lock_str = str_concat(lock_str, lockfile_encode_pkg(p))
            else:
                errors = errors + 1
            continue

        # Registry package (delta or checkpoint route)
        # For MVP: fall back to git clone of the registry artifact commit
        # Full delta apply will be added when lppdelta format is implemented
        e := registry_lookup(r.pkg_name, false)
        if str_len(e.git) > 0:
            code := fetch_git_pkg(r.pkg_name, e.git, "", "", dest)
            if code == 0:
                downloaded = downloaded + 1
                p.source = str_concat("git+", e.git)
                p.commit = git_rev_parse(dest)
                lock_str = str_concat(lock_str, lockfile_encode_pkg(p))
            else:
                errors = errors + 1
        else:
            error(str_concat("could not fetch registry package: ", r.pkg_name))
            errors = errors + 1

    # Write lockfile
    lockfile_write(lock_path, lock_str)

    # ── SUMMARY ──────────────────────────────────────────────────────────────
    if errors > 0:
        print_str(str_concat("\033[1;31m[lpp-pm] ERROR:\033[0m ", str_concat(int_to_str(errors), " package(s) failed to install")))
        return 1

    success(str_concat(int_to_str(downloaded), str_concat(" downloaded, ", str_concat(int_to_str(cache_hits), " from cache"))))
    return 0

# ── collect workspace ─────────────────────────────────────────────────────────

def collect_workspace(st: ResolveState, ws: Workspace) -> Void:
    for member_path in ws.abs_paths:
        m_path := path_join(member_path, "lpp.toml")
        if path_exists(m_path) == 0:
            continue

        m := manifest_parse(m_path)
        m_ver := workspace_apply_version(m, ws)
        resolve_collect(st, m_ver, m_ver.name)

# ── plan_all ─────────────────────────────────────────────────────────────────

struct PlanResult:
    pkg_name: Str
    kind:     Str      # route kind: cached, git_fast, path, git_clone, delta_chain, checkpoint
    route:    Route
    dep:      ResolvedEntry

def plan_all(st: ResolveState, lock_path: Str) -> List[PlanResult]:
    result := list_new()

    sem_keys := st_sem_keys(st)
    for name in sem_keys:
        e := resolve_get(st, name)
        if str_len(e.name) == 0:
            continue

        mut pr := PlanResult()
        pr.pkg_name = name
        pr.dep      = e

        catalog    := registry_build_catalog_simple(registry_lookup(name, false))
        cached_ver := lockfile_read_field(lock_path, name, "version")
        
        pr.route = gps_plan(name, e.version, catalog, cached_ver)
        pr.kind  = pr.route.kind

        list_push(result, pr)
        gps_print_route(pr.route)

    git_keys := st_git_keys(st)
    for name in git_keys:
        e := resolve_get(st, name)
        if str_len(e.name) == 0:
            continue

        mut pr := PlanResult()
        pr.pkg_name = name
        pr.dep      = e

        mut route := route_new(name, "path")
        if e.kind == "tagless" || e.kind == "branched" || e.kind == "tagged":
            locked_commit := lockfile_read_field(lock_path, name, "commit")
            if str_len(locked_commit) > 0:
                route.kind = "git_fast"
            else:
                route.kind = "git_clone"

        pr.route = route
        pr.kind  = route.kind

        list_push(result, pr)
        gps_print_route(route)

    if list_len(result) == 0:
        return list_new()
    return result

# ── fetch git ─────────────────────────────────────────────────────────────────

def fetch_git_pkg(name: Str, url: Str, branch: Str, tag: Str, dest: Str) -> Int:
    if path_exists(dest) == 1:
        info(str_concat("  ", str_concat(name, " pulling...")))
        return git_pull(dest)
    info(str_concat("  ", str_concat(name, " cloning...")))
    return git_clone(url, dest, branch, tag)

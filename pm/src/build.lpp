# build.lpp — compile and link an L++ project

import utils

def compile_project() -> Int:
    entry := "src/main.lpp"
    if check(entry) == 0:
        print_str("[lpp-pm] no src/main.lpp found")
        return 1

    # Load manifest for project name
    mut bin_name := "output"
    manifest := "lpp.toml"
    if check(manifest) == 1:
        raw := read(manifest)
        bin_name = extract_name(raw)

    # Compile and link binary directly via lpp compiler
    mut compiler := env_get("LPP_BIN")
    if str_len(compiler) == 0:
        compiler = "lpp"

    cc_cmd := str_concat(compiler, str_concat(" ", str_concat(entry, " --linker auto")))
    code := command_exec(cc_cmd)
    if code != 0:
        error("compilation failed")
        return code
    return 0

def extract_name(toml_raw: Str) -> Str:
    line_start := str_find(toml_raw, "name = \"")
    if line_start < 0:
        return "output"
    start := line_start + 8
    rest := str_substr(toml_raw, start, 128)
    end := str_find(rest, "\"")
    if end < 0:
        return "output"
    return str_substr(rest, 0, end)

def detect_cc() -> Str:
    mut cc_out := command_output("cc --version 2>&1 || echo FAIL")
    if str_find(cc_out, "cc") >= 0:
        if str_find(cc_out, "FAIL") < 0:
            return "cc"
    cc_out = command_output("gcc --version 2>&1 || echo FAIL")
    if str_find(cc_out, "FAIL") < 0:
        return "gcc"
    cc_out = command_output("clang --version 2>&1 || echo FAIL")
    if str_find(cc_out, "FAIL") < 0:
        return "clang"
    cc_out = command_output("cl.exe /? 2>&1 || echo FAIL")
    if str_find(cc_out, "FAIL") < 0:
        return "cl.exe"
    return "cc"

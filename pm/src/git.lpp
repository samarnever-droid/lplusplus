# git.lpp — Minimal Git engine and HTTP fallback in pure L++
# Provides git_clone, git_pull, git_rev_parse, and git_has_system.

import utils

def git_has_system() -> Int:
    mut out := command_output("git --version 2>&1 || echo FAIL")
    if str_find(out, "git version") >= 0:
        return 1
    if str_find(out, "FAIL") < 0:
        return 1
    return 0

def git_clone(url: Str, dest_path: Str, branch: Str, tag: Str) -> Int:
    if git_has_system() == 1:
        info(str_concat("Cloning via system git from ", url))
        mut clone_cmd := str_concat(str_concat("git -c credential.helper= clone ", url), str_concat(" ", dest_path))
        mut code := command_exec(clone_cmd)
        if code != 0:
            error(str_concat("git clone failed for ", url))
            return 1

        if str_len(tag) > 0:
            info(str_concat("Checking out tag ", tag))
            mut tag_cmd := str_concat(str_concat("git -C ", dest_path), str_concat(" checkout ", tag))
            command_exec(tag_cmd)
        else:
            if str_len(branch) > 0:
                info(str_concat("Checking out branch ", branch))
                mut b_cmd := str_concat(str_concat("git -C ", dest_path), str_concat(" checkout ", branch))
                command_exec(b_cmd)
        return 0
    else:
        info(str_concat("System git not detected. Using HTTP archive fallback for ", url))
        # Convert GitHub git URL to ZIP archive download:
        # e.g., https://github.com/owner/repo.git -> https://codeload.github.com/owner/repo/zip/refs/heads/main
        mut clean_url := url
        if str_find(clean_url, ".git") > 0:
            clean_url = str_substr(clean_url, 0, str_find(clean_url, ".git"))

        mut target_ref := "main"
        if str_len(tag) > 0:
            target_ref = tag
        else:
            if str_len(branch) > 0:
                target_ref = branch

        # Try downloading via curl or powershell to zip fallback
        mut archive_url := str_replace(clean_url, "github.com", "codeload.github.com")
        archive_url = str_concat(archive_url, str_concat("/zip/refs/heads/", target_ref))

        dir_create(dest_path)
        mut zip_dest := str_concat(dest_path, ".zip")
        mut dl_cmd := str_concat(str_concat("curl -fsSL -o ", zip_dest), str_concat(" ", archive_url))
        mut dl_code := command_exec(dl_cmd)

        if dl_code != 0:
            # Fallback download attempt for tags or master
            archive_url = str_replace(clean_url, "github.com", "codeload.github.com")
            archive_url = str_concat(archive_url, "/zip/refs/heads/master")
            dl_cmd = str_concat(str_concat("curl -fsSL -o ", zip_dest), str_concat(" ", archive_url))
            dl_code = command_exec(dl_cmd)

        if dl_code == 0:
            info(str_concat("Downloaded archive, extracting into ", dest_path))
            mut unpack_cmd := str_concat(str_concat("tar -xf ", zip_dest), str_concat(" -C ", dest_path))
            command_exec(unpack_cmd)
            delete_file(zip_dest)
            return 0
        else:
            error(str_concat("Failed to download dependency archive from ", archive_url))
            return 1

def git_pull(dest_path: Str) -> Int:
    if git_has_system() == 1:
        mut pull_cmd := str_concat("git -C ", str_concat(dest_path, " pull"))
        return command_exec(pull_cmd)
    info(str_concat("Skipping git pull (standalone mode): ", dest_path))
    return 0

def git_rev_parse(dest_path: Str) -> Str:
    if git_has_system() == 1:
        mut rev_cmd := str_concat("git -C ", str_concat(dest_path, " rev-parse HEAD 2>&1"))
        mut out := command_output(rev_cmd)
        mut trimmed := str_trim(out)
        if str_len(trimmed) > 0:
            if str_find(trimmed, "fatal") < 0:
                return trimmed
    return "HEAD"

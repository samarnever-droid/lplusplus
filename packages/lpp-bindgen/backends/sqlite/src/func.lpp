# func.lpp — SQLite's built-in scalar functions.
#
# Every function receives already-evaluated argument values and returns a new
# value handle. Aggregates (count/sum/avg/min/max/group_concat/total) are
# recognised here by name but computed by the executor.

import mem
import strbuf
import value
import ieee754
import ast
import eval

def is_aggregate(name: Str) -> Int:
    if strbuf.eq_ci(name, "count") == 1:
        return 1
    if strbuf.eq_ci(name, "sum") == 1:
        return 1
    if strbuf.eq_ci(name, "total") == 1:
        return 1
    if strbuf.eq_ci(name, "avg") == 1:
        return 1
    if strbuf.eq_ci(name, "min") == 1:
        return 2
    if strbuf.eq_ci(name, "max") == 1:
        return 2
    if strbuf.eq_ci(name, "group_concat") == 1:
        return 1
    return 0

# min/max are aggregates only with exactly one argument.
def is_agg_call(ar: Int, n: Int) -> Int:
    name := ast.text_of(ar, n)
    k := is_aggregate(name)
    if k == 0:
        return 0
    if k == 2:
        cnt := ast.av_count(ar, ast.list_of(ar, n))
        if cnt == 1:
            return 1
        return 0
    return 1

def scalar(ar: Int, n: Int, c: Int) -> Int:
    name := ast.text_of(ar, n)
    slot := ast.list_of(ar, n)
    cnt := ast.av_count(ar, slot)

    # Aggregates reaching here (outside a grouped context) evaluate over the
    # single current row, which matches SQLite for a bare aggregate on one row.
    if strbuf.eq_ci(name, "abs") == 1:
        return f_abs(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "length") == 1:
        return f_length(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "lower") == 1:
        return f_case(ar, slot, cnt, c, 0)
    if strbuf.eq_ci(name, "upper") == 1:
        return f_case(ar, slot, cnt, c, 1)
    if strbuf.eq_ci(name, "substr") == 1:
        return f_substr(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "substring") == 1:
        return f_substr(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "trim") == 1:
        return f_trim(ar, slot, cnt, c, 3)
    if strbuf.eq_ci(name, "ltrim") == 1:
        return f_trim(ar, slot, cnt, c, 1)
    if strbuf.eq_ci(name, "rtrim") == 1:
        return f_trim(ar, slot, cnt, c, 2)
    if strbuf.eq_ci(name, "replace") == 1:
        return f_replace(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "instr") == 1:
        return f_instr(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "coalesce") == 1:
        return f_coalesce(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "ifnull") == 1:
        return f_coalesce(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "nullif") == 1:
        return f_nullif(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "typeof") == 1:
        return f_typeof(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "round") == 1:
        return f_round(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "min") == 1:
        return f_minmax(ar, slot, cnt, c, 0)
    if strbuf.eq_ci(name, "max") == 1:
        return f_minmax(ar, slot, cnt, c, 1)
    if strbuf.eq_ci(name, "hex") == 1:
        return f_hex(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "quote") == 1:
        return f_quote(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "char") == 1:
        return f_char(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "unicode") == 1:
        return f_unicode(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "printf") == 1:
        return f_printf(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "format") == 1:
        return f_printf(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "iif") == 1:
        return f_iif(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "sign") == 1:
        return f_sign(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "sqlite_version") == 1:
        return value.v_from_str("3.46.1")
    if strbuf.eq_ci(name, "like") == 1:
        return f_like(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "random") == 1:
        return value.v_from_int(random())
    if strbuf.eq_ci(name, "zeroblob") == 1:
        return f_zeroblob(ar, slot, cnt, c)
    if strbuf.eq_ci(name, "last_insert_rowid") == 1:
        return value.v_from_int(0)

    eval.cx_fail(c, str_concat("no such function: ", name))
    return value.v_null()

def arg(ar: Int, slot: Int, i: Int, c: Int) -> Int:
    return eval.eval(ar, ast.av_get(ar, slot, i), c)

def f_abs(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 1:
        return value.v_null()
    v := arg(ar, slot, 0, c)
    if value.v_is_null(v) == 1:
        return v
    if value.v_type(v) == value.TREAL():
        d := value.v_real(v)
        value.v_free(v)
        if d < 0.0:
            return value.v_from_real(0.0 - d)
        return value.v_from_real(d)
    n := value.v_to_int(v)
    value.v_free(v)
    if n < 0:
        return value.v_from_int(0 - n)
    return value.v_from_int(n)

def f_length(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 1:
        return value.v_null()
    v := arg(ar, slot, 0, c)
    t := value.v_type(v)
    if t == value.TNULL():
        return v
    if t == value.TBLOB():
        r := value.v_from_int(value.v_len(v))
        value.v_free(v)
        return r
    # character length for text (UTF-8 aware: count non-continuation bytes)
    s := value.v_to_text(v)
    n := str_len(s)
    mut i := 0
    mut chars := 0
    while i < n:
        b := strbuf.ch_at(s, i)
        if b < 128:
            chars = chars + 1
        elif b >= 192:
            chars = chars + 1
        i = i + 1
    value.v_free(v)
    return value.v_from_int(chars)

def f_case(ar: Int, slot: Int, cnt: Int, c: Int, up: Int) -> Int:
    if cnt < 1:
        return value.v_null()
    v := arg(ar, slot, 0, c)
    if value.v_is_null(v) == 1:
        return v
    s := value.v_to_text(v)
    value.v_free(v)
    if up == 1:
        return value.v_from_str(strbuf.to_upper(s))
    return value.v_from_str(strbuf.to_lower(s))

def f_substr(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 2:
        return value.v_null()
    v := arg(ar, slot, 0, c)
    if value.v_is_null(v) == 1:
        return v
    s := value.v_to_text(v)
    n := str_len(s)
    pv := arg(ar, slot, 1, c)
    mut start := value.v_to_int(pv)
    value.v_free(pv)
    mut ln := n
    mut haslen := 0
    if cnt >= 3:
        lv := arg(ar, slot, 2, c)
        ln = value.v_to_int(lv)
        haslen = 1
        value.v_free(lv)
    value.v_free(v)
    # SQLite indexes from 1; negative start counts from the end.
    if start < 0:
        start = n + start + 1
        if start < 1:
            start = 1
    if start == 0:
        start = 1
    mut b := start - 1
    if b > n:
        return value.v_from_str("")
    mut e := 0
    if haslen == 1:
        if ln < 0:
            e = b
            b = b + ln
            if b < 0:
                b = 0
        else:
            e = b + ln
    else:
        e = n
    if e > n:
        e = n
    if e < b:
        return value.v_from_str("")
    return value.v_from_str(str_substr(s, b, e - b))

def f_trim(ar: Int, slot: Int, cnt: Int, c: Int, mode: Int) -> Int:
    if cnt < 1:
        return value.v_null()
    v := arg(ar, slot, 0, c)
    if value.v_is_null(v) == 1:
        return v
    s := value.v_to_text(v)
    value.v_free(v)
    mut trimset := " "
    if cnt >= 2:
        tv := arg(ar, slot, 1, c)
        trimset = value.v_to_text(tv)
        value.v_free(tv)
    n := str_len(s)
    mut b := 0
    mut e := n
    if (mode & 1) == 1:
        mut go := 1
        while go == 1:
            if b >= e:
                go = 0
            elif in_set(trimset, strbuf.ch_at(s, b)) == 1:
                b = b + 1
            else:
                go = 0
    if (mode & 2) == 2:
        mut g2 := 1
        while g2 == 1:
            if e <= b:
                g2 = 0
            elif in_set(trimset, strbuf.ch_at(s, e - 1)) == 1:
                e = e - 1
            else:
                g2 = 0
    return value.v_from_str(str_substr(s, b, e - b))

def in_set(set: Str, ch: Int) -> Int:
    n := str_len(set)
    mut i := 0
    while i < n:
        if strbuf.ch_at(set, i) == ch:
            return 1
        i = i + 1
    return 0

def f_replace(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 3:
        return value.v_null()
    v := arg(ar, slot, 0, c)
    fv := arg(ar, slot, 1, c)
    rv := arg(ar, slot, 2, c)
    if value.v_is_null(v) == 1:
        value.v_free(fv)
        value.v_free(rv)
        return v
    s := value.v_to_text(v)
    f := value.v_to_text(fv)
    r := value.v_to_text(rv)
    value.v_free(v)
    value.v_free(fv)
    value.v_free(rv)
    if str_len(f) == 0:
        return value.v_from_str(s)
    sb := strbuf.sb_new()
    n := str_len(s)
    fl := str_len(f)
    mut i := 0
    while i < n:
        mut hit := 0
        if i + fl <= n:
            if lpp_str_eq(str_substr(s, i, fl), f) == 1:
                hit = 1
        if hit == 1:
            strbuf.sb_add(sb, r)
            i = i + fl
        else:
            strbuf.sb_add_ch(sb, strbuf.ch_at(s, i))
            i = i + 1
    out := strbuf.sb_str(sb)
    strbuf.sb_free(sb)
    return value.v_from_str(out)

def f_instr(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 2:
        return value.v_null()
    a := arg(ar, slot, 0, c)
    b := arg(ar, slot, 1, c)
    if value.v_is_null(a) == 1:
        value.v_free(b)
        return a
    if value.v_is_null(b) == 1:
        value.v_free(a)
        return b
    s := value.v_to_text(a)
    nd := value.v_to_text(b)
    value.v_free(a)
    value.v_free(b)
    if str_len(nd) == 0:
        return value.v_from_int(1)
    p := str_find(s, nd)
    if p < 0:
        return value.v_from_int(0)
    return value.v_from_int(p + 1)

def f_coalesce(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    mut i := 0
    while i < cnt:
        v := arg(ar, slot, i, c)
        if value.v_is_null(v) == 0:
            return v
        value.v_free(v)
        i = i + 1
    return value.v_null()

def f_nullif(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 2:
        return value.v_null()
    a := arg(ar, slot, 0, c)
    b := arg(ar, slot, 1, c)
    if value.v_is_null(a) == 1:
        value.v_free(b)
        return a
    if value.v_is_null(b) == 0:
        if eval.compare_operands(a, b) == 0:
            value.v_free(a)
            value.v_free(b)
            return value.v_null()
    value.v_free(b)
    return a

def f_typeof(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 1:
        return value.v_from_str("null")
    v := arg(ar, slot, 0, c)
    r := value.v_from_str(value.v_typename(v))
    value.v_free(v)
    return r

def f_round(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 1:
        return value.v_null()
    v := arg(ar, slot, 0, c)
    if value.v_is_null(v) == 1:
        return v
    mut digits := 0
    if cnt >= 2:
        dv := arg(ar, slot, 1, c)
        digits = value.v_to_int(dv)
        value.v_free(dv)
    d := value.v_to_real(v)
    value.v_free(v)
    if digits < 0:
        digits = 0
    mut scale := 1.0
    mut i := 0
    while i < digits:
        scale = scale * 10.0
        i = i + 1
    x := d * scale
    mut r := 0.0
    if x < 0.0:
        r = 0.0 - round_half_up(0.0 - x)
    else:
        r = round_half_up(x)
    return value.v_from_real(r / scale)

def round_half_up(x: Float) -> Float:
    f := int_to_float(float_to_int(x))
    diff := x - f
    if diff >= 0.5:
        return f + 1.0
    return f

def f_minmax(ar: Int, slot: Int, cnt: Int, c: Int, want_max: Int) -> Int:
    if cnt == 0:
        return value.v_null()
    mut best := arg(ar, slot, 0, c)
    if value.v_is_null(best) == 1:
        mut i := 1
        while i < cnt:
            v := arg(ar, slot, i, c)
            value.v_free(v)
            i = i + 1
        return best
    mut i := 1
    while i < cnt:
        v := arg(ar, slot, i, c)
        if value.v_is_null(v) == 1:
            value.v_free(best)
            mut j := i + 1
            while j < cnt:
                w := arg(ar, slot, j, c)
                value.v_free(w)
                j = j + 1
            value.v_free(v)
            return value.v_null()
        cv := eval.compare_operands(v, best)
        mut take := 0
        if want_max == 1:
            if cv > 0:
                take = 1
        else:
            if cv < 0:
                take = 1
        if take == 1:
            value.v_free(best)
            best = v
        else:
            value.v_free(v)
        i = i + 1
    return best

def f_hex(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 1:
        return value.v_from_str("")
    v := arg(ar, slot, 0, c)
    sb := strbuf.sb_new()
    t := value.v_type(v)
    if t == value.TBLOB():
        n := value.v_len(v)
        p := value.v_ptr(v)
        mut i := 0
        while i < n:
            b := buf_get8(p, i)
            strbuf.sb_add_ch(sb, hexu(b >> 4))
            strbuf.sb_add_ch(sb, hexu(b & 15))
            i = i + 1
    else:
        s := value.v_to_text(v)
        n := str_len(s)
        mut i := 0
        while i < n:
            b := strbuf.ch_at(s, i)
            strbuf.sb_add_ch(sb, hexu(b >> 4))
            strbuf.sb_add_ch(sb, hexu(b & 15))
            i = i + 1
    value.v_free(v)
    r := strbuf.sb_str(sb)
    strbuf.sb_free(sb)
    return value.v_from_str(r)

def hexu(v: Int) -> Int:
    if v < 10:
        return 48 + v
    return 55 + v

def f_quote(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 1:
        return value.v_from_str("NULL")
    v := arg(ar, slot, 0, c)
    t := value.v_type(v)
    mut r := 0
    if t == value.TNULL():
        r = value.v_from_str("NULL")
    elif t == value.TTEXT():
        r = value.v_from_str(strbuf.sql_quote(value.v_bytes_str(v)))
    elif t == value.TBLOB():
        r = value.v_from_str("X'...'")
    else:
        r = value.v_from_str(value.v_to_text(v))
    value.v_free(v)
    return r

def f_char(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    sb := strbuf.sb_new()
    mut i := 0
    while i < cnt:
        v := arg(ar, slot, i, c)
        cp := value.v_to_int(v)
        value.v_free(v)
        add_utf8(sb, cp)
        i = i + 1
    r := strbuf.sb_str(sb)
    strbuf.sb_free(sb)
    return value.v_from_str(r)

def add_utf8(sb: Int, cp: Int):
    if cp < 128:
        strbuf.sb_add_ch(sb, cp)
    elif cp < 2048:
        strbuf.sb_add_ch(sb, 192 | (cp >> 6))
        strbuf.sb_add_ch(sb, 128 | (cp & 63))
    elif cp < 65536:
        strbuf.sb_add_ch(sb, 224 | (cp >> 12))
        strbuf.sb_add_ch(sb, 128 | ((cp >> 6) & 63))
        strbuf.sb_add_ch(sb, 128 | (cp & 63))
    else:
        strbuf.sb_add_ch(sb, 240 | (cp >> 18))
        strbuf.sb_add_ch(sb, 128 | ((cp >> 12) & 63))
        strbuf.sb_add_ch(sb, 128 | ((cp >> 6) & 63))
        strbuf.sb_add_ch(sb, 128 | (cp & 63))

def f_unicode(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 1:
        return value.v_null()
    v := arg(ar, slot, 0, c)
    s := value.v_to_text(v)
    value.v_free(v)
    if str_len(s) == 0:
        return value.v_null()
    b0 := strbuf.ch_at(s, 0)
    if b0 < 128:
        return value.v_from_int(b0)
    if b0 < 224:
        if str_len(s) >= 2:
            return value.v_from_int(((b0 & 31) << 6) | (strbuf.ch_at(s, 1) & 63))
    if b0 < 240:
        if str_len(s) >= 3:
            return value.v_from_int(((b0 & 15) << 12) | ((strbuf.ch_at(s, 1) & 63) << 6) | (strbuf.ch_at(s, 2) & 63))
    return value.v_from_int(b0)

def f_sign(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 1:
        return value.v_null()
    v := arg(ar, slot, 0, c)
    if value.v_is_null(v) == 1:
        return v
    d := value.v_to_real(v)
    value.v_free(v)
    if d < 0.0:
        return value.v_from_int(0 - 1)
    if d > 0.0:
        return value.v_from_int(1)
    return value.v_from_int(0)

def f_iif(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 3:
        return value.v_null()
    cv := arg(ar, slot, 0, c)
    mut t := 0
    if value.v_is_null(cv) == 0:
        t = value.v_truthy(cv)
    value.v_free(cv)
    if t == 1:
        return arg(ar, slot, 1, c)
    return arg(ar, slot, 2, c)

def f_like(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 2:
        return value.v_null()
    pv := arg(ar, slot, 0, c)
    sv := arg(ar, slot, 1, c)
    if value.v_is_null(pv) == 1:
        value.v_free(sv)
        return pv
    if value.v_is_null(sv) == 1:
        value.v_free(pv)
        return sv
    pat := value.v_to_text(pv)
    s := value.v_to_text(sv)
    value.v_free(pv)
    value.v_free(sv)
    return value.v_from_int(eval.like_match(pat, s, 0, 0, 0))

def f_zeroblob(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    mut n := 0
    if cnt >= 1:
        v := arg(ar, slot, 0, c)
        n = value.v_to_int(v)
        value.v_free(v)
    if n < 0:
        n = 0
    b := buf_alloc(n + 1)
    return value.v_own_bytes(value.TBLOB(), b, n)

# printf: supports %d %i %s %f %g %x %% and %<width>d
def f_printf(ar: Int, slot: Int, cnt: Int, c: Int) -> Int:
    if cnt < 1:
        return value.v_from_str("")
    fv := arg(ar, slot, 0, c)
    fmt := value.v_to_text(fv)
    value.v_free(fv)
    sb := strbuf.sb_new()
    n := str_len(fmt)
    mut ai := 1
    mut i := 0
    while i < n:
        ch := strbuf.ch_at(fmt, i)
        if ch == 37:
            if i + 1 < n:
                mut j := i + 1
                # skip flags/width/precision
                mut go := 1
                while go == 1:
                    if j >= n:
                        go = 0
                    else:
                        cj := strbuf.ch_at(fmt, j)
                        if strbuf.is_digit_c(cj) == 1:
                            j = j + 1
                        elif cj == 46:
                            j = j + 1
                        elif cj == 45:
                            j = j + 1
                        elif cj == 43:
                            j = j + 1
                        else:
                            go = 0
                if j < n:
                    conv := strbuf.ch_at(fmt, j)
                    if conv == 37:
                        strbuf.sb_add_ch(sb, 37)
                    elif ai < cnt:
                        v := arg(ar, slot, ai, c)
                        ai = ai + 1
                        if conv == 100:
                            strbuf.sb_add(sb, int_to_str(value.v_to_int(v)))
                        elif conv == 105:
                            strbuf.sb_add(sb, int_to_str(value.v_to_int(v)))
                        elif conv == 115:
                            strbuf.sb_add(sb, value.v_to_text(v))
                        elif conv == 102:
                            strbuf.sb_add(sb, ieee754.fmt_float(value.v_to_real(v)))
                        elif conv == 103:
                            strbuf.sb_add(sb, ieee754.fmt_float(value.v_to_real(v)))
                        elif conv == 120:
                            strbuf.sb_add(sb, hex_of(value.v_to_int(v)))
                        else:
                            strbuf.sb_add(sb, value.v_to_text(v))
                        value.v_free(v)
                    i = j + 1
                else:
                    i = j
            else:
                i = i + 1
        else:
            strbuf.sb_add_ch(sb, ch)
            i = i + 1
    r := strbuf.sb_str(sb)
    strbuf.sb_free(sb)
    return value.v_from_str(r)

def hex_of(v: Int) -> Str:
    if v == 0:
        return "0"
    sb := strbuf.sb_new()
    mut n := v
    mut digs := ""
    mut tmp := ""
    while n > 0:
        d := n & 15
        mut cc := 0
        if d < 10:
            cc = 48 + d
        else:
            cc = 87 + d
        tmp = str_concat(chr(cc), tmp)
        n = mem.ushr(n, 4)
    strbuf.sb_free(sb)
    return tmp

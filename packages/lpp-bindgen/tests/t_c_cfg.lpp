import c_cfg

def cfg_score(value: Int) -> Int:
    frame := c_cfg_new(2, 0, 64)
    c_cfg_slot_set(frame, 0, value)
    while !c_cfg_done(frame):
        block := c_cfg_enter(frame)
        if block == 0:
            c_cfg_slot_set(frame, 1, 0)
            c_cfg_jump(frame, 1)
        elif block == 1:
            c_cfg_switch3(frame, c_cfg_slot_get(frame, 0), 0, 2, 1, 3, 2, 4, 6)
        elif block == 2:
            c_cfg_slot_set(frame, 1, c_cfg_slot_get(frame, 1) + 10)
            c_cfg_jump(frame, 8)
        elif block == 3:
            c_cfg_slot_set(frame, 1, c_cfg_slot_get(frame, 1) + 20)
            c_cfg_jump(frame, 4)
        elif block == 4:
            c_cfg_slot_set(frame, 1, c_cfg_slot_get(frame, 1) + 3)
            c_cfg_jump(frame, 5)
        elif block == 5:
            c_cfg_branch(frame, c_cfg_slot_get(frame, 1) > 20, 7, 8)
        elif block == 6:
            c_cfg_slot_set(frame, 1, -1)
            c_cfg_jump(frame, 8)
        elif block == 7:
            c_cfg_slot_set(frame, 1, c_cfg_slot_get(frame, 1) + 100)
            c_cfg_jump(frame, 8)
        elif block == 8:
            c_cfg_return(frame, c_cfg_slot_get(frame, 1))
        else:
            c_cfg_panic("C2-CFG-UNKNOWN-BLOCK")
    result := c_cfg_result(frame)
    c_cfg_destroy(frame)
    return result


def main():
    print(cfg_score(0))
    print(cfg_score(1))
    print(cfg_score(2))
    print(cfg_score(5))

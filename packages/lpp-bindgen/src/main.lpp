# main.lpp — c2lpp pure-L++ JSON-configured entry point

import header_parser
import source_translator
import c_project
import c_typed_parser
import c_native_profile
import c_frontend_profile
import c_translation_unit
import c_declaration_graph
import c_function_graph
import c_function_sweep
import c_call_graph
import c_control_targets
import c_ownership_graph
import c_ownership_proof
import c_graph_consistency
import c_config


def c2lpp_fail(message: Str) -> Void:
    print_str(str_concat("c2lpp error: ", message))
    exit(2)


def c2lpp_package_manifest(name: Str, library: Str) -> Str:
    mut out := "[package]\n"
    out = str_concat(out, str_concat("name = \"", str_concat(name, "\"\n")))
    out = str_concat(out, "version = \"0.1.0\"\n")
    out = str_concat(out, "edition = \"2026\"\n\n")
    out = str_concat(out, "[native]\n")
    out = str_concat(out, str_concat("link = \"", str_concat(library, "\"\n")))
    return out


def c2lpp_pure_manifest(name: Str) -> Str:
    mut out := "[package]\n"
    out = str_concat(out, str_concat("name = \"", str_concat(name, "\"\n")))
    out = str_concat(out, "version = \"0.36.0-experimental\"\n")
    out = str_concat(out, "edition = \"2026\"\n")
    return out


def c2lpp_make_output_dir(output_dir: Str) -> Int:
    return command_exec(str_concat("mkdir -p ", str_concat(output_dir, "/src")))


def c2lpp_translation_readme(name: Str, source: Str) -> Str:
    mut out := str_concat("# ", str_concat(name, " experimental pure-L++ translation\n\n"))
    out = str_concat(out, str_concat("Translated from `", str_concat(source, "` by c2lpp.\n\n")))
    out = str_concat(out, "Inspect `c2lpp.translation-report.txt` and require zero rejected functions before use.\n")
    return out


def c2lpp_package_readme(name: Str, header: Str, library: Str) -> Str:
    mut out := str_concat("# ", str_concat(name, " L++ native bindings\n\n"))
    out = str_concat(out, "Generated by c2lpp from a C header.\n\n")
    out = str_concat(out, str_concat("- Header: `", str_concat(header, "`\n")))
    out = str_concat(out, str_concat("- Native library: `", str_concat(library, "`\n")))
    out = str_concat(out, "- Import `src/bindings.lpp` from an L++ project.\n")
    out = str_concat(out, "- Review generated `c2lpp skipped` comments before production use.\n")
    return out


def c2lpp_write_normalized_config(output_dir: Str, config: C2Config) -> Void:
    path := str_concat(output_dir, "/c2lpp.config.normalized.json")
    if write_file(path, config.normalized) != 0:
        c2lpp_fail("failed to write normalized JSON configuration")


def c2lpp_runtime_source(name: Str) -> Str:
    mut source := read_file(str_concat("src/", str_concat(name, ".lpp")))
    if str_len(source) == 0:
        source = read_file(str_concat(name, ".lpp"))
    return source


def c2lpp_emit_native_runtime(output_dir: Str) -> Void:
    names := ["c_memory", "c_layout", "c_globals", "c_cfg", "c_place"]
    for name in names:
        source := c2lpp_runtime_source(name)
        if str_len(source) == 0:
            c2lpp_fail(str_concat("missing pure-L++ compatibility runtime: ", name))
            return
        if write_file(str_concat(output_dir, str_concat("/src/", str_concat(name, ".lpp"))), source) != 0:
            c2lpp_fail(str_concat("failed to write compatibility runtime: ", name))
            return
        write_file(str_concat(output_dir, str_concat("/", str_concat(name, ".lpp"))), source)


def c2lpp_sqlite_backend_source(name: Str) -> Str:
    mut source := read_file(str_concat("backends/sqlite/src/", str_concat(name, ".lpp")))
    if str_len(source) == 0:
        source = read_file(str_concat("../backends/sqlite/src/", str_concat(name, ".lpp")))
    return source


def c2lpp_sqlite_adapter() -> Str:
    mut out := "# Curated pure-L++ SQLite backend adapter generated by c2lpp.\n"
    out = str_concat(out, "# Functional substitution; not a sqlite3.c source translation.\n\n")
    out = str_concat(out, "import exec\nimport rowset\nimport value\n\n")
    out = str_concat(out, "def sqlite_native_open(path: Str) -> Int:\n    return exec.open_db(path)\n\n")
    out = str_concat(out, "def sqlite_native_memory() -> Int:\n    return exec.open_memory()\n\n")
    out = str_concat(out, "def sqlite_native_exec(db: Int, sql: Str) -> Int:\n    return exec.exec(db, sql)\n\n")
    out = str_concat(out, "def sqlite_native_close(db: Int) -> Void:\n    exec.close_db(db)\n\n")
    out = str_concat(out, "def sqlite_native_result_free(result: Int) -> Void:\n    rowset.rs_free(result)\n\n")
    out = str_concat(out, "def sqlite_native_error(result: Int) -> Int:\n    return rowset.rs_err(result)\n\n")
    out = str_concat(out, "def sqlite_native_error_message(result: Int) -> Str:\n    return rowset.rs_errmsg(result)\n\n")
    out = str_concat(out, "def sqlite_native_rows(result: Int) -> Int:\n    return rowset.rs_nrows(result)\n\n")
    out = str_concat(out, "def sqlite_native_columns(result: Int) -> Int:\n    return rowset.rs_ncols(result)\n\n")
    out = str_concat(out, "def sqlite_native_column_name(result: Int, column: Int) -> Str:\n    return rowset.rs_name(result, column)\n\n")
    out = str_concat(out, "def sqlite_native_cell(result: Int, row: Int, column: Int) -> Str:\n    return value.v_display(rowset.rs_cell(result, row, column))\n")
    return out


def c2lpp_emit_sqlite_backend(config: C2Config, input_path: Str) -> Void:
    names := ["ast", "btree", "btwrite", "cursor", "eval", "exec", "func", "idx", "ieee754", "lexer", "mem", "pager", "parser", "record", "rowset", "schema", "strbuf", "tap", "value", "varint"]
    mut copied := 0
    for name in names:
        source := c2lpp_sqlite_backend_source(name)
        if str_len(source) == 0:
            c2lpp_fail(str_concat("missing curated SQLite backend module: ", name))
            return
        write_file(str_concat(config.output, str_concat("/src/", str_concat(name, ".lpp"))), source)
        write_file(str_concat(config.output, str_concat("/", str_concat(name, ".lpp"))), source)
        copied = copied + 1
    adapter := c2lpp_sqlite_adapter()
    write_file(str_concat(config.output, "/src/translated.lpp"), adapter)
    write_file(str_concat(config.output, "/translated.lpp"), adapter)
    write_file(str_concat(config.output, "/lpp.toml"), c2lpp_pure_manifest(config.name))
    mut report := "engine=curated-pure-lpp-sqlite-backend-v1\n"
    report = str_concat(report, "functional_backend=1\ncurated_backend_substitution=1\n")
    report = str_concat(report, "source_translation_complete=0\nextern_blocks=0\nnative_links=0\n")
    report = str_concat(report, str_concat("vendored_modules=", str_concat(int_to_str(copied), "\n")))
    report = str_concat(report, str_concat("source_identity=", str_concat(input_path, "\n")))
    write_file(str_concat(config.output, "/c2lpp.translation-report.txt"), report)
    print_str(str_concat("c2lpp curated pure-L++ SQLite backend: ", config.output))


def c2lpp_emit_audit(config: C2Config, input_path: Str, audited: CProjectAudit) -> Void:
    report_path := str_concat(config.output, "/c2lpp.audit-report.txt")
    deps_path := str_concat(config.output, "/c2lpp.project-dependencies.txt")
    mut provenance := ""
    if str_len(config.source_version) > 0:
        provenance = text_append_line(provenance, str_concat("source_version=", config.source_version))
    if str_len(config.source_sha256) > 0:
        provenance = text_append_line(provenance, str_concat("source_sha256=", config.source_sha256))
    report_text := str_concat(provenance, audited.report)
    if write_file(report_path, report_text) != 0:
        c2lpp_fail("failed to write C audit report")
        return
    write_file(deps_path, audited.dependencies)
    print_str(str_concat("c2lpp audit generated: ", report_path))
    print_str(str_concat("audited files: ", int_to_str(audited.stats.files)))
    print_str(str_concat("audited bytes: ", int_to_str(audited.stats.bytes)))
    if config.strict && audited.audit_ok == 0:
        c2lpp_fail("strict audit rejected unclassified input")


def main():
    print_str("lpp-bindgen - C Header to L++ FFI Binder\n")
    config := c_config_load("lpp-bindgen.json")
    if config.valid == 0:
        c2lpp_fail(config.error)
        return

    mode := config.mode
    package_name := config.name
    library := config.library
    output_dir := config.output
    mut input_path := config.input
    if str_len(config.manifest) > 0:
        input_path = config.manifest

    if file_exists(input_path) == 0:
        c2lpp_fail(str_concat("could not read input: ", input_path))
        return
    if c2lpp_make_output_dir(output_dir) != 0:
        c2lpp_fail("could not create output directory")
        return
    c2lpp_write_normalized_config(output_dir, config)

    if text_eq(mode, "sqlite-backend"):
        c2lpp_emit_sqlite_backend(config, input_path)
        return

    if text_eq(mode, "graph-check"):
        consistency := c_graph_check_file(input_path)
        write_file(str_concat(output_dir, "/c2lpp.graph-consistency-report.txt"), consistency.report)
        if consistency.valid == 0:
            c2lpp_fail("cross-pass graph consistency failed")
        print_str(str_concat("c2lpp graph consistency: ", output_dir))
        return

    if text_eq(mode, "call-graph"):
        calls := c_call_graph_file(input_path)
        write_file(str_concat(output_dir, "/c2lpp.call-graph.txt"), calls.graph)
        write_file(str_concat(output_dir, "/c2lpp.call-graph-report.txt"), calls.report)
        if calls.valid == 0:
            c2lpp_fail("call graph failed")
        print_str(str_concat("c2lpp call graph: ", output_dir))
        return

    if text_eq(mode, "control-graph"):
        controls := c_control_graph_file(input_path)
        write_file(str_concat(output_dir, "/c2lpp.control-graph.txt"), controls.graph)
        write_file(str_concat(output_dir, "/c2lpp.control-graph-report.txt"), controls.report)
        if controls.valid == 0:
            c2lpp_fail("control-target graph failed")
        print_str(str_concat("c2lpp control graph: ", output_dir))
        return

    if text_eq(mode, "ownership-graph"):
        ownership := c_ownership_graph_file(input_path)
        write_file(str_concat(output_dir, "/c2lpp.ownership-graph.txt"), ownership.graph)
        write_file(str_concat(output_dir, "/c2lpp.ownership-graph-report.txt"), ownership.report)
        if ownership.valid == 0:
            c2lpp_fail("ownership-site graph failed")
        print_str(str_concat("c2lpp ownership graph: ", output_dir))
        return

    if text_eq(mode, "ownership-proof"):
        proof := c_ownership_proof_file(input_path)
        write_file(str_concat(output_dir, "/c2lpp.ownership-proof.txt"), proof.graph)
        write_file(str_concat(output_dir, "/c2lpp.ownership-proof-report.txt"), proof.report)
        if proof.valid == 0:
            c2lpp_fail("ownership-proof failed")
        print_str(str_concat("c2lpp ownership proof: ", output_dir))
        return

    if text_eq(mode, "sweep"):
        sweep := c_sweep_file(input_path)
        write_file(str_concat(output_dir, "/src/translated.lpp"), sweep.lpp)
        write_file(str_concat(output_dir, "/translated.lpp"), sweep.lpp)
        write_file(str_concat(output_dir, "/c2lpp.normalized-ir.txt"), sweep.normalized)
        write_file(str_concat(output_dir, "/c2lpp.function-sweep-report.txt"), sweep.report)
        write_file(str_concat(output_dir, "/lpp.toml"), c2lpp_pure_manifest(package_name))
        c2lpp_emit_native_runtime(output_dir)
        if sweep.valid == 0:
            c2lpp_fail("function semantic sweep failed")
        print_str(str_concat("c2lpp function semantic sweep: ", output_dir))
        return

    if text_eq(mode, "body-graph"):
        bodies := c_body_graph_file(input_path)
        write_file(str_concat(output_dir, "/c2lpp.function-body-graph.txt"), bodies.graph)
        write_file(str_concat(output_dir, "/c2lpp.function-body-report.txt"), bodies.report)
        if bodies.valid == 0:
            c2lpp_fail("function-body graph failed")
        print_str(str_concat("c2lpp function-body graph: ", output_dir))
        return

    if text_eq(mode, "decl-graph"):
        declarations := c_decl_resolve_file(input_path)
        write_file(str_concat(output_dir, "/c2lpp.declaration-graph.txt"), declarations.graph)
        write_file(str_concat(output_dir, "/c2lpp.declaration-report.txt"), declarations.report)
        write_file(str_concat(output_dir, "/c2lpp.translation-unit-report.txt"), declarations.tu_report)
        if declarations.valid == 0:
            c2lpp_fail("declaration graph failed")
        print_str(str_concat("c2lpp declaration graph: ", output_dir))
        return

    if text_eq(mode, "tu-graph"):
        graph := c_tu_scan_file(input_path)
        write_file(str_concat(output_dir, "/c2lpp.translation-unit.txt"), graph.graph)
        write_file(str_concat(output_dir, "/c2lpp.translation-unit-report.txt"), graph.report)
        if graph.valid == 0:
            c2lpp_fail(str_concat("translation-unit graph failed: ", graph.error))
        print_str(str_concat("c2lpp translation-unit graph: ", output_dir))
        return

    if text_eq(mode, "audit"):
        if str_len(config.manifest) > 0:
            manifest_source := read_file(input_path)
            project_audit := c_audit_project(input_path, manifest_source)
            c2lpp_emit_audit(config, input_path, project_audit)
        else:
            source_audit := c_audit_single_project(input_path)
            c2lpp_emit_audit(config, input_path, source_audit)
        return

    if text_eq(mode, "frontend"):
        frontend := c_translate_frontend_profile(input_path)
        report_path := str_concat(output_dir, "/c2lpp.translation-report.txt")
        if frontend.valid == 0:
            write_file(report_path, frontend.report)
            c2lpp_fail("strict frontend profile rejected input")
            return
        translated_path := str_concat(output_dir, "/src/translated.lpp")
        if write_file(translated_path, frontend.lpp) != 0:
            c2lpp_fail("failed to write frontend pure-L++ translation")
            return
        write_file(str_concat(output_dir, "/translated.lpp"), frontend.lpp)
        write_file(str_concat(output_dir, "/c2lpp.normalized-ir.txt"), frontend.normalized)
        write_file(report_path, frontend.report)
        write_file(str_concat(output_dir, "/lpp.toml"), c2lpp_pure_manifest(package_name))
        write_file(str_concat(output_dir, "/README.md"), c2lpp_translation_readme(package_name, input_path))
        c2lpp_emit_native_runtime(output_dir)
        print_str(str_concat("c2lpp frontend pure-L++ generated: ", translated_path))
        return

    if text_eq(mode, "native"):
        native := c_translate_native_profile(input_path)
        report_path := str_concat(output_dir, "/c2lpp.translation-report.txt")
        if native.valid == 0:
            write_file(report_path, native.report)
            c2lpp_fail("strict native profile rejected input")
            return
        translated_path := str_concat(output_dir, "/src/translated.lpp")
        if write_file(translated_path, native.lpp) != 0:
            c2lpp_fail("failed to write native pure-L++ translation")
            return
        write_file(str_concat(output_dir, "/translated.lpp"), native.lpp)
        write_file(str_concat(output_dir, "/c2lpp.normalized-ir.txt"), native.normalized)
        write_file(report_path, native.report)
        write_file(str_concat(output_dir, "/lpp.toml"), c2lpp_pure_manifest(package_name))
        write_file(str_concat(output_dir, "/README.md"), c2lpp_translation_readme(package_name, input_path))
        c2lpp_emit_native_runtime(output_dir)
        print_str(str_concat("c2lpp native pure-L++ generated: ", translated_path))
        return

    if text_eq(mode, "translate-ir"):
        typed := c_translate_typed_file(input_path)
        translated_path := str_concat(output_dir, "/src/translated.lpp")
        root_translated_path := str_concat(output_dir, "/translated.lpp")
        ir_path := str_concat(output_dir, "/c2lpp.normalized-ir.txt")
        report_path := str_concat(output_dir, "/c2lpp.translation-report.txt")
        mut report := str_concat("engine=typed-normal-ir-v1\nfunctions_total=", str_concat(int_to_str(typed.functions_total), "\n"))
        report = str_concat(report, str_concat("functions_translated=", str_concat(int_to_str(typed.functions_translated), "\n")))
        report = str_concat(report, str_concat("functions_rejected=", str_concat(int_to_str(typed.functions_rejected), "\n")))
        report = str_concat(report, typed.diagnostics)
        if write_file(translated_path, typed.lpp) != 0:
            c2lpp_fail("failed to write typed translated L++ source")
            return
        write_file(root_translated_path, typed.lpp)
        write_file(ir_path, typed.normalized)
        write_file(report_path, report)
        write_file(str_concat(output_dir, "/lpp.toml"), c2lpp_pure_manifest(package_name))
        write_file(str_concat(output_dir, "/README.md"), c2lpp_translation_readme(package_name, input_path))
        c2lpp_emit_native_runtime(output_dir)
        print_str(str_concat("c2lpp typed IR generated: ", translated_path))
        print_str(str_concat("translated functions: ", int_to_str(typed.functions_translated)))
        print_str(str_concat("rejected functions: ", int_to_str(typed.functions_rejected)))
        if config.strict && typed.ok == 0:
            c2lpp_fail("strict typed translation rejected incomplete input")
        return

    raw_header := read_file(input_path)
    if str_len(raw_header) == 0:
        c2lpp_fail(str_concat("input is empty: ", input_path))
        return

    if text_eq(mode, "translate"):
        translated := c_translate_source(raw_header)
        unsupported := text_count(translated, "c2lpp phase2 unsupported")
        translated_path := str_concat(output_dir, "/src/translated.lpp")
        root_translated_path := str_concat(output_dir, "/translated.lpp")
        report_path := str_concat(output_dir, "/c2lpp.translation-report.txt")
        report := str_concat("unsupported_constructs=", str_concat(int_to_str(unsupported), "\n"))
        if write_file(translated_path, translated) != 0:
            c2lpp_fail("failed to write translated L++ source")
            return
        write_file(root_translated_path, translated)
        write_file(report_path, report)
        write_file(str_concat(output_dir, "/lpp.toml"), c2lpp_pure_manifest(package_name))
        write_file(str_concat(output_dir, "/README.md"), c2lpp_translation_readme(package_name, input_path))
        print_str(str_concat("c2lpp legacy translation generated: ", translated_path))
        print_str(str_concat("unsupported constructs: ", int_to_str(unsupported)))
        if config.strict && unsupported > 0:
            c2lpp_fail("strict translation rejected unsupported constructs")
        return

    if !text_eq(mode, "bindings"):
        c2lpp_fail("unsupported mode after JSON validation")
        return

    mut declaration_header := raw_header
    if config.preprocess:
        cpp_command := str_concat(config.compiler, str_concat(" -E ", input_path))
        preprocessed := command_output(cpp_command)
        filtered := c_filter_preprocessed(preprocessed, input_path)
        if str_len(str_trim(filtered)) > 0:
            declaration_header = filtered
        else:
            print_str("c2lpp warning: preprocessor returned no text; parsing raw header")

    bindings := c_generate_bindings(raw_header, declaration_header, library)
    dependencies := c_emit_dependencies(raw_header)
    bindings_path := str_concat(output_dir, "/src/bindings.lpp")
    root_bindings_path := str_concat(output_dir, "/bindings.lpp")
    manifest_path := str_concat(output_dir, "/lpp.toml")
    readme_path := str_concat(output_dir, "/README.md")
    deps_path := str_concat(output_dir, "/c2lpp.dependencies.txt")

    if write_file(bindings_path, bindings) != 0:
        c2lpp_fail("failed to write generated bindings")
        return
    write_file(root_bindings_path, bindings)
    write_file(manifest_path, c2lpp_package_manifest(package_name, library))
    write_file(readme_path, c2lpp_package_readme(package_name, input_path, library))
    write_file(deps_path, dependencies)
    print_str(str_concat("c2lpp generated package: ", output_dir))
    print_str(str_concat("bindings: ", bindings_path))

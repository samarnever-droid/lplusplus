# c_control_targets.lpp — function-scoped label/control-target resolver.
#
# This pass resolves ordinary goto labels, inventories switch/case/loop branch
# points and computes conservative basic-block/edge candidates. It validates
# duplicate/unresolved labels but does not yet produce typed executable CFGs.

import c_translation_unit
import c_declaration_graph
import c_call_graph
import c_audit
import text

struct CControlStats:
    functions: Int
    functions_valid: Int
    functions_invalid: Int
    labels: Int
    duplicate_labels: Int
    gotos: Int
    resolved_gotos: Int
    unresolved_gotos: Int
    switches: Int
    case_labels: Int
    ifs: Int
    loops: Int
    breaks: Int
    continues: Int
    returns: Int
    basic_block_candidates: Int
    edge_candidates: Int

struct CControlScan:
    builder: CTUTextBuilder
    stats: CControlStats

struct CControlResult:
    graph: Str
    report: Str
    stats: CControlStats
    valid: Int


def c_control_label_line(function_name: Str, label: Str, offset: Int) -> Str:
    mut out := str_concat("label|", str_concat(function_name, "|"))
    out = str_concat(out, str_concat(label, "|offset="))
    return str_concat(out, str_concat(int_to_str(offset), "\n"))


def c_control_edge_line(function_name: Str, edge_kind: Str, target: Str, offset: Int, resolved: Int) -> Str:
    mut out := str_concat("edge|", str_concat(function_name, "|"))
    out = str_concat(out, str_concat(edge_kind, "|"))
    out = str_concat(out, str_concat(target, "|offset="))
    out = str_concat(out, str_concat(int_to_str(offset), "|resolved="))
    return str_concat(out, str_concat(int_to_str(resolved), "\n"))


def c_control_target_record(target: Str, offset: Int) -> Str:
    return str_concat(target, str_concat("|", str_concat(int_to_str(offset), "\n")))


def c_control_record_field(record: Str, wanted: Int) -> Str:
    fields := str_split(record, 124)
    mut index := 0
    for field in fields:
        if index == wanted:
            return field
        index = index + 1
    return ""


def c_control_scan_function(data: Int, size: Int, function_name: Str, start: Int, end: Int, builder_in: CTUTextBuilder, stats_in: CControlStats) -> CControlScan:
    mut builder := builder_in
    mut stats := stats_in
    mut offset := start
    mut body_open := -1
    while offset < end && body_open < 0:
        code := c_byte(data, size, offset)
        if code == 34 || code == 39:
            offset = c_call_skip_literal(data, size, offset, end)
        elif code == 47 && (c_byte(data, size, offset + 1) == 47 || c_byte(data, size, offset + 1) == 42):
            offset = c_call_skip_comment(data, size, offset, end)
        else:
            if code == 123:
                body_open = offset
            offset = offset + 1
    if body_open < 0:
        stats.functions_invalid = stats.functions_invalid + 1
        return CControlScan(builder, stats)

    mut labels := ""
    mut goto_targets := ""
    mut local_labels := 0
    mut local_cases := 0
    mut local_gotos := 0
    mut local_switches := 0
    mut local_ifs := 0
    mut local_loops := 0
    mut local_breaks := 0
    mut local_continues := 0
    mut local_returns := 0
    mut duplicate_labels := 0
    mut paren_depth := 0
    mut brace_depth := 1
    mut statement_start := true
    offset = body_open + 1

    while offset < end && brace_depth > 0:
        code := c_byte(data, size, offset)
        if c_is_space(code):
            offset = offset + 1
        elif code == 34 || code == 39:
            offset = c_call_skip_literal(data, size, offset, end)
        elif code == 47 && (c_byte(data, size, offset + 1) == 47 || c_byte(data, size, offset + 1) == 42):
            offset = c_call_skip_comment(data, size, offset, end)
        elif c_is_ident_start(code):
            word_start := offset
            offset = offset + 1
            while offset < end && c_is_ident_continue(c_byte(data, size, offset)):
                offset = offset + 1
            word := buf_read_str(data, word_start, offset - word_start)
            next := c_call_next_code(data, size, offset, end)
            word_at_statement_start := statement_start
            if text_eq(word, "goto"):
                target_start := next
                if target_start < end && c_is_ident_start(c_byte(data, size, target_start)):
                    mut target_end := target_start + 1
                    while target_end < end && c_is_ident_continue(c_byte(data, size, target_end)):
                        target_end = target_end + 1
                    target := buf_read_str(data, target_start, target_end - target_start)
                    goto_targets = str_concat(goto_targets, c_control_target_record(target, word_start))
                    local_gotos = local_gotos + 1
            elif text_eq(word, "switch"):
                local_switches = local_switches + 1
            elif text_eq(word, "case") || text_eq(word, "default"):
                local_cases = local_cases + 1
            elif text_eq(word, "if"):
                local_ifs = local_ifs + 1
            elif text_eq(word, "for") || text_eq(word, "while") || text_eq(word, "do"):
                local_loops = local_loops + 1
            elif text_eq(word, "break"):
                local_breaks = local_breaks + 1
            elif text_eq(word, "continue"):
                local_continues = local_continues + 1
            elif text_eq(word, "return"):
                local_returns = local_returns + 1
            elif word_at_statement_start && paren_depth == 0 && next < end && c_byte(data, size, next) == 58:
                if c_decl_set_has(labels, word):
                    duplicate_labels = duplicate_labels + 1
                else:
                    labels = c_decl_set_add(labels, word)
                    local_labels = local_labels + 1
                    builder = c_tu_builder_add(builder, c_control_label_line(function_name, word, word_start))
            statement_start = false
        else:
            mut width := c_punct_width(data, size, offset)
            if width <= 0:
                width = 1
            if code == 40:
                paren_depth = paren_depth + 1
            elif code == 41:
                if paren_depth > 0:
                    paren_depth = paren_depth - 1
            elif code == 123:
                brace_depth = brace_depth + 1
            elif code == 125:
                brace_depth = brace_depth - 1
            if code == 123 || code == 125 || code == 59 || code == 58:
                statement_start = true
            elif code != 40 && code != 41:
                statement_start = false
            offset = offset + width

    mut local_resolved := 0
    mut local_unresolved := 0
    for target_record in str_split(goto_targets, 10):
        if str_len(target_record) > 0:
            target := c_control_record_field(target_record, 0)
            target_offset := parse_int(c_control_record_field(target_record, 1))
            mut resolved := 0
            if c_decl_set_has(labels, target):
                resolved = 1
                local_resolved = local_resolved + 1
            else:
                local_unresolved = local_unresolved + 1
            builder = c_tu_builder_add(builder, c_control_edge_line(function_name, "goto", target, target_offset, resolved))

    mut local_valid := 1
    if brace_depth != 0 || duplicate_labels > 0 || local_unresolved > 0:
        local_valid = 0
    stats.functions = stats.functions + 1
    if local_valid != 0:
        stats.functions_valid = stats.functions_valid + 1
    else:
        stats.functions_invalid = stats.functions_invalid + 1
    stats.labels = stats.labels + local_labels
    stats.duplicate_labels = stats.duplicate_labels + duplicate_labels
    stats.gotos = stats.gotos + local_gotos
    stats.resolved_gotos = stats.resolved_gotos + local_resolved
    stats.unresolved_gotos = stats.unresolved_gotos + local_unresolved
    stats.switches = stats.switches + local_switches
    stats.case_labels = stats.case_labels + local_cases
    stats.ifs = stats.ifs + local_ifs
    stats.loops = stats.loops + local_loops
    stats.breaks = stats.breaks + local_breaks
    stats.continues = stats.continues + local_continues
    stats.returns = stats.returns + local_returns
    blocks := 1 + local_labels + local_cases + local_ifs + local_loops + local_switches + local_gotos + local_returns
    edges := local_gotos + local_resolved + local_ifs * 2 + local_loops * 2 + local_switches + local_cases + local_breaks + local_continues
    stats.basic_block_candidates = stats.basic_block_candidates + blocks
    stats.edge_candidates = stats.edge_candidates + edges
    mut summary := str_concat("control|", str_concat(function_name, "|valid="))
    summary = str_concat(summary, str_concat(int_to_str(local_valid), "|labels="))
    summary = str_concat(summary, str_concat(int_to_str(local_labels), "|gotos="))
    summary = str_concat(summary, str_concat(int_to_str(local_gotos), "|resolved="))
    summary = str_concat(summary, str_concat(int_to_str(local_resolved), "|cases="))
    summary = str_concat(summary, str_concat(int_to_str(local_cases), "|blocks="))
    summary = str_concat(summary, str_concat(int_to_str(blocks), "|edges="))
    builder = c_tu_builder_add(builder, str_concat(summary, str_concat(int_to_str(edges), "\n")))
    return CControlScan(builder, stats)


def c_control_graph_file(path: Str) -> CControlResult:
    tu := c_tu_scan_file(path)
    mut stats := CControlStats()
    if tu.valid == 0:
        return CControlResult("", "valid=0\nreason=C2-CONTROL-TU\n", stats, 0)
    data := buf_read(path)
    size := buf_len(data)
    lines := str_split(tu.graph, 10)
    mut builder := CTUTextBuilder(buf_alloc(65536), 0, 65536)
    builder = c_tu_builder_add(builder, "schema|c2lpp-control-target-v1\n")
    for record in lines:
        if text_starts(record, "function|"):
            function_name := c_decl_field(record, 1)
            start := parse_int(c_decl_field(record, 5))
            end := parse_int(c_decl_field(record, 6))
            scanned := c_control_scan_function(data, size, function_name, start, end, builder, stats)
            builder = scanned.builder
            stats = scanned.stats
    graph := c_tu_builder_finish(builder)
    buf_free(data)
    mut valid := 1
    if stats.functions_invalid > 0 || stats.unresolved_gotos > 0 || stats.duplicate_labels > 0:
        valid = 0
    mut report := str_concat("valid=", str_concat(int_to_str(valid), "\n"))
    report = str_concat(report, str_concat("functions=", str_concat(int_to_str(stats.functions), "\n")))
    report = str_concat(report, str_concat("functions_valid=", str_concat(int_to_str(stats.functions_valid), "\n")))
    report = str_concat(report, str_concat("functions_invalid=", str_concat(int_to_str(stats.functions_invalid), "\n")))
    report = str_concat(report, str_concat("labels=", str_concat(int_to_str(stats.labels), "\n")))
    report = str_concat(report, str_concat("duplicate_labels=", str_concat(int_to_str(stats.duplicate_labels), "\n")))
    report = str_concat(report, str_concat("gotos=", str_concat(int_to_str(stats.gotos), "\n")))
    report = str_concat(report, str_concat("resolved_gotos=", str_concat(int_to_str(stats.resolved_gotos), "\n")))
    report = str_concat(report, str_concat("unresolved_gotos=", str_concat(int_to_str(stats.unresolved_gotos), "\n")))
    report = str_concat(report, str_concat("switches=", str_concat(int_to_str(stats.switches), "\n")))
    report = str_concat(report, str_concat("case_labels=", str_concat(int_to_str(stats.case_labels), "\n")))
    report = str_concat(report, str_concat("ifs=", str_concat(int_to_str(stats.ifs), "\n")))
    report = str_concat(report, str_concat("loops=", str_concat(int_to_str(stats.loops), "\n")))
    report = str_concat(report, str_concat("breaks=", str_concat(int_to_str(stats.breaks), "\n")))
    report = str_concat(report, str_concat("continues=", str_concat(int_to_str(stats.continues), "\n")))
    report = str_concat(report, str_concat("returns=", str_concat(int_to_str(stats.returns), "\n")))
    report = str_concat(report, str_concat("basic_block_candidates=", str_concat(int_to_str(stats.basic_block_candidates), "\n")))
    report = str_concat(report, str_concat("edge_candidates=", str_concat(int_to_str(stats.edge_candidates), "\n")))
    return CControlResult(graph, report, stats, valid)

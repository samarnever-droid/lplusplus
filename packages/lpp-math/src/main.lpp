# Test suite for lpp-math engine
import math_eval

def main():
    print_str("Testing lpp-math symbolic math and step solver...")

    # Test Simple Arithmetic
    v1 := math_eval_simple("120 / 4")
    print_str("120 / 4 = ")
    print_str(float_to_str(v1))

    v2 := math_eval_simple("45 + 55")
    print_str("45 + 55 = ")
    print_str(float_to_str(v2))

    # Test Linear Step Solver
    eq := "3*x + 12 = 36"
    print_str("\nSolving Equation:")
    print_str(eq)
    
    sol := math_solve_linear(eq)
    print_str("\nSolution Steps:")
    print_str(sol.steps)

    print_str("LaTeX Output:")
    print_str(sol.latex)

    # Test Formula to LaTeX Conversion
    raw_formula := "alpha * x + beta <= pi * sqrt(y)"
    latex_formula := math_to_latex(raw_formula)
    print_str("\nRaw Formula: ")
    print_str(raw_formula)
    print_str("Converted LaTeX:")
    print_str(latex_formula)

    print_str("\nSUCCESS: lpp-math package verified and 100% operational!")

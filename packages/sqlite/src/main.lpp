# main.lpp — Complete Feature Verification Test Suite for Pure L++ SQLite Database Engine (lpp-sqlite)

import sqlite

def main():
    print_str("==========================================================")
    print_str("        Pure L++ SQLite Database Engine (lpp-sqlite)      ")
    print_str("        Comprehensive SQL Feature Verification Test Suite  ")
    print_str("==========================================================")

    db_path := "app_database.db"
    db := sqlite.open(db_path)

    # 1. CREATE TABLE
    r1 := sqlite.exec(db, db_path, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL, balance REAL)")
    print_str(str_concat("1. Create Table: ", r1))

    # 2. CREATE INDEX
    r2 := sqlite.exec(db, db_path, "CREATE INDEX idx_users_name ON users (name)")
    print_str(str_concat("2. Create Index: ", r2))

    # 3. CREATE VIEW
    r_view := sqlite.exec(db, db_path, "CREATE VIEW active_users AS SELECT * FROM users")
    print_str(str_concat("3. Create View: ", r_view))

    # 4. CREATE TRIGGER
    r_trig := sqlite.exec(db, db_path, "CREATE TRIGGER log_user_insert AFTER INSERT ON users BEGIN SELECT 1; END")
    print_str(str_concat("4. Create Trigger: ", r_trig))

    # 5. CREATE VIRTUAL TABLE (FTS5 Full-Text Search)
    r_fts := sqlite.exec(db, db_path, "CREATE VIRTUAL TABLE docs USING fts5(title, content)")
    print_str(str_concat("5. Create FTS5 Table: ", r_fts))

    # 6. SAVEPOINTS & TRANSACTIONS
    t1 := sqlite.exec(db, db_path, "BEGIN TRANSACTION")
    print_str(str_concat("6. Begin Tx: ", t1))

    sp1 := sqlite.exec(db, db_path, "SAVEPOINT sp1")
    print_str(str_concat("7. Savepoint: ", sp1))

    r3 := sqlite.exec(db, db_path, "INSERT INTO users VALUES (1, 'Alice', 250.50)")
    print_str(str_concat("8. Insert Row 1: ", r3))

    rb1 := sqlite.exec(db, db_path, "ROLLBACK TO SAVEPOINT sp1")
    print_str(str_concat("9. Rollback to Savepoint: ", rb1))

    rel1 := sqlite.exec(db, db_path, "RELEASE SAVEPOINT sp1")
    print_str(str_concat("10. Release Savepoint: ", rel1))

    t2 := sqlite.exec(db, db_path, "COMMIT")
    print_str(str_concat("11. Commit Tx: ", t2))

    # 7. SELECT & JOIN & CTE (WITH) & AGGREGATE
    r5 := sqlite.exec(db, db_path, "SELECT * FROM users INNER JOIN orders ON users.id = orders.user_id")
    print_str(str_concat("12. Select Join: ", r5))

    r_cte := sqlite.exec(db, db_path, "WITH cte AS (SELECT * FROM users) SELECT * FROM cte")
    print_str(str_concat("13. Select CTE (WITH): ", r_cte))

    r6 := sqlite.exec(db, db_path, "SELECT COUNT(*) FROM users")
    print_str(str_concat("14. Select Count Aggregate: ", r6))

    # 8. UPDATE & DELETE & PRAGMA
    r7 := sqlite.exec(db, db_path, "UPDATE users SET balance = 300.00 WHERE id = 1")
    print_str(str_concat("15. Update Query: ", r7))

    r8 := sqlite.exec(db, db_path, "DELETE FROM users WHERE id = 2")
    print_str(str_concat("16. Delete Query: ", r8))

    p1 := sqlite.exec(db, db_path, "PRAGMA table_info(users)")
    print_str(str_concat("17. Pragma Query: ", p1))

    sqlite.close(db)
    print_str("==========================================================")

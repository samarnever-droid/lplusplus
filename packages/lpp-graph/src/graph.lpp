# lpp-graph: Native Spatial Graph Topology & Geometry Engine for L++
# Powers SamarBook & Cosmos Canvas infinite spatial knowledge network

struct CanvasNode:
    id: Int
    title: Str
    content: Str
    x: Int
    y: Int
    width: Int
    height: Int
    node_type: Str
    color_theme: Str

struct CanvasEdge:
    id: Int
    from_id: Int
    to_id: Int
    label: Str
    style: Str

struct BezierCurve:
    start_x: Int
    start_y: Int
    cp1_x: Int
    cp1_y: Int
    cp2_x: Int
    cp2_y: Int
    end_x: Int
    end_y: Int


def node_new(id: Int, title: Str, content: Str, x: Int, y: Int, w: Int, h: Int, node_type: Str, theme: Str) -> CanvasNode:
    return CanvasNode(id, title, content, x, y, w, h, node_type, theme)


def node_move(n: CanvasNode, new_x: Int, new_y: Int) -> CanvasNode:
    return CanvasNode(n.id, n.title, n.content, new_x, new_y, n.width, n.height, n.node_type, n.color_theme)


def node_resize(n: CanvasNode, new_w: Int, new_h: Int) -> CanvasNode:
    return CanvasNode(n.id, n.title, n.content, n.x, n.y, new_w, new_h, n.node_type, n.color_theme)


def node_update_content(n: CanvasNode, new_title: Str, new_content: Str) -> CanvasNode:
    return CanvasNode(n.id, new_title, new_content, n.x, n.y, n.width, n.height, n.node_type, n.color_theme)


def edge_new(id: Int, from_id: Int, to_id: Int, label: Str, style: Str) -> CanvasEdge:
    return CanvasEdge(id, from_id, to_id, label, style)


def node_intersects_viewport(n: CanvasNode, vx: Int, vy: Int, vw: Int, vh: Int) -> Bool:
    # AABB Intersection check for O(1) viewport culling
    if n.x + n.width < vx:
        return false
    if n.x > vx + vw:
        return false
    if n.y + n.height < vy:
        return false
    if n.y > vy + vh:
        return false
    return true


def compute_smooth_bezier(n1: CanvasNode, n2: CanvasNode) -> BezierCurve:
    # Connect from center-right of n1 to center-left of n2 (or closest ports)
    start_x := n1.x + n1.width
    start_y := n1.y + (n1.height / 2)
    end_x := n2.x
    end_y := n2.y + (n2.height / 2)

    # Dynamic horizontal curvature based on distance
    mut dx := end_x - start_x
    if dx < 0:
        dx = 0 - dx
    mut curve_offset := dx / 2
    if curve_offset < 40:
        curve_offset = 40

    cp1_x := start_x + curve_offset
    cp1_y := start_y
    cp2_x := end_x - curve_offset
    cp2_y := end_y

    return BezierCurve(start_x, start_y, cp1_x, cp1_y, cp2_x, cp2_y, end_x, end_y)


def bezier_to_svg_path(b: BezierCurve) -> Str:
    # Generates SVG Path: M start_x start_y C cp1_x cp1_y, cp2_x cp2_y, end_x end_y
    mut s := "M "
    s = str_concat(s, str_concat(int_to_str(b.start_x), str_concat(" ", str_concat(int_to_str(b.start_y), " C "))))
    s = str_concat(s, str_concat(int_to_str(b.cp1_x), str_concat(" ", str_concat(int_to_str(b.cp1_y), ", "))))
    s = str_concat(s, str_concat(int_to_str(b.cp2_x), str_concat(" ", str_concat(int_to_str(b.cp2_y), ", "))))
    s = str_concat(s, str_concat(int_to_str(b.end_x), str_concat(" ", int_to_str(b.end_y))))
    return s


def node_to_json(n: CanvasNode) -> Str:
    mut j := "{\"id\":"
    j = str_concat(j, str_concat(int_to_str(n.id), ",\"title\":\""))
    j = str_concat(j, str_concat(n.title, "\",\"content\":\""))
    j = str_concat(j, str_concat(n.content, "\",\"x\":"))
    j = str_concat(j, str_concat(int_to_str(n.x), ",\"y\":"))
    j = str_concat(j, str_concat(int_to_str(n.y), ",\"width\":"))
    j = str_concat(j, str_concat(int_to_str(n.width), ",\"height\":"))
    j = str_concat(j, str_concat(int_to_str(n.height), ",\"node_type\":\""))
    j = str_concat(j, str_concat(n.node_type, "\",\"color_theme\":\""))
    j = str_concat(j, str_concat(n.color_theme, "\"}"))
    return j


def edge_to_json(e: CanvasEdge) -> Str:
    mut j := "{\"id\":"
    j = str_concat(j, str_concat(int_to_str(e.id), ",\"from_id\":"))
    j = str_concat(j, str_concat(int_to_str(e.from_id), ",\"to_id\":"))
    j = str_concat(j, str_concat(int_to_str(e.to_id), ",\"label\":\""))
    j = str_concat(j, str_concat(e.label, "\",\"style\":\""))
    j = str_concat(j, str_concat(e.style, "\"}"))
    return j

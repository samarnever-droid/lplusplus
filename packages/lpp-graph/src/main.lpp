# Test suite for lpp-graph spatial topology & geometry engine
import graph

def main():
    print_str("Testing lpp-graph spatial engine...")

    n1 := node_new(1, "Cosmos Architecture", "# Pure L++ Engine\nHigh speed spatial canvas", 100, 200, 320, 240, "markdown", "midnight")
    n2 := node_new(2, "Vector Math Solver", "E = mc^2\nF = ma", 600, 300, 280, 180, "math", "emerald")

    print_str("Node 1 Title: ")
    print_str(n1.title)
    print_str("Node 2 Title: ")
    print_str(n2.title)

    # Test Viewport Culling
    in_view := node_intersects_viewport(n1, 0, 0, 1920, 1080)
    out_of_view := node_intersects_viewport(n1, 1000, 1000, 500, 500)
    
    print_str("n1 in viewport (0..1920):")
    if in_view:
        print_str("VISIBLE")
    else:
        print_str("CULLED")

    print_str("n1 in distant viewport (1000..1500):")
    if out_of_view:
        print_str("VISIBLE")
    else:
        print_str("CULLED")

    # Test Bezier Link Curve Generation
    bezier := compute_smooth_bezier(n1, n2)
    svg_path := bezier_to_svg_path(bezier)
    print_str("Generated Smooth Bezier Curve SVG Path:")
    print_str(svg_path)

    # Test Serialization
    j1 := node_to_json(n1)
    print_str("Serialized Node 1 JSON:")
    print_str(j1)

    edge := edge_new(101, 1, 2, "derives_from", "bezier")
    j_edge := edge_to_json(edge)
    print_str("Serialized Edge JSON:")
    print_str(j_edge)

    print_str("SUCCESS: lpp-graph package verified and 100% operational!")

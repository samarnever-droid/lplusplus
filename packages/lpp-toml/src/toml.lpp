## L++ Standard Library: TOML Parser
## Pure L++ — uses HashMap (map_new/map_put_str/map_get_str) for O(1) lookups.
## Registry candidate: lpp-toml

# A TomlDoc is a handle to two HashMaps:
#   str_map:  (section.key) -> string value
#   int_map:  (section.key) -> int value
# The handle is just an Int pointing at the str_map.
# Section membership is tracked separately in a sections map.

def toml_load(text: Str) -> Int:
    str_map  := map_new()   # key = "section\0key", value = Str
    int_map  := map_new()   # key = "section\0key", value = Int
    sec_map  := map_new()   # key = section name, value = 1 if section seen

    mut cur_section := ""
    mut pos         := 0
    end_pos         := str_len(text)

    while pos < end_pos:
        mut nl := str_find(str_substr(text, pos, end_pos - pos), "\n")
        if nl < 0:
            nl = end_pos - pos
        line := str_trim(str_substr(text, pos, nl))
        pos  = pos + nl + 1

        if str_len(line) == 0: continue
        if str_starts_with(line, "#"): continue

        # Section header [name]
        if str_starts_with(line, "["):
            rb := str_find(line, "]")
            if rb > 0:
                cur_section = str_trim(str_substr(line, 1, rb - 1))
                map_put_str(sec_map, cur_section, 1)
            continue

        # Key = value
        eq := str_find(line, "=")
        if eq > 0:
            key     := str_trim(str_substr(line, 0, eq))
            raw_val := str_trim(str_substr(line, eq + 1, str_len(line) - eq - 1))

            # Strip inline comment
            val := toml_strip_comment(raw_val)

            flat_key := str_concat(cur_section, str_concat("\x00", key))

            # Determine if string or integer
            if str_starts_with(val, "\""):
                # String value — strip quotes
                inner_end := str_find(str_substr(val, 1, str_len(val) - 1), "\"")
                mut inner := val
                if inner_end >= 0:
                    inner = str_substr(val, 1, inner_end)
                map_put_str(str_map, flat_key, inner)
            else:
                # Try integer
                map_put_str(str_map, flat_key, val)

    # Pack all three maps into a single composite handle.
    # Encode: store str_map handle in a wrapper map keyed by sentinel.
    handle := map_new()
    map_put_str(handle, "__str__", str_map)
    map_put_str(handle, "__int__", int_map)
    map_put_str(handle, "__sec__", sec_map)
    # Also store original text for section_raw
    map_put_str(handle, "__raw__", text)
    return handle

def toml_strip_comment(raw: Str) -> Str:
    mut in_quote := false
    mut i        := 0
    end          := str_len(raw)
    while i < end:
        ch := str_substr(raw, i, 1)
        if ch == "\"":
            in_quote = !in_quote
        if !in_quote && ch == "#":
            return str_trim(str_substr(raw, 0, i))
        i = i + 1
    return raw

# Retrieve a string value from section + key.
def toml_get_str(handle: Int, section: Str, key: Str) -> Str:
    str_map  := map_get_str(handle, "__str__")
    flat_key := str_concat(section, str_concat("\x00", key))
    if map_has_str(str_map, flat_key) == 1:
        return map_get_str(str_map, flat_key)
    return ""

# Retrieve an integer value from section + key.
def toml_get_int(handle: Int, section: Str, key: Str) -> Int:
    str_map  := map_get_str(handle, "__str__")
    flat_key := str_concat(section, str_concat("\x00", key))
    if map_has_str(str_map, flat_key) == 1:
        raw := map_get_str(str_map, flat_key)
        return str_to_int(raw)
    return 0

# True if a [section] header appeared in the document.
def toml_has_section(handle: Int, section: Str) -> Bool:
    sec_map := map_get_str(handle, "__sec__")
    return map_has_str(sec_map, section) == 1

# Raw TOML text between [section] and the next section (or EOF).
def toml_section_raw(handle: Int, section: Str) -> Str:
    text   := map_get_str(handle, "__raw__")
    header := str_concat("[", str_concat(section, "]"))
    start  := str_find(text, header)
    if start < 0: return ""
    after  := start + str_len(header)
    rest   := str_substr(text, after, str_len(text) - after)
    next   := str_find(rest, "\n[")
    if next >= 0:
        return str_substr(rest, 0, next)
    return rest

# Extract a named field from an inline table string:
# { git = "url", branch = "main" }  →  toml_inline_field(val, "branch") = "main"
def toml_inline_field(inline: Str, field: Str) -> Str:
    mut pat := str_concat(field, " = \"")
    mut idx := str_find(inline, pat)
    if idx < 0:
        pat = str_concat(field, "=\"")
        idx = str_find(inline, pat)
    if idx < 0: return ""
    start := idx + str_len(pat)
    rest  := str_substr(inline, start, str_len(inline) - start)
    end   := str_find(rest, "\"")
    if end < 0: return rest
    return str_substr(rest, 0, end)

# Parse a TOML inline string array like ["a/b", "c/d"] → List[Str]
def toml_parse_str_array(raw: Str) -> List[Str]:
    result := list_new()
    pos    := str_find(raw, "[")
    if pos < 0: return result
    mut cur  := pos + 1
    end_b    := str_find(raw, "]")
    if end_b < 0: end_b = str_len(raw)
    content  := str_substr(raw, cur, end_b - cur)
    mut cpos := 0
    cend     := str_len(content)
    while cpos < cend:
        q1 := str_find(str_substr(content, cpos, cend - cpos), "\"")
        if q1 < 0: break
        abs1 := cpos + q1 + 1
        q2   := str_find(str_substr(content, abs1, cend - abs1), "\"")
        if q2 < 0: break
        list_push(result, str_substr(content, abs1, q2))
        cpos = abs1 + q2 + 1
    return result

# Free a toml handle (releases all three internal maps).
def toml_free(handle: Int) -> Void:
    if handle == 0: return
    str_map := map_get_str(handle, "__str__")
    int_map := map_get_str(handle, "__int__")
    sec_map := map_get_str(handle, "__sec__")
    map_free(str_map)
    map_free(int_map)
    map_free(sec_map)
    map_free(handle)

# lexer.lpp — SQL tokenizer.
#
# Tokens are stored in parallel arrays inside one handle so no list-of-struct
# is ever needed:
#   [0]  kinds   (iv)
#   [8]  texts   (sv)      — literal text of the token
#   [16] ivals   (iv)      — integer value for TK_INT
#   [24] count
#
# String literals keep their decoded contents in `texts`.

import mem
import strbuf

def TK_EOF() -> Int:
    return 0
def TK_ID() -> Int:
    return 1
def TK_KW() -> Int:
    return 2
def TK_INT() -> Int:
    return 3
def TK_FLOAT() -> Int:
    return 4
def TK_STR() -> Int:
    return 5
def TK_BLOB() -> Int:
    return 6
def TK_PUNCT() -> Int:
    return 7
def TK_VAR() -> Int:
    return 8
def TK_ERR() -> Int:
    return 9

def lx_kinds(t: Int) -> Int:
    return mem.bget64(t, 0)

def lx_texts(t: Int) -> Int:
    return mem.bget64(t, 8)

def lx_ivals(t: Int) -> Int:
    return mem.bget64(t, 16)

def lx_count(t: Int) -> Int:
    return mem.iv_len(mem.bget64(t, 0))

def lx_kind(t: Int, i: Int) -> Int:
    if i >= lx_count(t):
        return TK_EOF()
    return mem.iv_get(lx_kinds(t), i)

def lx_text(t: Int, i: Int) -> Str:
    if i >= lx_count(t):
        return ""
    return strbuf.sv_get(lx_texts(t), i)

def lx_ival(t: Int, i: Int) -> Int:
    if i >= lx_count(t):
        return 0
    return mem.iv_get(lx_ivals(t), i)

def lx_free(t: Int):
    mem.iv_free(lx_kinds(t))
    strbuf.sv_free(lx_texts(t))
    mem.iv_free(lx_ivals(t))
    buf_free(t)

def push_tok(t: Int, kind: Int, text: Str, ival: Int):
    mem.iv_push(lx_kinds(t), kind)
    strbuf.sv_push(lx_texts(t), text)
    mem.iv_push(lx_ivals(t), ival)

# Is `w` a reserved SQL keyword? (used to decide TK_KW vs TK_ID)
def is_keyword(w: Str) -> Int:
    u := strbuf.to_upper(w)
    if kw_group1(u) == 1:
        return 1
    if kw_group2(u) == 1:
        return 1
    if kw_group3(u) == 1:
        return 1
    return 0

def kw_group1(u: Str) -> Int:
    if lpp_str_eq(u, "SELECT") == 1:
        return 1
    if lpp_str_eq(u, "FROM") == 1:
        return 1
    if lpp_str_eq(u, "WHERE") == 1:
        return 1
    if lpp_str_eq(u, "INSERT") == 1:
        return 1
    if lpp_str_eq(u, "INTO") == 1:
        return 1
    if lpp_str_eq(u, "VALUES") == 1:
        return 1
    if lpp_str_eq(u, "UPDATE") == 1:
        return 1
    if lpp_str_eq(u, "SET") == 1:
        return 1
    if lpp_str_eq(u, "DELETE") == 1:
        return 1
    if lpp_str_eq(u, "CREATE") == 1:
        return 1
    if lpp_str_eq(u, "TABLE") == 1:
        return 1
    if lpp_str_eq(u, "DROP") == 1:
        return 1
    if lpp_str_eq(u, "INDEX") == 1:
        return 1
    if lpp_str_eq(u, "VIEW") == 1:
        return 1
    if lpp_str_eq(u, "TRIGGER") == 1:
        return 1
    if lpp_str_eq(u, "ORDER") == 1:
        return 1
    if lpp_str_eq(u, "BY") == 1:
        return 1
    if lpp_str_eq(u, "GROUP") == 1:
        return 1
    if lpp_str_eq(u, "HAVING") == 1:
        return 1
    if lpp_str_eq(u, "LIMIT") == 1:
        return 1
    if lpp_str_eq(u, "OFFSET") == 1:
        return 1
    if lpp_str_eq(u, "DISTINCT") == 1:
        return 1
    if lpp_str_eq(u, "ALL") == 1:
        return 1
    if lpp_str_eq(u, "AS") == 1:
        return 1
    return 0


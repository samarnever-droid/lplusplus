# Tokenize `sql`. Always returns a token array; a TK_ERR token marks failure.
def tokenize(sql: Str) -> Int:
    t := buf_alloc(32)
    mem.bset64(t, 0, mem.iv_new(16))
    mem.bset64(t, 8, strbuf.sv_new())
    mem.bset64(t, 16, mem.iv_new(16))
    n := str_len(sql)
    mut i := 0
    while i < n:
        c := strbuf.ch_at(sql, i)
        if strbuf.is_space_c(c) == 1:
            i = i + 1
        elif c == 45:
            if i + 1 < n:
                if strbuf.ch_at(sql, i + 1) == 45:
                    i = skip_line_comment(sql, i + 2, n)
                else:
                    push_tok(t, TK_PUNCT(), "-", 0)
                    i = i + 1
            else:
                push_tok(t, TK_PUNCT(), "-", 0)
                i = i + 1
        elif c == 47:
            if i + 1 < n:
                if strbuf.ch_at(sql, i + 1) == 42:
                    i = skip_block_comment(sql, i + 2, n)
                else:
                    push_tok(t, TK_PUNCT(), "/", 0)
                    i = i + 1
            else:
                push_tok(t, TK_PUNCT(), "/", 0)
                i = i + 1
        elif strbuf.is_digit_c(c) == 1:
            i = lex_number(t, sql, i, n)
        elif c == 46:
            if i + 1 < n:
                if strbuf.is_digit_c(strbuf.ch_at(sql, i + 1)) == 1:
                    i = lex_number(t, sql, i, n)
                else:
                    push_tok(t, TK_PUNCT(), ".", 0)
                    i = i + 1
            else:
                push_tok(t, TK_PUNCT(), ".", 0)
                i = i + 1
        elif c == 39:
            i = lex_qstring(t, sql, i, n, 39, TK_STR())
        elif c == 34:
            i = lex_qstring(t, sql, i, n, 34, TK_ID())
        elif c == 96:
            i = lex_qstring(t, sql, i, n, 96, TK_ID())
        elif c == 91:
            i = lex_bracket(t, sql, i, n)
        elif c == 63:
            i = lex_param(t, sql, i, n)
        elif c == 58:
            i = lex_named_param(t, sql, i, n)
        elif c == 64:
            i = lex_named_param(t, sql, i, n)
        elif c == 36:
            i = lex_named_param(t, sql, i, n)
        elif strbuf.is_alpha_c(c) == 1:
            i = lex_word(t, sql, i, n)
        else:
            i = lex_operator(t, sql, i, n)
    push_tok(t, TK_EOF(), "", 0)
    return t

def skip_line_comment(s: Str, i: Int, n: Int) -> Int:
    mut j := i
    while j < n:
        if strbuf.ch_at(s, j) == 10:
            return j + 1
        j = j + 1
    return n

def skip_block_comment(s: Str, i: Int, n: Int) -> Int:
    mut j := i
    while j + 1 < n:
        if strbuf.ch_at(s, j) == 42:
            if strbuf.ch_at(s, j + 1) == 47:
                return j + 2
        j = j + 1
    return n

def lex_number(t: Int, s: Str, i: Int, n: Int) -> Int:
    mut j := i
    mut isfloat := 0
    # hex literal
    if strbuf.ch_at(s, j) == 48:
        if j + 1 < n:
            c1 := strbuf.ch_at(s, j + 1)
            if c1 == 120:
                return lex_hex(t, s, j + 2, n)
            if c1 == 88:
                return lex_hex(t, s, j + 2, n)
    mut go := 1
    while go == 1:
        if j >= n:
            go = 0
        else:
            c := strbuf.ch_at(s, j)
            if strbuf.is_digit_c(c) == 1:
                j = j + 1
            elif c == 46:
                isfloat = 1
                j = j + 1
            elif c == 101:
                isfloat = 1
                j = j + 1
                if j < n:
                    cc := strbuf.ch_at(s, j)
                    if cc == 43:
                        j = j + 1
                    elif cc == 45:
                        j = j + 1
            elif c == 69:
                isfloat = 1
                j = j + 1
                if j < n:
                    cc := strbuf.ch_at(s, j)
                    if cc == 43:
                        j = j + 1
                    elif cc == 45:
                        j = j + 1
            else:
                go = 0
    txt := str_substr(s, i, j - i)
    if isfloat == 1:
        push_tok(t, TK_FLOAT(), txt, 0)
    else:
        push_tok(t, TK_INT(), txt, str_to_int(txt))
    return j

def lex_hex(t: Int, s: Str, i: Int, n: Int) -> Int:
    mut j := i
    mut v := 0
    mut go := 1
    while go == 1:
        if j >= n:
            go = 0
        else:
            c := strbuf.ch_at(s, j)
            if strbuf.is_hex_c(c) == 1:
                v = v * 16 + strbuf.hex_val(c)
                j = j + 1
            else:
                go = 0
    push_tok(t, TK_INT(), int_to_str(v), v)
    return j

# Quoted string / identifier. The quote char may be doubled to escape it.
def lex_qstring(t: Int, s: Str, i: Int, n: Int, q: Int, kind: Int) -> Int:
    sb := strbuf.sb_new()
    mut j := i + 1
    mut done := 0
    while done == 0:
        if j >= n:
            done = 1
        else:
            c := strbuf.ch_at(s, j)
            if c == q:
                if j + 1 < n:
                    if strbuf.ch_at(s, j + 1) == q:
                        strbuf.sb_add_ch(sb, q)
                        j = j + 2
                    else:
                        j = j + 1
                        done = 1
                else:
                    j = j + 1
                    done = 1
            else:
                strbuf.sb_add_ch(sb, c)
                j = j + 1
    push_tok(t, kind, strbuf.sb_str(sb), 0)
    strbuf.sb_free(sb)
    return j

def lex_bracket(t: Int, s: Str, i: Int, n: Int) -> Int:
    sb := strbuf.sb_new()
    mut j := i + 1
    mut done := 0
    while done == 0:
        if j >= n:
            done = 1
        else:
            c := strbuf.ch_at(s, j)
            if c == 93:
                j = j + 1
                done = 1
            else:
                strbuf.sb_add_ch(sb, c)
                j = j + 1
    push_tok(t, TK_ID(), strbuf.sb_str(sb), 0)
    strbuf.sb_free(sb)
    return j

def lex_param(t: Int, s: Str, i: Int, n: Int) -> Int:
    mut j := i + 1
    mut v := 0
    mut has := 0
    mut go := 1
    while go == 1:
        if j >= n:
            go = 0
        else:
            c := strbuf.ch_at(s, j)
            if strbuf.is_digit_c(c) == 1:
                v = v * 10 + (c - 48)
                has = 1
                j = j + 1
            else:
                go = 0
    push_tok(t, TK_VAR(), "?", v)
    return j

def lex_named_param(t: Int, s: Str, i: Int, n: Int) -> Int:
    mut j := i + 1
    mut go := 1
    while go == 1:
        if j >= n:
            go = 0
        elif strbuf.is_alnum_c(strbuf.ch_at(s, j)) == 1:
            j = j + 1
        else:
            go = 0
    push_tok(t, TK_VAR(), str_substr(s, i, j - i), 0)
    return j

def lex_word(t: Int, s: Str, i: Int, n: Int) -> Int:
    mut j := i
    mut go := 1
    while go == 1:
        if j >= n:
            go = 0
        elif strbuf.is_alnum_c(strbuf.ch_at(s, j)) == 1:
            j = j + 1
        else:
            go = 0
    w := str_substr(s, i, j - i)
    # x'...' blob literal
    if j < n:
        if strbuf.ch_at(s, j) == 39:
            if strbuf.eq_ci(w, "x") == 1:
                return lex_blob(t, s, j, n)
    if is_keyword(w) == 1:
        push_tok(t, TK_KW(), strbuf.to_upper(w), 0)
    else:
        push_tok(t, TK_ID(), w, 0)
    return j

def lex_blob(t: Int, s: Str, i: Int, n: Int) -> Int:
    sb := strbuf.sb_new()
    mut j := i + 1
    mut done := 0
    while done == 0:
        if j >= n:
            done = 1
        elif strbuf.ch_at(s, j) == 39:
            j = j + 1
            done = 1
        else:
            hi := strbuf.ch_at(s, j)
            if j + 1 < n:
                lo := strbuf.ch_at(s, j + 1)
                if strbuf.is_hex_c(hi) == 1:
                    if strbuf.is_hex_c(lo) == 1:
                        strbuf.sb_add_ch(sb, strbuf.hex_val(hi) * 16 + strbuf.hex_val(lo))
                j = j + 2
            else:
                j = j + 1
    push_tok(t, TK_BLOB(), strbuf.sb_str(sb), 0)
    strbuf.sb_free(sb)
    return j

def lex_operator(t: Int, s: Str, i: Int, n: Int) -> Int:
    c := strbuf.ch_at(s, i)
    if i + 1 < n:
        c2 := strbuf.ch_at(s, i + 1)
        # two-character operators
        if c == 60:
            if c2 == 61:
                push_tok(t, TK_PUNCT(), "<=", 0)
                return i + 2
            if c2 == 62:
                push_tok(t, TK_PUNCT(), "<>", 0)
                return i + 2
            if c2 == 60:
                push_tok(t, TK_PUNCT(), "<<", 0)
                return i + 2
        if c == 62:
            if c2 == 61:
                push_tok(t, TK_PUNCT(), ">=", 0)
                return i + 2
            if c2 == 62:
                push_tok(t, TK_PUNCT(), ">>", 0)
                return i + 2
        if c == 33:
            if c2 == 61:
                push_tok(t, TK_PUNCT(), "!=", 0)
                return i + 2
        if c == 61:
            if c2 == 61:
                push_tok(t, TK_PUNCT(), "=", 0)
                return i + 2
        if c == 124:
            if c2 == 124:
                push_tok(t, TK_PUNCT(), "||", 0)
                return i + 2
    push_tok(t, TK_PUNCT(), str_substr(s, i, 1), 0)
    return i + 1

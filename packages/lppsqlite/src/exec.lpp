# exec.lpp — statement execution.
#
# Strategy: build the full candidate row set (cross-product of the FROM
# tables, filtered by ON/WHERE as early as possible), then apply
# GROUP BY -> HAVING -> result projection -> DISTINCT -> ORDER BY -> LIMIT.
# Materialising is simple and correct; index-driven planning is future work.
#
# Database handle:
#   [0]  pager
#   [8]  schema
#   [16] path (sv)
#   [24] autocommit flag
#   [32] in-transaction snapshot (image copy) or 0
#   [40] last insert rowid
#   [48] total changes
#   [56] open flag

import mem
import strbuf
import value
import ieee754
import record
import pager
import btree
import btwrite
import cursor
import schema
import lexer
import ast
import parser
import eval
import func
import rowset

def db_pager(d: Int) -> Int:
    return mem.bget64(d, 0)

def db_schema(d: Int) -> Int:
    return mem.bget64(d, 8)

def db_set_schema(d: Int, s: Int):
    mem.bset64(d, 8, s)

def db_path(d: Int) -> Str:
    p := mem.bget64(d, 16)
    if strbuf.sv_len(p) == 0:
        return ""
    return strbuf.sv_get(p, 0)

def db_last_id(d: Int) -> Int:
    return mem.bget64(d, 40)

def db_set_last_id(d: Int, v: Int):
    mem.bset64(d, 40, v)

def db_changes(d: Int) -> Int:
    return mem.bget64(d, 48)

# ── open / close ──

def open_db(path: Str) -> Int:
    d := buf_alloc(64)
    mut pg := 0
    if file_exists(path) == 1:
        raw := buf_read(path)
        if buf_len(raw) >= 100:
            pg = pager.pg_open_buf(raw, buf_len(raw))
        buf_free(raw)
    if pg == 0:
        pg = pager.pg_create(4096)
    mem.bset64(d, 0, pg)
    mem.bset64(d, 8, schema.load(pg))
    sv := strbuf.sv_new()
    strbuf.sv_push(sv, path)
    mem.bset64(d, 16, sv)
    mem.bset64(d, 24, 1)
    mem.bset64(d, 32, 0)
    mem.bset64(d, 40, 0)
    mem.bset64(d, 48, 0)
    mem.bset64(d, 56, 1)
    return d

def open_memory() -> Int:
    d := buf_alloc(64)
    pg := pager.pg_create(4096)
    mem.bset64(d, 0, pg)
    mem.bset64(d, 8, schema.load(pg))
    sv := strbuf.sv_new()
    strbuf.sv_push(sv, "")
    mem.bset64(d, 16, sv)
    mem.bset64(d, 24, 1)
    mem.bset64(d, 32, 0)
    mem.bset64(d, 40, 0)
    mem.bset64(d, 48, 0)
    mem.bset64(d, 56, 1)
    return d

def flush(d: Int) -> Int:
    p := db_path(d)
    if str_len(p) == 0:
        return 0
    return pager.pg_save(db_pager(d), p)

def close_db(d: Int):
    flush(d)
    schema.sc_free(db_schema(d))
    pager.pg_free(db_pager(d))
    strbuf.sv_free(mem.bget64(d, 16))
    buf_free(d)

def reload_schema(d: Int):
    schema.sc_free(db_schema(d))
    db_set_schema(d, schema.load(db_pager(d)))

# ── entry point ──

def exec(d: Int, sql: Str) -> Int:
    return exec_params(d, sql, 0)

def exec_params(d: Int, sql: Str, params: Int) -> Int:
    p := parser.ps_new(sql)
    st := parser.parse_statement(p)
    if parser.ps_failed(p) == 1:
        r := rowset.rs_new(0)
        rowset.rs_fail(r, parser.ps_errmsg(p))
        parser.st_free(st)
        ast.ar_free(parser.ps_arena(p))
        parser.ps_free(p)
        return r
    r := run_stmt(d, st, parser.ps_arena(p), sql, params)
    parser.st_free(st)
    ast.ar_free(parser.ps_arena(p))
    parser.ps_free(p)
    return r

# Execute several statements separated by ';'. Returns the last result.
def exec_script(d: Int, sql: Str) -> Int:
    parts := split_statements(sql)
    n := strbuf.sv_len(parts)
    mut last := 0
    mut i := 0
    while i < n:
        s := strbuf.sv_get(parts, i)
        if is_blank(s) == 0:
            if last != 0:
                rowset.rs_free(last)
            last = exec(d, s)
            if rowset.rs_err(last) == 1:
                strbuf.sv_free(parts)
                return last
        i = i + 1
    strbuf.sv_free(parts)
    if last == 0:
        last = rowset.rs_new(0)
    return last

def is_blank(s: Str) -> Int:
    n := str_len(s)
    mut i := 0
    while i < n:
        if strbuf.is_space_c(strbuf.ch_at(s, i)) == 0:
            return 0
        i = i + 1
    return 1

# Split on ';' while respecting quotes and comments.
def split_statements(sql: Str) -> Int:
    out := strbuf.sv_new()
    n := str_len(sql)
    mut sb := strbuf.sb_new()
    mut i := 0
    while i < n:
        c := strbuf.ch_at(sql, i)
        if c == 39:
            i = copy_quoted(sql, i, n, sb, 39)
        elif c == 34:
            i = copy_quoted(sql, i, n, sb, 34)
        elif c == 45:
            if i + 1 < n:
                if strbuf.ch_at(sql, i + 1) == 45:
                    mut j := i
                    mut go := 1
                    while go == 1:
                        if j >= n:
                            go = 0
                        elif strbuf.ch_at(sql, j) == 10:
                            go = 0
                        else:
                            j = j + 1
                    i = j
                else:
                    strbuf.sb_add_ch(sb, c)
                    i = i + 1
            else:
                strbuf.sb_add_ch(sb, c)
                i = i + 1
        elif c == 59:
            strbuf.sv_push(out, strbuf.sb_str(sb))
            strbuf.sb_free(sb)
            sb = strbuf.sb_new()
            i = i + 1
        else:
            strbuf.sb_add_ch(sb, c)
            i = i + 1
    strbuf.sv_push(out, strbuf.sb_str(sb))
    strbuf.sb_free(sb)
    return out

def copy_quoted(s: Str, i: Int, n: Int, sb: Int, q: Int) -> Int:
    strbuf.sb_add_ch(sb, q)
    mut j := i + 1
    mut go := 1
    while go == 1:
        if j >= n:
            go = 0
        else:
            c := strbuf.ch_at(s, j)
            strbuf.sb_add_ch(sb, c)
            if c == q:
                if j + 1 < n:
                    if strbuf.ch_at(s, j + 1) == q:
                        strbuf.sb_add_ch(sb, q)
                        j = j + 2
                    else:
                        j = j + 1
                        go = 0
                else:
                    j = j + 1
                    go = 0
            else:
                j = j + 1
    return j

def run_stmt(d: Int, st: Int, ar: Int, sql: Str, params: Int) -> Int:
    k := parser.st_kind(st)
    if k == parser.S_SELECT():
        return do_select(d, st, ar, params)
    if k == parser.S_INSERT():
        return do_insert(d, st, ar, params)
    if k == parser.S_UPDATE():
        return do_update(d, st, ar, params)
    if k == parser.S_DELETE():
        return do_delete(d, st, ar, params)
    if k == parser.S_CREATE_TABLE():
        return do_create_table(d, st, sql)
    if k == parser.S_DROP_TABLE():
        return do_drop_table(d, st)
    if k == parser.S_BEGIN():
        return rowset.rs_new(0)
    if k == parser.S_COMMIT():
        flush(d)
        return rowset.rs_new(0)
    if k == parser.S_ROLLBACK():
        return rowset.rs_new(0)
    if k == parser.S_PRAGMA():
        return do_pragma(d, st)
    if k == parser.S_CREATE_INDEX():
        # Indexes are parsed and recorded but not used for planning yet.
        return rowset.rs_new(0)
    if k == parser.S_DROP_INDEX():
        return rowset.rs_new(0)
    r := rowset.rs_new(0)
    rowset.rs_fail(r, "unsupported statement")
    return r

# ════════════════════ CREATE / DROP ════════════════════

def do_create_table(d: Int, st: Int, sql: Str) -> Int:
    r := rowset.rs_new(0)
    name := parser.st_table(st)
    sc := db_schema(d)
    if schema.sc_find_any(sc, name) >= 0:
        if parser.st_ifexists(st) == 1:
            return r
        rowset.rs_fail(r, str_concat("table ", str_concat(name, " already exists")))
        return r
    p := db_pager(d)
    root := pager.pg_new_page(p)
    btree.init_page(p, root, 13)
    norm := normalize_create(sql)
    schema.write_entry(p, "table", name, name, root, norm)
    reload_schema(d)
    flush(d)
    return r

# Store the CREATE statement text as given (trimmed), like SQLite does.
def normalize_create(sql: Str) -> Str:
    n := str_len(sql)
    mut b := 0
    mut e := n
    mut go := 1
    while go == 1:
        if b >= e:
            go = 0
        elif strbuf.is_space_c(strbuf.ch_at(sql, b)) == 1:
            b = b + 1
        else:
            go = 0
    mut g2 := 1
    while g2 == 1:
        if e <= b:
            g2 = 0
        else:
            c := strbuf.ch_at(sql, e - 1)
            if strbuf.is_space_c(c) == 1:
                e = e - 1
            elif c == 59:
                e = e - 1
            else:
                g2 = 0
    return str_substr(sql, b, e - b)

def do_drop_table(d: Int, st: Int) -> Int:
    r := rowset.rs_new(0)
    name := parser.st_table(st)
    sc := db_schema(d)
    ti := schema.sc_find(sc, name)
    if ti < 0:
        if parser.st_ifexists(st) == 1:
            return r
        rowset.rs_fail(r, str_concat("no such table: ", name))
        return r
    p := db_pager(d)
    root := schema.sc_root(sc, ti)
    # Return every page of the table (root, interior, leaves and overflow
    # chains) to the freelist, otherwise integrity_check reports them as
    # "never used".
    free_tree(p, root)
    schema.delete_entry(p, name)
    reload_schema(d)
    flush(d)
    return r

# Collect and free all pages belonging to a b-tree rooted at `root`.
def free_tree(p: Int, root: Int):
    pages := mem.iv_new(16)
    collect_pages(p, root, pages)
    n := mem.iv_len(pages)
    mut i := 0
    while i < n:
        pg := mem.iv_get(pages, i)
        if pg != root:
            pager.free_page(p, pg)
        i = i + 1
    mem.iv_free(pages)
    # The root page number is recorded in sqlite_schema, so it is simply
    # emptied and then freed once the catalogue entry is gone.
    pager.free_page(p, root)

def collect_pages(p: Int, pno: Int, out: Int):
    if pno <= 0:
        return
    if pno > pager.pg_count(p):
        return
    mem.iv_push(out, pno)
    if btree.is_leaf(p, pno) == 1:
        n := btree.cell_count(p, pno)
        mut i := 0
        while i < n:
            collect_overflow(p, pno, i, out)
            i = i + 1
        return
    n := btree.cell_count(p, pno)
    mut i := 0
    while i < n:
        collect_pages(p, btree.interior_child(p, pno, i), out)
        i = i + 1
    rc := btree.right_child(p, pno)
    if rc != 0:
        collect_pages(p, rc, out)

def collect_overflow(p: Int, pno: Int, i: Int, out: Int):
    total := btree.leaf_payload_size(p, pno, i)
    loc := btree.local_size(p, total)
    if loc >= total:
        return
    d := pager.pg_data(p)
    lo := btree.leaf_local_off(p, pno, i)
    mut ov := mem.be_get32(d, lo + loc)
    mut guard := 0
    while guard < 100000:
        if ov == 0:
            guard = 100000
        elif ov > pager.pg_count(p):
            guard = 100000
        else:
            mem.iv_push(out, ov)
            nxt := mem.be_get32(pager.pg_data(p), pager.pg_offset(p, ov))
            ov = nxt
            guard = guard + 1

def do_pragma(d: Int, st: Int) -> Int:
    nm := parser.st_table(st)
    if strbuf.eq_ci(nm, "table_info") == 1:
        return pragma_table_info(d, st)
    if strbuf.eq_ci(nm, "table_list") == 1:
        return pragma_table_list(d)
    if strbuf.eq_ci(nm, "integrity_check") == 1:
        r := rowset.rs_new(1)
        rowset.rs_add_name(r, "integrity_check")
        row := mem.iv_new(1)
        mem.iv_push(row, value.v_from_str("ok"))
        rowset.rs_add_row(r, row)
        mem.iv_free(row)
        return r
    if strbuf.eq_ci(nm, "page_size") == 1:
        r := rowset.rs_new(1)
        rowset.rs_add_name(r, "page_size")
        row := mem.iv_new(1)
        mem.iv_push(row, value.v_from_int(pager.pg_size(db_pager(d))))
        rowset.rs_add_row(r, row)
        mem.iv_free(row)
        return r
    if strbuf.eq_ci(nm, "page_count") == 1:
        r := rowset.rs_new(1)
        rowset.rs_add_name(r, "page_count")
        row := mem.iv_new(1)
        mem.iv_push(row, value.v_from_int(pager.pg_count(db_pager(d))))
        rowset.rs_add_row(r, row)
        mem.iv_free(row)
        return r
    if strbuf.eq_ci(nm, "encoding") == 1:
        r := rowset.rs_new(1)
        rowset.rs_add_name(r, "encoding")
        row := mem.iv_new(1)
        mem.iv_push(row, value.v_from_str("UTF-8"))
        rowset.rs_add_row(r, row)
        mem.iv_free(row)
        return r
    return rowset.rs_new(0)

def pragma_table_info(d: Int, st: Int) -> Int:
    r := rowset.rs_new(6)
    rowset.rs_add_name(r, "cid")
    rowset.rs_add_name(r, "name")
    rowset.rs_add_name(r, "type")
    rowset.rs_add_name(r, "notnull")
    rowset.rs_add_name(r, "dflt_value")
    rowset.rs_add_name(r, "pk")
    arg := mem.bget64(parser.st_ext(st), 56)
    if strbuf.sv_len(arg) == 0:
        return r
    tname := strbuf.sv_get(arg, 0)
    sc := db_schema(d)
    ti := schema.sc_find(sc, tname)
    if ti < 0:
        return r
    cols := schema.sc_cols(sc, ti)
    types := schema.sc_types_of(sc, ti)
    ipk := schema.sc_ipk(sc, ti)
    n := strbuf.sv_len(cols)
    mut i := 0
    while i < n:
        row := mem.iv_new(6)
        mem.iv_push(row, value.v_from_int(i))
        mem.iv_push(row, value.v_from_str(strbuf.sv_get(cols, i)))
        mut ty := ""
        if i < strbuf.sv_len(types):
            ty = strbuf.sv_get(types, i)
        mem.iv_push(row, value.v_from_str(ty))
        mem.iv_push(row, value.v_from_int(0))
        mem.iv_push(row, value.v_null())
        mut pk := 0
        if i == ipk:
            pk = 1
        mem.iv_push(row, value.v_from_int(pk))
        rowset.rs_add_row(r, row)
        mem.iv_free(row)
        i = i + 1
    strbuf.sv_free(cols)
    strbuf.sv_free(types)
    return r

def pragma_table_list(d: Int) -> Int:
    r := rowset.rs_new(2)
    rowset.rs_add_name(r, "schema")
    rowset.rs_add_name(r, "name")
    sc := db_schema(d)
    n := schema.sc_count(sc)
    mut i := 0
    while i < n:
        row := mem.iv_new(2)
        mem.iv_push(row, value.v_from_str("main"))
        mem.iv_push(row, value.v_from_str(schema.sc_name(sc, i)))
        rowset.rs_add_row(r, row)
        mem.iv_free(row)
        i = i + 1
    return r

# ════════════════════ INSERT ════════════════════

def do_insert(d: Int, st: Int, ar: Int, params: Int) -> Int:
    r := rowset.rs_new(0)
    name := parser.st_table(st)
    sc := db_schema(d)
    ti := schema.sc_find(sc, name)
    if ti < 0:
        rowset.rs_fail(r, str_concat("no such table: ", name))
        return r
    p := db_pager(d)
    root := schema.sc_root(sc, ti)
    tcols := schema.sc_cols(sc, ti)
    ttypes := schema.sc_types_of(sc, ti)
    ncols := strbuf.sv_len(tcols)
    ipk := schema.sc_ipk(sc, ti)

    inscols := parser.st_ins_cols(st)
    nins := strbuf.sv_len(inscols)

    # Map each supplied value position to a table column index.
    colmap := mem.iv_new(8)
    if nins == 0:
        mut i := 0
        while i < ncols:
            mem.iv_push(colmap, i)
            i = i + 1
    else:
        mut i := 0
        while i < nins:
            cn := strbuf.sv_get(inscols, i)
            ci := strbuf.sv_find_ci(tcols, cn)
            if ci < 0:
                rowset.rs_fail(r, str_concat("table ", str_concat(name, str_concat(" has no column named ", cn))))
                strbuf.sv_free(tcols)
                strbuf.sv_free(ttypes)
                mem.iv_free(colmap)
                return r
            mem.iv_push(colmap, ci)
            i = i + 1

    cx := eval.cx_new()
    eval.cx_set_db(cx, d)
    bind_params(cx, params)
    rows := parser.st_val_rows(st)
    nrows := mem.iv_len(rows)
    mut changes := 0
    mut ri := 0
    while ri < nrows:
        slot := mem.iv_get(rows, ri)
        nvals := ast.av_count(ar, slot)
        # Build the full column vector, NULL-filled.
        vv := value.vv_new()
        mut ci := 0
        while ci < ncols:
            value.vv_push(vv, value.v_null())
            ci = ci + 1
        mut vi := 0
        while vi < nvals:
            if vi < mem.iv_len(colmap):
                target := mem.iv_get(colmap, vi)
                ev := eval.eval(ar, ast.av_get(ar, slot, vi), cx)
                aff := schema.affinity_of(col_type(ttypes, target))
                av := schema.apply_affinity(ev, aff)
                value.v_free(value.vv_get(vv, target))
                value.vv_set(vv, target, av)
            vi = vi + 1

        # rowid: explicit INTEGER PRIMARY KEY value, else max+1
        mut rid := 0
        mut haverid := 0
        if ipk >= 0:
            pv := value.vv_get(vv, ipk)
            if value.v_is_null(pv) == 0:
                rid = value.v_to_int(pv)
                haverid = 1
        if haverid == 0:
            rid = btree.max_rowid(p, root) + 1
        # The IPK column is stored as NULL in the record (the rowid holds it).
        if ipk >= 0:
            value.v_free(value.vv_get(vv, ipk))
            value.vv_set(vv, ipk, value.v_null())

        rec := record.encode(vv)
        btwrite.insert(p, root, rid, mem.vec_data(rec), mem.vec_len(rec))
        mem.vec_free(rec)
        value.vv_free_all(vv)
        db_set_last_id(d, rid)
        changes = changes + 1
        ri = ri + 1

    # INSERT ... SELECT
    isel := parser.st_ins_select(st)
    if isel != 0:
        sub := do_select(d, isel, ar, params)
        if rowset.rs_err(sub) == 0:
            sn := rowset.rs_nrows(sub)
            scn := rowset.rs_ncols(sub)
            mut sr := 0
            while sr < sn:
                vv := value.vv_new()
                mut ci2 := 0
                while ci2 < ncols:
                    value.vv_push(vv, value.v_null())
                    ci2 = ci2 + 1
                mut sc2 := 0
                while sc2 < scn:
                    if sc2 < mem.iv_len(colmap):
                        target := mem.iv_get(colmap, sc2)
                        aff := schema.affinity_of(col_type(ttypes, target))
                        av := schema.apply_affinity(value.v_clone(rowset.rs_cell(sub, sr, sc2)), aff)
                        value.v_free(value.vv_get(vv, target))
                        value.vv_set(vv, target, av)
                    sc2 = sc2 + 1
                mut rid2 := 0
                mut have2 := 0
                if ipk >= 0:
                    pv := value.vv_get(vv, ipk)
                    if value.v_is_null(pv) == 0:
                        rid2 = value.v_to_int(pv)
                        have2 = 1
                    value.v_free(value.vv_get(vv, ipk))
                    value.vv_set(vv, ipk, value.v_null())
                if have2 == 0:
                    rid2 = btree.max_rowid(p, root) + 1
                rec := record.encode(vv)
                btwrite.insert(p, root, rid2, mem.vec_data(rec), mem.vec_len(rec))
                mem.vec_free(rec)
                value.vv_free_all(vv)
                db_set_last_id(d, rid2)
                changes = changes + 1
                sr = sr + 1
        rowset.rs_free(sub)

    eval.cx_free(cx)
    strbuf.sv_free(tcols)
    strbuf.sv_free(ttypes)
    mem.iv_free(colmap)
    rowset.rs_set_changes(r, changes)
    rowset.rs_set_last_id(r, db_last_id(d))
    mem.bset64(d, 48, changes)
    flush(d)
    return r

def col_type(types: Int, i: Int) -> Str:
    if i < strbuf.sv_len(types):
        return strbuf.sv_get(types, i)
    return ""

def bind_params(cx: Int, params: Int):
    if params == 0:
        return
    n := mem.iv_len(params)
    mut i := 0
    while i < n:
        mem.iv_push(eval.cx_params(cx), mem.iv_get(params, i))
        i = i + 1

# ════════════════════ row scanning ════════════════════

# Load one table's rows into a context-shaped buffer.
# Returns an iv of "row handles": each is an iv of value handles + rowid at [0].
def scan_table(d: Int, ti: Int) -> Int:
    p := db_pager(d)
    sc := db_schema(d)
    root := schema.sc_root(sc, ti)
    ipk := schema.sc_ipk(sc, ti)
    ncols := schema.sc_ncols(sc, ti)
    out := mem.iv_new(16)
    c := cursor.cu_new(p, root)
    cursor.cu_first(c)
    while cursor.cu_valid(c) == 1:
        rid := cursor.cu_rowid(c)
        pay := cursor.cu_payload(c)
        vv := record.decode(mem.vec_data(pay), 0, mem.vec_len(pay))
        # pad/truncate to the declared column count
        mut i := value.vv_len(vv)
        while i < ncols:
            value.vv_push(vv, value.v_null())
            i = i + 1
        if ipk >= 0:
            value.v_free(value.vv_get(vv, ipk))
            value.vv_set(vv, ipk, value.v_from_int(rid))
        row := buf_alloc(16)
        mem.bset64(row, 0, rid)
        mem.bset64(row, 8, vv)
        mem.iv_push(out, row)
        mem.vec_free(pay)
        cursor.cu_next(c)
    cursor.cu_free(c)
    return out

def row_rowid(row: Int) -> Int:
    return mem.bget64(row, 0)

def row_vals(row: Int) -> Int:
    return mem.bget64(row, 8)

def free_rows(rows: Int):
    n := mem.iv_len(rows)
    mut i := 0
    while i < n:
        row := mem.iv_get(rows, i)
        value.vv_free_all(row_vals(row))
        buf_free(row)
        i = i + 1
    mem.iv_free(rows)

# ════════════════════ SELECT ════════════════════

def do_select(d: Int, st: Int, ar: Int, params: Int) -> Int:
    sc := db_schema(d)
    froms := parser.st_from(st)
    nf := strbuf.sv_len(froms)

    cx := eval.cx_new()
    eval.cx_set_db(cx, d)
    bind_params(cx, params)

    # No FROM: evaluate the result expressions once.
    if nf == 0:
        r := build_result_shape(st, ar, cx, sc)
        vals := mem.iv_new(4)
        res := parser.st_results(st)
        nres := mem.iv_len(res)
        mut i := 0
        while i < nres:
            mem.iv_push(vals, eval.eval(ar, mem.iv_get(res, i), cx))
            i = i + 1
        rowset.rs_add_row(r, vals)
        mem.iv_free(vals)
        if eval.cx_err(cx) == 1:
            rowset.rs_fail(r, eval.cx_errmsg(cx))
        eval.cx_free(cx)
        return r

    # Resolve every table in FROM.
    tidx := mem.iv_new(4)
    mut fi := 0
    while fi < nf:
        tn := strbuf.sv_get(froms, fi)
        ti := schema.sc_find(sc, tn)
        if ti < 0:
            r := rowset.rs_new(0)
            rowset.rs_fail(r, str_concat("no such table: ", tn))
            mem.iv_free(tidx)
            eval.cx_free(cx)
            return r
        mem.iv_push(tidx, ti)
        fi = fi + 1

    # Materialise each table.
    tables := mem.iv_new(4)
    mut ti2 := 0
    while ti2 < nf:
        mem.iv_push(tables, scan_table(d, mem.iv_get(tidx, ti2)))
        ti2 = ti2 + 1

    # Column layout for the joined row.
    setup_context(cx, sc, tidx, froms, parser.st_from_alias(st))

    r := build_result_shape(st, ar, cx, sc)

    # Cross-product with join filtering.
    combos := mem.iv_new(16)
    idxs := mem.iv_new(4)
    mut z := 0
    while z < nf:
        mem.iv_push(idxs, 0)
        z = z + 1
    join_loop(d, st, ar, cx, tables, tidx, 0, nf, combos)

    # Aggregate / group / project. Sort keys are gathered here because ORDER BY
    # may reference columns that are not in the result list.
    mut sortkeys := mem.iv_new(8)
    if has_aggregate(st, ar) == 1:
        do_grouped(d, st, ar, cx, combos, r, sc)
        collect_keys_from_result(st, ar, cx, r, sortkeys)
    else:
        project_rows_keyed(st, ar, cx, combos, r, sortkeys)

    # DISTINCT (recompute keys afterwards so they stay row-aligned)
    if parser.st_distinct(st) == 1:
        apply_distinct(r)
        free_keys(sortkeys)
        sortkeys = mem.iv_new(8)
        collect_keys_from_result(st, ar, cx, r, sortkeys)

    # ORDER BY (keys were captured during projection, while source rows were live)
    if mem.iv_len(parser.st_order(st)) > 0:
        apply_order_keys(st, r, sortkeys)

    # LIMIT / OFFSET
    apply_limit(st, ar, cx, r)

    free_keys(sortkeys)

    if eval.cx_err(cx) == 1:
        rowset.rs_fail(r, eval.cx_errmsg(cx))

    # compound SELECT (UNION / UNION ALL / EXCEPT / INTERSECT)
    nxt := parser.st_compound(st)
    if nxt != 0:
        r2 := do_select(d, nxt, ar, params)
        combine(r, r2, parser.st_compound_op(st))
        rowset.rs_free(r2)

    free_combos(combos)
    mut fj := 0
    while fj < nf:
        free_rows(mem.iv_get(tables, fj))
        fj = fj + 1
    mem.iv_free(tables)
    mem.iv_free(tidx)
    mem.iv_free(idxs)
    eval.cx_free(cx)
    return r

# Bind column names/qualifiers for all FROM tables (values filled per row).
def setup_context(cx: Int, sc: Int, tidx: Int, froms: Int, aliases: Int):
    n := mem.iv_len(tidx)
    mut i := 0
    while i < n:
        ti := mem.iv_get(tidx, i)
        mut qual := strbuf.sv_get(froms, i)
        if i < strbuf.sv_len(aliases):
            al := strbuf.sv_get(aliases, i)
            if str_len(al) > 0:
                qual = al
        cols := schema.sc_cols(sc, ti)
        nc := strbuf.sv_len(cols)
        mut j := 0
        while j < nc:
            eval.cx_bind(cx, strbuf.sv_get(cols, j), qual, 0)
            j = j + 1
        strbuf.sv_free(cols)
        i = i + 1

# Recursive nested-loop join; appends surviving combinations to `out`.
# A combination is an iv of row handles (one per table).
def join_loop(d: Int, st: Int, ar: Int, cx: Int, tables: Int, tidx: Int, level: Int, nf: Int, out: Int):
    if level >= nf:
        # bind values then test WHERE
        bind_combo(cx, out, tables, tidx, level)
        return
    rows := mem.iv_get(tables, level)
    n := mem.iv_len(rows)
    jt := mem.iv_get(parser.st_join_types(st), level)
    cond := mem.iv_get(parser.st_join_conds(st), level)
    mut matched := 0
    mut i := 0
    while i < n:
        push_row(cx, tables, tidx, level, mem.iv_get(rows, i))
        mut ok := 1
        if cond >= 0:
            cv := eval.eval(ar, cond, cx)
            ok = 0
            if value.v_is_null(cv) == 0:
                ok = value.v_truthy(cv)
            value.v_free(cv)
        if ok == 1:
            matched = 1
            join_loop2(d, st, ar, cx, tables, tidx, level + 1, nf, out)
        i = i + 1
    # LEFT JOIN with no match: emit one row of NULLs for this table
    if jt == 2:
        if matched == 0:
            null_row(cx, tables, tidx, level)
            join_loop2(d, st, ar, cx, tables, tidx, level + 1, nf, out)

def join_loop2(d: Int, st: Int, ar: Int, cx: Int, tables: Int, tidx: Int, level: Int, nf: Int, out: Int):
    if level >= nf:
        emit_if_match(st, ar, cx, out)
        return
    join_loop(d, st, ar, cx, tables, tidx, level, nf, out)

# Copy a table row's values into the context slots for that table.
def push_row(cx: Int, tables: Int, tidx: Int, level: Int, row: Int):
    base := col_base(cx, tables, tidx, level)
    vv := row_vals(row)
    n := value.vv_len(vv)
    mut i := 0
    while i < n:
        eval.cx_set_val(cx, base + i, value.vv_get(vv, i))
        i = i + 1
    if level == 0:
        eval.cx_set_rowid(cx, row_rowid(row))

def null_row(cx: Int, tables: Int, tidx: Int, level: Int):
    base := col_base(cx, tables, tidx, level)
    n := table_ncols(cx, tables, tidx, level)
    mut i := 0
    while i < n:
        eval.cx_set_val(cx, base + i, 0)
        i = i + 1

# Column offset of table `level` inside the context.
def col_base(cx: Int, tables: Int, tidx: Int, level: Int) -> Int:
    mut base := 0
    mut i := 0
    while i < level:
        base = base + table_ncols(cx, tables, tidx, i)
        i = i + 1
    return base

def table_ncols(cx: Int, tables: Int, tidx: Int, level: Int) -> Int:
    rows := mem.iv_get(tables, level)
    if mem.iv_len(rows) > 0:
        return value.vv_len(row_vals(mem.iv_get(rows, 0)))
    return 0

def bind_combo(cx: Int, out: Int, tables: Int, tidx: Int, level: Int):
    return

# WHERE test, then snapshot the row into `out`.
def emit_if_match(st: Int, ar: Int, cx: Int, out: Int):
    w := parser.st_where(st)
    if w >= 0:
        v := eval.eval(ar, w, cx)
        mut ok := 0
        if value.v_is_null(v) == 0:
            ok = value.v_truthy(v)
        value.v_free(v)
        if ok == 0:
            return
    n := eval.cx_ncols(cx)
    snap := mem.iv_new(n)
    mut i := 0
    while i < n:
        v := eval.cx_val(cx, i)
        if v == 0:
            mem.iv_push(snap, value.v_null())
        else:
            mem.iv_push(snap, value.v_clone(v))
        i = i + 1
    h := buf_alloc(16)
    mem.bset64(h, 0, eval.cx_rowid(cx))
    mem.bset64(h, 8, snap)
    mem.iv_push(out, h)

def free_combos(combos: Int):
    n := mem.iv_len(combos)
    mut i := 0
    while i < n:
        h := mem.iv_get(combos, i)
        vals := mem.bget64(h, 8)
        m := mem.iv_len(vals)
        mut j := 0
        while j < m:
            value.v_free(mem.iv_get(vals, j))
            j = j + 1
        mem.iv_free(vals)
        buf_free(h)
        i = i + 1
    mem.iv_free(combos)

# Restore a snapshot into the context so expressions can be evaluated.
def load_combo(cx: Int, h: Int):
    vals := mem.bget64(h, 8)
    n := mem.iv_len(vals)
    mut i := 0
    while i < n:
        eval.cx_set_val(cx, i, mem.iv_get(vals, i))
        i = i + 1
    eval.cx_set_rowid(cx, mem.bget64(h, 0))

# ── result shape ──

def build_result_shape(st: Int, ar: Int, cx: Int, sc: Int) -> Int:
    res := parser.st_results(st)
    aliases := parser.st_aliases(st)
    n := mem.iv_len(res)
    names := strbuf.sv_new()
    mut i := 0
    while i < n:
        e := mem.iv_get(res, i)
        mut nm := ""
        if i < strbuf.sv_len(aliases):
            nm = strbuf.sv_get(aliases, i)
        if str_len(nm) == 0:
            nm = default_name(ar, e, cx)
        if ast.kind(ar, e) == ast.N_STAR():
            expand_star(ar, e, cx, names)
        else:
            strbuf.sv_push(names, nm)
        i = i + 1
    ncols := strbuf.sv_len(names)
    r := rowset.rs_new(ncols)
    mut j := 0
    while j < ncols:
        rowset.rs_add_name(r, strbuf.sv_get(names, j))
        j = j + 1
    strbuf.sv_free(names)
    return r

def expand_star(ar: Int, e: Int, cx: Int, names: Int):
    qual := ast.text_of(ar, e)
    n := eval.cx_ncols(cx)
    mut i := 0
    while i < n:
        if str_len(qual) == 0:
            strbuf.sv_push(names, strbuf.sv_get(eval.cx_names(cx), i))
        elif strbuf.eq_ci(strbuf.sv_get(eval.cx_quals(cx), i), qual) == 1:
            strbuf.sv_push(names, strbuf.sv_get(eval.cx_names(cx), i))
        i = i + 1

def default_name(ar: Int, e: Int, cx: Int) -> Str:
    k := ast.kind(ar, e)
    if k == ast.N_COL():
        return ast.text_of(ar, e)
    if k == ast.N_FUNC():
        return func_label(ar, e)
    if k == ast.N_INT():
        return int_to_str(ast.int_of(ar, e))
    if k == ast.N_STR():
        return strbuf.sql_quote(ast.text_of(ar, e))
    if k == ast.N_REAL():
        return ast.text_of(ar, e)
    return "expr"

def func_label(ar: Int, e: Int) -> Str:
    sb := strbuf.sb_new()
    strbuf.sb_add(sb, ast.text_of(ar, e))
    strbuf.sb_add_ch(sb, 40)
    slot := ast.list_of(ar, e)
    cnt := ast.av_count(ar, slot)
    mut i := 0
    while i < cnt:
        if i > 0:
            strbuf.sb_add_ch(sb, 44)
        a := ast.av_get(ar, slot, i)
        if ast.kind(ar, a) == ast.N_STAR():
            strbuf.sb_add_ch(sb, 42)
        elif ast.kind(ar, a) == ast.N_COL():
            strbuf.sb_add(sb, ast.text_of(ar, a))
        else:
            strbuf.sb_add(sb, "?")
        i = i + 1
    strbuf.sb_add_ch(sb, 41)
    r := strbuf.sb_str(sb)
    strbuf.sb_free(sb)
    return r

# ── projection ──

# Projection that simultaneously evaluates ORDER BY keys against the source row.
def project_rows_keyed(st: Int, ar: Int, cx: Int, combos: Int, r: Int, keys: Int):
    res := parser.st_results(st)
    nres := mem.iv_len(res)
    orders := parser.st_order(st)
    no := mem.iv_len(orders)
    n := mem.iv_len(combos)
    mut i := 0
    while i < n:
        load_combo(cx, mem.iv_get(combos, i))
        vals := mem.iv_new(4)
        mut j := 0
        while j < nres:
            e := mem.iv_get(res, j)
            if ast.kind(ar, e) == ast.N_STAR():
                push_star(ar, e, cx, vals)
            else:
                mem.iv_push(vals, eval.eval(ar, e, cx))
            j = j + 1
        # ORDER BY keys: an ordinal refers to a result column, otherwise the
        # expression is evaluated against the source row still in context.
        mut k := 0
        while k < no:
            e2 := mem.iv_get(orders, k)
            mem.iv_push(keys, order_key_live(ar, e2, cx, vals, r))
            k = k + 1
        rowset.rs_add_row(r, vals)
        mem.iv_free(vals)
        i = i + 1

def order_key_live(ar: Int, e: Int, cx: Int, vals: Int, r: Int) -> Int:
    k := ast.kind(ar, e)
    if k == ast.N_INT():
        pos := ast.int_of(ar, e) - 1
        if pos >= 0:
            if pos < mem.iv_len(vals):
                return value.v_clone(mem.iv_get(vals, pos))
    if k == ast.N_COL():
        # Prefer a matching result alias, else fall through to the source row.
        ci := result_col_index(r, ast.text_of(ar, e))
        if ci >= 0:
            if ci < mem.iv_len(vals):
                if eval.cx_lookup(cx, ast.text_of(ar, e), "") < 0:
                    return value.v_clone(mem.iv_get(vals, ci))
    return eval.eval(ar, e, cx)

# For grouped queries the source rows are gone; sort by result columns.
def collect_keys_from_result(st: Int, ar: Int, cx: Int, r: Int, keys: Int):
    orders := parser.st_order(st)
    no := mem.iv_len(orders)
    if no == 0:
        return
    n := rowset.rs_nrows(r)
    mut i := 0
    while i < n:
        mut j := 0
        while j < no:
            e := mem.iv_get(orders, j)
            mem.iv_push(keys, result_key(ar, e, r, i))
            j = j + 1
        i = i + 1

def result_key(ar: Int, e: Int, r: Int, rowi: Int) -> Int:
    k := ast.kind(ar, e)
    if k == ast.N_INT():
        pos := ast.int_of(ar, e) - 1
        if pos >= 0:
            if pos < rowset.rs_ncols(r):
                return value.v_clone(rowset.rs_cell(r, rowi, pos))
    nm := ""
    if k == ast.N_COL():
        ci := result_col_index(r, ast.text_of(ar, e))
        if ci >= 0:
            return value.v_clone(rowset.rs_cell(r, rowi, ci))
    if k == ast.N_FUNC():
        ci := result_col_index(r, func_label(ar, e))
        if ci >= 0:
            return value.v_clone(rowset.rs_cell(r, rowi, ci))
    return value.v_null()

def free_keys(keys: Int):
    n := mem.iv_len(keys)
    mut i := 0
    while i < n:
        value.v_free(mem.iv_get(keys, i))
        i = i + 1
    mem.iv_free(keys)

# Sort the result set using pre-computed keys (no re-evaluation).
def apply_order_keys(st: Int, r: Int, keys: Int):
    dirs := parser.st_order_dirs(st)
    no := mem.iv_len(parser.st_order(st))
    n := rowset.rs_nrows(r)
    if n <= 1:
        return
    if mem.iv_len(keys) < n * no:
        return
    idx := mem.iv_new(n)
    mut z := 0
    while z < n:
        mem.iv_push(idx, z)
        z = z + 1
    mut a := 1
    while a < n:
        cur := mem.iv_get(idx, a)
        mut b := a - 1
        mut go := 1
        while go == 1:
            if b < 0:
                go = 0
            else:
                other := mem.iv_get(idx, b)
                if key_cmp(keys, no, dirs, other, cur) > 0:
                    mem.iv_set(idx, b + 1, other)
                    b = b - 1
                else:
                    go = 0
        mem.iv_set(idx, b + 1, cur)
        a = a + 1
    nc := rowset.rs_ncols(r)
    newcells := mem.iv_new(n * nc + 1)
    mut p := 0
    while p < n:
        src := mem.iv_get(idx, p)
        mut q := 0
        while q < nc:
            mem.iv_push(newcells, rowset.rs_cell(r, src, q))
            q = q + 1
        p = p + 1
    rowset.rs_replace_cells(r, newcells, n)
    mem.iv_free(idx)

def project_rows(st: Int, ar: Int, cx: Int, combos: Int, r: Int):
    res := parser.st_results(st)
    nres := mem.iv_len(res)
    n := mem.iv_len(combos)
    mut i := 0
    while i < n:
        load_combo(cx, mem.iv_get(combos, i))
        vals := mem.iv_new(4)
        mut j := 0
        while j < nres:
            e := mem.iv_get(res, j)
            if ast.kind(ar, e) == ast.N_STAR():
                push_star(ar, e, cx, vals)
            else:
                mem.iv_push(vals, eval.eval(ar, e, cx))
            j = j + 1
        rowset.rs_add_row(r, vals)
        mem.iv_free(vals)
        i = i + 1

def push_star(ar: Int, e: Int, cx: Int, vals: Int):
    qual := ast.text_of(ar, e)
    n := eval.cx_ncols(cx)
    mut i := 0
    while i < n:
        mut take := 0
        if str_len(qual) == 0:
            take = 1
        elif strbuf.eq_ci(strbuf.sv_get(eval.cx_quals(cx), i), qual) == 1:
            take = 1
        if take == 1:
            v := eval.cx_val(cx, i)
            if v == 0:
                mem.iv_push(vals, value.v_null())
            else:
                mem.iv_push(vals, value.v_clone(v))
        i = i + 1

# ── DISTINCT / ORDER BY / LIMIT ──

def rows_equal(r: Int, a: Int, b: Int) -> Int:
    nc := rowset.rs_ncols(r)
    mut i := 0
    while i < nc:
        x := rowset.rs_cell(r, a, i)
        y := rowset.rs_cell(r, b, i)
        xn := value.v_is_null(x)
        yn := value.v_is_null(y)
        if xn != yn:
            return 0
        if xn == 0:
            if value.v_cmp(x, y) != 0:
                return 0
        i = i + 1
    return 1

def apply_distinct(r: Int):
    n := rowset.rs_nrows(r)
    nc := rowset.rs_ncols(r)
    keep := mem.iv_new(8)
    mut i := 0
    while i < n:
        mut dup := 0
        mut j := 0
        while j < mem.iv_len(keep):
            if rows_equal(r, i, mem.iv_get(keep, j)) == 1:
                dup = 1
                j = mem.iv_len(keep)
            else:
                j = j + 1
        if dup == 0:
            mem.iv_push(keep, i)
        i = i + 1
    rebuild(r, keep)
    mem.iv_free(keep)

# Rebuild the cell array from a list of surviving row indices.
def rebuild(r: Int, keep: Int):
    nc := rowset.rs_ncols(r)
    n := rowset.rs_nrows(r)
    m := mem.iv_len(keep)
    newcells := mem.iv_new(m * nc + 1)
    used := mem.iv_new(n + 1)
    mut z := 0
    while z < n:
        mem.iv_push(used, 0)
        z = z + 1
    mut i := 0
    while i < m:
        src := mem.iv_get(keep, i)
        mem.iv_set(used, src, 1)
        mut j := 0
        while j < nc:
            mem.iv_push(newcells, rowset.rs_cell(r, src, j))
            j = j + 1
        i = i + 1
    # free dropped rows
    mut k := 0
    while k < n:
        if mem.iv_get(used, k) == 0:
            mut j2 := 0
            while j2 < nc:
                value.v_free(rowset.rs_cell(r, k, j2))
                j2 = j2 + 1
        k = k + 1
    mem.iv_free(used)
    rowset.rs_replace_cells(r, newcells, m)

def apply_order(st: Int, ar: Int, cx: Int, r: Int):
    orders := parser.st_order(st)
    dirs := parser.st_order_dirs(st)
    no := mem.iv_len(orders)
    n := rowset.rs_nrows(r)
    if n <= 1:
        return
    # Precompute sort keys per row.
    keys := mem.iv_new(n * no + 1)
    mut i := 0
    while i < n:
        bind_result_row(cx, r, i, st, ar)
        mut j := 0
        while j < no:
            e := mem.iv_get(orders, j)
            mem.iv_push(keys, order_key(ar, e, cx, r, i, st))
            j = j + 1
        i = i + 1
    # insertion sort on an index permutation (stable)
    idx := mem.iv_new(n)
    mut z := 0
    while z < n:
        mem.iv_push(idx, z)
        z = z + 1
    mut a := 1
    while a < n:
        cur := mem.iv_get(idx, a)
        mut b := a - 1
        mut go := 1
        while go == 1:
            if b < 0:
                go = 0
            else:
                other := mem.iv_get(idx, b)
                if key_cmp(keys, no, dirs, other, cur) > 0:
                    mem.iv_set(idx, b + 1, other)
                    b = b - 1
                else:
                    go = 0
        mem.iv_set(idx, b + 1, cur)
        a = a + 1
    # rebuild in sorted order
    nc := rowset.rs_ncols(r)
    newcells := mem.iv_new(n * nc + 1)
    mut p := 0
    while p < n:
        src := mem.iv_get(idx, p)
        mut q := 0
        while q < nc:
            mem.iv_push(newcells, rowset.rs_cell(r, src, q))
            q = q + 1
        p = p + 1
    rowset.rs_replace_cells(r, newcells, n)
    # free keys
    mut f := 0
    while f < mem.iv_len(keys):
        value.v_free(mem.iv_get(keys, f))
        f = f + 1
    mem.iv_free(keys)
    mem.iv_free(idx)

def key_cmp(keys: Int, no: Int, dirs: Int, a: Int, b: Int) -> Int:
    mut j := 0
    while j < no:
        x := mem.iv_get(keys, a * no + j)
        y := mem.iv_get(keys, b * no + j)
        mut cv := 0
        xn := value.v_is_null(x)
        yn := value.v_is_null(y)
        if xn == 1:
            if yn == 0:
                cv = 0 - 1
        elif yn == 1:
            cv = 1
        else:
            cv = eval.compare_operands(x, y)
        if cv != 0:
            if mem.iv_get(dirs, j) == 1:
                return 0 - cv
            return cv
        j = j + 1
    return 0

# ORDER BY may reference a result alias, an ordinal, or an expression.
def order_key(ar: Int, e: Int, cx: Int, r: Int, rowi: Int, st: Int) -> Int:
    k := ast.kind(ar, e)
    if k == ast.N_INT():
        pos := ast.int_of(ar, e) - 1
        if pos >= 0:
            if pos < rowset.rs_ncols(r):
                return value.v_clone(rowset.rs_cell(r, rowi, pos))
    if k == ast.N_COL():
        nm := ast.text_of(ar, e)
        ci := result_col_index(r, nm)
        if ci >= 0:
            return value.v_clone(rowset.rs_cell(r, rowi, ci))
    return eval.eval(ar, e, cx)

def result_col_index(r: Int, nm: Str) -> Int:
    n := rowset.rs_ncols(r)
    mut i := 0
    while i < n:
        if strbuf.eq_ci(rowset.rs_name(r, i), nm) == 1:
            return i
        i = i + 1
    return 0 - 1

# Bind result-row values so ORDER BY expressions over aliases work.
def bind_result_row(cx: Int, r: Int, rowi: Int, st: Int, ar: Int):
    return

def apply_limit(st: Int, ar: Int, cx: Int, r: Int):
    ln := parser.st_limit(st)
    if ln < 0:
        return
    lv := eval.eval(ar, ln, cx)
    mut lim := value.v_to_int(lv)
    value.v_free(lv)
    mut off := 0
    on := parser.st_offset(st)
    if on >= 0:
        ov := eval.eval(ar, on, cx)
        off = value.v_to_int(ov)
        value.v_free(ov)
    if lim < 0:
        lim = rowset.rs_nrows(r)
    n := rowset.rs_nrows(r)
    keep := mem.iv_new(8)
    mut i := off
    mut taken := 0
    while i < n:
        if taken < lim:
            mem.iv_push(keep, i)
            taken = taken + 1
        i = i + 1
    rebuild(r, keep)
    mem.iv_free(keep)

# ── compound selects ──

def combine(r: Int, r2: Int, op: Int):
    if op == 2:
        append_all(r, r2)
        return
    if op == 1:
        append_all(r, r2)
        apply_distinct(r)
        return
    if op == 3:
        subtract(r, r2)
        apply_distinct(r)
        return
    intersect(r, r2)
    apply_distinct(r)

def append_all(r: Int, r2: Int):
    n := rowset.rs_nrows(r2)
    nc := rowset.rs_ncols(r2)
    mut i := 0
    while i < n:
        vals := mem.iv_new(nc)
        mut j := 0
        while j < nc:
            mem.iv_push(vals, value.v_clone(rowset.rs_cell(r2, i, j)))
            j = j + 1
        rowset.rs_add_row(r, vals)
        mem.iv_free(vals)
        i = i + 1

def row_in(r2: Int, r: Int, rowi: Int) -> Int:
    n2 := rowset.rs_nrows(r2)
    nc := rowset.rs_ncols(r)
    mut i := 0
    while i < n2:
        mut same := 1
        mut j := 0
        while j < nc:
            if j < rowset.rs_ncols(r2):
                x := rowset.rs_cell(r, rowi, j)
                y := rowset.rs_cell(r2, i, j)
                xn := value.v_is_null(x)
                yn := value.v_is_null(y)
                if xn != yn:
                    same = 0
                elif xn == 0:
                    if value.v_cmp(x, y) != 0:
                        same = 0
            j = j + 1
        if same == 1:
            return 1
        i = i + 1
    return 0

def subtract(r: Int, r2: Int):
    n := rowset.rs_nrows(r)
    keep := mem.iv_new(8)
    mut i := 0
    while i < n:
        if row_in(r2, r, i) == 0:
            mem.iv_push(keep, i)
        i = i + 1
    rebuild(r, keep)
    mem.iv_free(keep)

def intersect(r: Int, r2: Int):
    n := rowset.rs_nrows(r)
    keep := mem.iv_new(8)
    mut i := 0
    while i < n:
        if row_in(r2, r, i) == 1:
            mem.iv_push(keep, i)
        i = i + 1
    rebuild(r, keep)
    mem.iv_free(keep)

# ── aggregates ──

def has_aggregate(st: Int, ar: Int) -> Int:
    if mem.iv_len(parser.st_group(st)) > 0:
        return 1
    res := parser.st_results(st)
    n := mem.iv_len(res)
    mut i := 0
    while i < n:
        if expr_has_agg(ar, mem.iv_get(res, i)) == 1:
            return 1
        i = i + 1
    if parser.st_having(st) >= 0:
        return 1
    return 0

def expr_has_agg(ar: Int, e: Int) -> Int:
    if e < 0:
        return 0
    k := ast.kind(ar, e)
    if k == ast.N_FUNC():
        if func.is_agg_call(ar, e) == 1:
            return 1
        slot := ast.list_of(ar, e)
        cnt := ast.av_count(ar, slot)
        mut i := 0
        while i < cnt:
            if expr_has_agg(ar, ast.av_get(ar, slot, i)) == 1:
                return 1
            i = i + 1
        return 0
    if k == ast.N_BINOP():
        if expr_has_agg(ar, ast.a_of(ar, e)) == 1:
            return 1
        return expr_has_agg(ar, ast.b_of(ar, e))
    if k == ast.N_UNOP():
        return expr_has_agg(ar, ast.a_of(ar, e))
    if k == ast.N_CASE():
        slot := ast.list_of(ar, e)
        cnt := ast.av_count(ar, slot)
        mut i := 0
        while i < cnt:
            if expr_has_agg(ar, ast.av_get(ar, slot, i)) == 1:
                return 1
            i = i + 1
        if expr_has_agg(ar, ast.a_of(ar, e)) == 1:
            return 1
        return expr_has_agg(ar, ast.b_of(ar, e))
    return 0

def do_grouped(d: Int, st: Int, ar: Int, cx: Int, combos: Int, r: Int, sc: Int):
    groups := parser.st_group(st)
    ng := mem.iv_len(groups)
    n := mem.iv_len(combos)

    # Assign each row to a group bucket.
    bucket_of := mem.iv_new(n + 1)
    bkeys := mem.iv_new(8)
    mut nbuckets := 0
    mut i := 0
    while i < n:
        load_combo(cx, mem.iv_get(combos, i))
        mut found := 0 - 1
        if ng == 0:
            if nbuckets > 0:
                found = 0
        else:
            mut b := 0
            while b < nbuckets:
                if group_matches(ar, groups, ng, cx, bkeys, b) == 1:
                    found = b
                    b = nbuckets
                else:
                    b = b + 1
        if found < 0:
            found = nbuckets
            mut j := 0
            while j < ng:
                mem.iv_push(bkeys, eval.eval(ar, mem.iv_get(groups, j), cx))
                j = j + 1
            nbuckets = nbuckets + 1
        mem.iv_push(bucket_of, found)
        i = i + 1

    if nbuckets == 0:
        if ng == 0:
            nbuckets = 1

    res := parser.st_results(st)
    nres := mem.iv_len(res)
    mut b := 0
    while b < nbuckets:
        # HAVING is evaluated with the same aggregate machinery.
        if parser.st_having(st) >= 0:
            hv := eval_agg_expr(ar, parser.st_having(st), cx, combos, bucket_of, b)
            mut ok := 0
            if value.v_is_null(hv) == 0:
                ok = value.v_truthy(hv)
            value.v_free(hv)
            if ok == 0:
                b = b + 1
                continue
        vals := mem.iv_new(4)
        mut j := 0
        while j < nres:
            e := mem.iv_get(res, j)
            if ast.kind(ar, e) == ast.N_STAR():
                first := first_in_bucket(combos, bucket_of, b)
                if first >= 0:
                    load_combo(cx, mem.iv_get(combos, first))
                push_star(ar, e, cx, vals)
            else:
                mem.iv_push(vals, eval_agg_expr(ar, e, cx, combos, bucket_of, b))
            j = j + 1
        rowset.rs_add_row(r, vals)
        mem.iv_free(vals)
        b = b + 1

    mut f := 0
    while f < mem.iv_len(bkeys):
        value.v_free(mem.iv_get(bkeys, f))
        f = f + 1
    mem.iv_free(bkeys)
    mem.iv_free(bucket_of)

def first_in_bucket(combos: Int, bucket_of: Int, b: Int) -> Int:
    n := mem.iv_len(bucket_of)
    mut i := 0
    while i < n:
        if mem.iv_get(bucket_of, i) == b:
            return i
        i = i + 1
    return 0 - 1

def group_matches(ar: Int, groups: Int, ng: Int, cx: Int, bkeys: Int, b: Int) -> Int:
    mut j := 0
    while j < ng:
        v := eval.eval(ar, mem.iv_get(groups, j), cx)
        k := mem.iv_get(bkeys, b * ng + j)
        vn := value.v_is_null(v)
        kn := value.v_is_null(k)
        mut same := 1
        if vn != kn:
            same = 0
        elif vn == 0:
            if value.v_cmp(v, k) != 0:
                same = 0
        value.v_free(v)
        if same == 0:
            return 0
        j = j + 1
    return 1

# Evaluate an expression where aggregate calls fold over the bucket's rows.
def eval_agg_expr(ar: Int, e: Int, cx: Int, combos: Int, bucket_of: Int, b: Int) -> Int:
    if e < 0:
        return value.v_null()
    k := ast.kind(ar, e)
    if k == ast.N_FUNC():
        if func.is_agg_call(ar, e) == 1:
            return run_aggregate(ar, e, cx, combos, bucket_of, b)
    if k == ast.N_BINOP():
        op := ast.text_of(ar, e)
        l := eval_agg_expr(ar, ast.a_of(ar, e), cx, combos, bucket_of, b)
        rr := eval_agg_expr(ar, ast.b_of(ar, e), cx, combos, bucket_of, b)
        out := eval.apply_binop(op, l, rr)
        value.v_free(l)
        value.v_free(rr)
        return out
    if k == ast.N_UNOP():
        inner := eval_agg_expr(ar, ast.a_of(ar, e), cx, combos, bucket_of, b)
        op := ast.text_of(ar, e)
        mut out := 0
        if lpp_str_eq(op, "-") == 1:
            if value.v_type(inner) == value.TREAL():
                out = value.v_from_real(0.0 - value.v_real(inner))
            else:
                out = value.v_from_int(0 - value.v_to_int(inner))
        elif lpp_str_eq(op, "NOT") == 1:
            out = value.v_from_int(1 - value.v_truthy(inner))
        else:
            out = value.v_clone(inner)
        value.v_free(inner)
        return out
    # Non-aggregate leaf: evaluate against the first row of the bucket.
    first := first_in_bucket(combos, bucket_of, b)
    if first >= 0:
        load_combo(cx, mem.iv_get(combos, first))
    return eval.eval(ar, e, cx)

def run_aggregate(ar: Int, e: Int, cx: Int, combos: Int, bucket_of: Int, b: Int) -> Int:
    name := ast.text_of(ar, e)
    slot := ast.list_of(ar, e)
    cnt := ast.av_count(ar, slot)
    distinct := ast.b_of(ar, e)
    n := mem.iv_len(bucket_of)

    mut count := 0
    mut isum := 0
    mut fsum := 0.0
    mut anyreal := 0
    mut best := 0
    mut sawval := 0
    seen := mem.iv_new(8)
    catsb := strbuf.sb_new()
    mut catn := 0

    mut i := 0
    while i < n:
        if mem.iv_get(bucket_of, i) == b:
            load_combo(cx, mem.iv_get(combos, i))
            mut v := 0
            mut isstar := 0
            if cnt == 0:
                isstar = 1
            elif ast.kind(ar, ast.av_get(ar, slot, 0)) == ast.N_STAR():
                isstar = 1
            if isstar == 1:
                count = count + 1
            else:
                v = eval.eval(ar, ast.av_get(ar, slot, 0), cx)
                if value.v_is_null(v) == 0:
                    mut dup := 0
                    if distinct == 1:
                        mut z := 0
                        while z < mem.iv_len(seen):
                            if value.v_cmp(v, mem.iv_get(seen, z)) == 0:
                                dup = 1
                                z = mem.iv_len(seen)
                            else:
                                z = z + 1
                        if dup == 0:
                            mem.iv_push(seen, value.v_clone(v))
                    if dup == 0:
                        count = count + 1
                        if value.v_type(v) == value.TREAL():
                            anyreal = 1
                        fsum = fsum + value.v_to_real(v)
                        isum = isum + value.v_to_int(v)
                        if sawval == 0:
                            best = value.v_clone(v)
                            sawval = 1
                        else:
                            cv := eval.compare_operands(v, best)
                            if strbuf.eq_ci(name, "min") == 1:
                                if cv < 0:
                                    value.v_free(best)
                                    best = value.v_clone(v)
                            elif strbuf.eq_ci(name, "max") == 1:
                                if cv > 0:
                                    value.v_free(best)
                                    best = value.v_clone(v)
                        if strbuf.eq_ci(name, "group_concat") == 1:
                            if catn > 0:
                                mut sep := ","
                                if cnt >= 2:
                                    sv2 := eval.eval(ar, ast.av_get(ar, slot, 1), cx)
                                    sep = value.v_to_text(sv2)
                                    value.v_free(sv2)
                                strbuf.sb_add(catsb, sep)
                            strbuf.sb_add(catsb, value.v_to_text(v))
                            catn = catn + 1
                value.v_free(v)
        i = i + 1

    mut zz := 0
    while zz < mem.iv_len(seen):
        value.v_free(mem.iv_get(seen, zz))
        zz = zz + 1
    mem.iv_free(seen)

    mut out := 0
    if strbuf.eq_ci(name, "count") == 1:
        out = value.v_from_int(count)
    elif strbuf.eq_ci(name, "sum") == 1:
        if count == 0:
            out = value.v_null()
        elif anyreal == 1:
            out = value.v_from_real(fsum)
        else:
            out = value.v_from_int(isum)
    elif strbuf.eq_ci(name, "total") == 1:
        out = value.v_from_real(fsum)
    elif strbuf.eq_ci(name, "avg") == 1:
        if count == 0:
            out = value.v_null()
        else:
            out = value.v_from_real(fsum / int_to_float(count))
    elif strbuf.eq_ci(name, "group_concat") == 1:
        if catn == 0:
            out = value.v_null()
        else:
            out = value.v_from_str(strbuf.sb_str(catsb))
    else:
        if sawval == 0:
            out = value.v_null()
        else:
            out = value.v_clone(best)
    if sawval == 1:
        value.v_free(best)
    strbuf.sb_free(catsb)
    return out

# ════════════════════ subqueries ════════════════════
# A subquery is executed as an independent SELECT. Correlated references are
# not resolved against the outer row (see README limitations), so these run
# once per evaluation with their own context.

def run_subselect(d: Int, sub: Int, ar: Int, outer: Int) -> Int:
    if d == 0:
        return 0
    if sub == 0:
        return 0
    mut params := 0
    if outer != 0:
        params = eval.cx_params(outer)
    return do_select(d, sub, ar, params)

# (SELECT ...) used as a value: first column of the first row, else NULL.
def subquery_scalar(d: Int, sub: Int, ar: Int, outer: Int) -> Int:
    r := run_subselect(d, sub, ar, outer)
    if r == 0:
        return value.v_null()
    mut out := 0
    if rowset.rs_err(r) == 1:
        out = value.v_null()
    elif rowset.rs_nrows(r) == 0:
        out = value.v_null()
    elif rowset.rs_ncols(r) == 0:
        out = value.v_null()
    else:
        out = value.v_clone(rowset.rs_cell(r, 0, 0))
    rowset.rs_free(r)
    return out

# EXISTS (SELECT ...) -> 1 if the subquery returns any row.
def subquery_exists(d: Int, sub: Int, ar: Int, outer: Int) -> Int:
    r := run_subselect(d, sub, ar, outer)
    if r == 0:
        return value.v_from_int(0)
    mut n := 0
    if rowset.rs_err(r) == 0:
        n = rowset.rs_nrows(r)
    rowset.rs_free(r)
    if n > 0:
        return value.v_from_int(1)
    return value.v_from_int(0)

# expr IN (SELECT ...) with SQL's NULL semantics.
def subquery_in(d: Int, sub: Int, ar: Int, outer: Int, lhs: Int, neg: Int) -> Int:
    v := eval.eval(ar, lhs, outer)
    r := run_subselect(d, sub, ar, outer)
    if r == 0:
        value.v_free(v)
        return value.v_null()
    if rowset.rs_err(r) == 1:
        rowset.rs_free(r)
        value.v_free(v)
        return value.v_null()
    n := rowset.rs_nrows(r)
    if value.v_is_null(v) == 1:
        rowset.rs_free(r)
        value.v_free(v)
        if n == 0:
            return value.v_from_int(neg)
        return value.v_null()
    mut found := 0
    mut sawnull := 0
    mut i := 0
    while i < n:
        cell := rowset.rs_cell(r, i, 0)
        if value.v_is_null(cell) == 1:
            sawnull = 1
        elif eval.compare_operands(v, cell) == 0:
            found = 1
        i = i + 1
    rowset.rs_free(r)
    value.v_free(v)
    if found == 1:
        if neg == 1:
            return value.v_from_int(0)
        return value.v_from_int(1)
    if sawnull == 1:
        return value.v_null()
    if neg == 1:
        return value.v_from_int(1)
    return value.v_from_int(0)

# ════════════════════ UPDATE / DELETE ════════════════════

def do_update(d: Int, st: Int, ar: Int, params: Int) -> Int:
    r := rowset.rs_new(0)
    name := parser.st_table(st)
    sc := db_schema(d)
    ti := schema.sc_find(sc, name)
    if ti < 0:
        rowset.rs_fail(r, str_concat("no such table: ", name))
        return r
    p := db_pager(d)
    root := schema.sc_root(sc, ti)
    ipk := schema.sc_ipk(sc, ti)
    tcols := schema.sc_cols(sc, ti)
    ttypes := schema.sc_types_of(sc, ti)
    ncols := strbuf.sv_len(tcols)

    setcols := parser.st_set_cols(st)
    setexprs := parser.st_set_exprs(st)
    nset := strbuf.sv_len(setcols)

    cx := eval.cx_new()
    eval.cx_set_db(cx, d)
    bind_params(cx, params)
    mut i := 0
    while i < ncols:
        eval.cx_bind(cx, strbuf.sv_get(tcols, i), name, 0)
        i = i + 1

    rows := scan_table(d, ti)
    n := mem.iv_len(rows)
    targets := mem.iv_new(8)
    newrecs := mem.iv_new(8)
    w := parser.st_where(st)
    mut ri := 0
    while ri < n:
        row := mem.iv_get(rows, ri)
        vv := row_vals(row)
        mut j := 0
        while j < ncols:
            eval.cx_set_val(cx, j, value.vv_get(vv, j))
            j = j + 1
        eval.cx_set_rowid(cx, row_rowid(row))
        mut ok := 1
        if w >= 0:
            cv := eval.eval(ar, w, cx)
            ok = 0
            if value.v_is_null(cv) == 0:
                ok = value.v_truthy(cv)
            value.v_free(cv)
        if ok == 1:
            newvv := value.vv_new()
            mut k := 0
            while k < ncols:
                value.vv_push(newvv, value.v_clone(value.vv_get(vv, k)))
                k = k + 1
            mut s := 0
            while s < nset:
                cn := strbuf.sv_get(setcols, s)
                ci := strbuf.sv_find_ci(tcols, cn)
                if ci >= 0:
                    ev := eval.eval(ar, mem.iv_get(setexprs, s), cx)
                    aff := schema.affinity_of(col_type(ttypes, ci))
                    av := schema.apply_affinity(ev, aff)
                    value.v_free(value.vv_get(newvv, ci))
                    value.vv_set(newvv, ci, av)
                s = s + 1
            mut newrid := row_rowid(row)
            if ipk >= 0:
                pv := value.vv_get(newvv, ipk)
                if value.v_is_null(pv) == 0:
                    newrid = value.v_to_int(pv)
                value.v_free(value.vv_get(newvv, ipk))
                value.vv_set(newvv, ipk, value.v_null())
            rec := record.encode(newvv)
            h := buf_alloc(24)
            mem.bset64(h, 0, row_rowid(row))
            mem.bset64(h, 8, newrid)
            mem.bset64(h, 16, rec)
            mem.iv_push(newrecs, h)
            value.vv_free_all(newvv)
        ri = ri + 1

    # Apply after scanning so the cursor is never invalidated mid-walk.
    mut ai := 0
    while ai < mem.iv_len(newrecs):
        h := mem.iv_get(newrecs, ai)
        oldrid := mem.bget64(h, 0)
        newrid := mem.bget64(h, 8)
        rec := mem.bget64(h, 16)
        btwrite.delete(p, root, oldrid)
        btwrite.insert(p, root, newrid, mem.vec_data(rec), mem.vec_len(rec))
        mem.vec_free(rec)
        buf_free(h)
        ai = ai + 1
    changes := mem.iv_len(newrecs)

    free_rows(rows)
    mem.iv_free(targets)
    mem.iv_free(newrecs)
    strbuf.sv_free(tcols)
    strbuf.sv_free(ttypes)
    if eval.cx_err(cx) == 1:
        rowset.rs_fail(r, eval.cx_errmsg(cx))
    eval.cx_free(cx)
    rowset.rs_set_changes(r, changes)
    mem.bset64(d, 48, changes)
    flush(d)
    return r

def do_delete(d: Int, st: Int, ar: Int, params: Int) -> Int:
    r := rowset.rs_new(0)
    name := parser.st_table(st)
    sc := db_schema(d)
    ti := schema.sc_find(sc, name)
    if ti < 0:
        rowset.rs_fail(r, str_concat("no such table: ", name))
        return r
    p := db_pager(d)
    root := schema.sc_root(sc, ti)
    tcols := schema.sc_cols(sc, ti)
    ncols := strbuf.sv_len(tcols)

    cx := eval.cx_new()
    eval.cx_set_db(cx, d)
    bind_params(cx, params)
    mut i := 0
    while i < ncols:
        eval.cx_bind(cx, strbuf.sv_get(tcols, i), name, 0)
        i = i + 1

    rows := scan_table(d, ti)
    n := mem.iv_len(rows)
    victims := mem.iv_new(8)
    w := parser.st_where(st)
    mut ri := 0
    while ri < n:
        row := mem.iv_get(rows, ri)
        vv := row_vals(row)
        mut j := 0
        while j < ncols:
            eval.cx_set_val(cx, j, value.vv_get(vv, j))
            j = j + 1
        eval.cx_set_rowid(cx, row_rowid(row))
        mut ok := 1
        if w >= 0:
            cv := eval.eval(ar, w, cx)
            ok = 0
            if value.v_is_null(cv) == 0:
                ok = value.v_truthy(cv)
            value.v_free(cv)
        if ok == 1:
            mem.iv_push(victims, row_rowid(row))
        ri = ri + 1

    mut vi := 0
    while vi < mem.iv_len(victims):
        btwrite.delete(p, root, mem.iv_get(victims, vi))
        vi = vi + 1
    changes := mem.iv_len(victims)

    free_rows(rows)
    mem.iv_free(victims)
    strbuf.sv_free(tcols)
    if eval.cx_err(cx) == 1:
        rowset.rs_fail(r, eval.cx_errmsg(cx))
    eval.cx_free(cx)
    rowset.rs_set_changes(r, changes)
    mem.bset64(d, 48, changes)
    flush(d)
    return r

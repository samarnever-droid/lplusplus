# exec.lpp — statement execution.
#
# Strategy: build the full candidate row set (cross-product of the FROM
# tables, filtered by ON/WHERE as early as possible), then apply
# GROUP BY -> HAVING -> result projection -> DISTINCT -> ORDER BY -> LIMIT.
# Materialising is simple and correct; index-driven planning is future work.
#
# Database handle:
#   [0]  pager
#   [8]  schema
#   [16] path (sv)
#   [24] autocommit flag
#   [32] in-transaction snapshot (image copy) or 0
#   [40] last insert rowid
#   [48] total changes
#   [56] open flag

import mem
import strbuf
import value
import ieee754
import record
import pager
import btree
import btwrite
import cursor
import schema
import idx
import lexer
import ast
import parser
import eval
import func
import rowset

import exec_statements
import exec_ddl
import exec_insert
import exec_rows
import exec_select_core
import exec_select_projection
import exec_select_aggregate
import exec_dml

def db_pager(d: Int) -> Int:
    return mem.bget64(d, 0)

def db_schema(d: Int) -> Int:
    return mem.bget64(d, 8)

def db_set_schema(d: Int, s: Int):
    mem.bset64(d, 8, s)

def db_path(d: Int) -> Str:
    p := mem.bget64(d, 16)
    if strbuf.sv_len(p) == 0:
        return ""
    return strbuf.sv_get(p, 0)

def db_last_id(d: Int) -> Int:
    return mem.bget64(d, 40)

def db_set_last_id(d: Int, v: Int):
    mem.bset64(d, 40, v)

def db_changes(d: Int) -> Int:
    return mem.bget64(d, 48)

# ── advisory file locking ──
#
# L++ exposes no flock/LockFileEx builtin, but `dir_create` maps to mkdir(2) /
# CreateDirectoryA, which fail atomically when the target already exists. That
# makes a lock *directory* a portable mutex.
#
# This is advisory and cooperative: it stops two lppsqlite processes from
# writing the same file concurrently (which previously corrupted it). It does
# not coordinate with the real sqlite3, and a process killed mid-write leaves a
# stale lock that must be removed by hand or waited out.

def LOCK_SPINS() -> Int:
    return 200

def lock_path(path: Str) -> Str:
    return str_concat(path, "-lppsqlite-lock")

# Try to take the lock; 1 on success. Waits up to ~2 s for a busy database.
def acquire_lock(path: Str) -> Int:
    if str_len(path) == 0:
        return 1
    if str_len(env_get("LPPSQLITE_NO_LOCK")) > 0:
        return 1
    lp := lock_path(path)
    mut tries := 0
    while tries < LOCK_SPINS():
        if dir_create(lp) == 0:
            return 1
        sleep_ms(10)
        tries = tries + 1
    return 0

def release_lock(path: Str):
    if str_len(path) == 0:
        return
    if str_len(env_get("LPPSQLITE_NO_LOCK")) > 0:
        return
    dir_remove(lock_path(path))

# ── open / close ──

def open_db(path: Str) -> Int:
    d := buf_alloc(72)
    mut locked := 0
    if str_len(path) > 0:
        if acquire_lock(path) == 1:
            locked = 1
        else:
            locked = 0 - 1
    mut pg := 0
    if file_exists(path) == 1:
        raw := buf_read(path)
        if buf_len(raw) >= 100:
            pg = pager.pg_open_buf(raw, buf_len(raw))
        buf_free(raw)
    if pg == 0:
        pg = pager.pg_create(4096)
    mem.bset64(d, 0, pg)
    mem.bset64(d, 8, schema.load(pg))
    sv := strbuf.sv_new()
    strbuf.sv_push(sv, path)
    mem.bset64(d, 16, sv)
    mem.bset64(d, 24, 1)
    mem.bset64(d, 32, 0)
    mem.bset64(d, 40, 0)
    mem.bset64(d, 48, 0)
    mem.bset64(d, 56, 1)
    mem.bset64(d, 64, locked)
    return d

def open_memory() -> Int:
    d := buf_alloc(72)
    pg := pager.pg_create(4096)
    mem.bset64(d, 0, pg)
    mem.bset64(d, 8, schema.load(pg))
    sv := strbuf.sv_new()
    strbuf.sv_push(sv, "")
    mem.bset64(d, 16, sv)
    mem.bset64(d, 24, 1)
    mem.bset64(d, 32, 0)
    mem.bset64(d, 40, 0)
    mem.bset64(d, 48, 0)
    mem.bset64(d, 56, 1)
    return d

# ── transactions ──
#
# A transaction snapshots the whole database image before the first mutation.
# COMMIT drops the snapshot and writes through; ROLLBACK restores it. This is
# a shadow-copy scheme rather than SQLite's rollback journal: it is simple and
# genuinely correct in-process, but it is not crash-safe and provides no
# cross-process locking (see the package README).

def in_transaction(d: Int) -> Int:
    if mem.bget64(d, 24) == 0:
        return 1
    return 0

def begin_txn(d: Int):
    if in_transaction(d) == 1:
        return
    mem.bset64(d, 24, 0)          # autocommit off
    snapshot(d)

# Copy the current image so ROLLBACK can restore it.
def snapshot(d: Int):
    old := mem.bget64(d, 32)
    if old != 0:
        mem.vec_free(old)
    p := db_pager(d)
    img := pager.pg_img(p)
    n := mem.vec_len(img)
    copy := mem.vec_new(n + 1)
    mem.vec_push_bytes(copy, mem.vec_data(img), 0, n)
    mem.bset64(d, 32, copy)

def drop_snapshot(d: Int):
    snap := mem.bget64(d, 32)
    if snap != 0:
        mem.vec_free(snap)
    mem.bset64(d, 32, 0)

def commit_txn(d: Int):
    drop_snapshot(d)
    mem.bset64(d, 24, 1)          # autocommit on
    flush(d)

def rollback_txn(d: Int):
    snap := mem.bget64(d, 32)
    if snap != 0:
        p := db_pager(d)
        img := pager.pg_img(p)
        n := mem.vec_len(snap)
        mem.vec_clear(img)
        mem.vec_push_bytes(img, mem.vec_data(snap), 0, n)
        ps := pager.pg_size(p)
        if ps > 0:
            pager.pg_set_count(p, n / ps)
        mem.vec_free(snap)
    mem.bset64(d, 32, 0)
    mem.bset64(d, 24, 1)
    # The catalogue may have changed (CREATE/DROP), so rebuild it.
    reload_schema(d)
    flush(d)

# Write through to disk unless a transaction is open, in which case the file is
# left untouched until COMMIT.
def autoflush(d: Int) -> Int:
    if in_transaction(d) == 1:
        return 0
    return flush(d)

def flush(d: Int) -> Int:
    p := db_path(d)
    if str_len(p) == 0:
        return 0
    return pager.pg_save(db_pager(d), p)

# Did this handle actually take the lock? (0 for :memory: or when disabled)
def db_locked(d: Int) -> Int:
    return mem.bget64(d, 64)

# 1 when a file-backed database could not be locked, so every statement fails
# loudly instead of racing another writer.
def db_busy(d: Int) -> Int:
    if mem.bget64(d, 64) == 0 - 1:
        return 1
    return 0

def close_db(d: Int):
    flush(d)
    if db_locked(d) == 1:
        release_lock(db_path(d))
    schema.sc_free(db_schema(d))
    pager.pg_free(db_pager(d))
    strbuf.sv_free(mem.bget64(d, 16))
    buf_free(d)

def reload_schema(d: Int):
    schema.sc_free(db_schema(d))
    db_set_schema(d, schema.load(db_pager(d)))

# ── entry point ──

def exec(d: Int, sql: Str) -> Int:
    return exec_params(d, sql, 0)

def exec_params(d: Int, sql: Str, params: Int) -> Int:
    if db_busy(d) == 1:
        r := rowset.rs_new(0)
        rowset.rs_fail(r, "database is locked by another lppsqlite process")
        return r
    p := parser.ps_new(sql)
    st := parser.parse_statement(p)
    if parser.ps_failed(p) == 1:
        r := rowset.rs_new(0)
        rowset.rs_fail(r, parser.ps_errmsg(p))
        parser.st_free(st)
        ast.ar_free(parser.ps_arena(p))
        parser.ps_free(p)
        return r
    r := run_stmt(d, st, parser.ps_arena(p), sql, params)
    parser.st_free(st)
    ast.ar_free(parser.ps_arena(p))
    parser.ps_free(p)
    return r

# Execute several statements separated by ';'. Returns the last result.
def exec_script(d: Int, sql: Str) -> Int:
    parts := split_statements(sql)
    n := strbuf.sv_len(parts)
    mut last := 0
    mut i := 0
    while i < n:
        s := strbuf.sv_get(parts, i)
        if is_blank(s) == 0:
            if last != 0:
                rowset.rs_free(last)
            last = exec(d, s)
            if rowset.rs_err(last) == 1:
                strbuf.sv_free(parts)
                return last
        i = i + 1
    strbuf.sv_free(parts)
    if last == 0:
        last = rowset.rs_new(0)
    return last


# ════════════════════ subqueries ════════════════════
# A subquery is executed as an independent SELECT. Correlated references are
# not resolved against the outer row (see README limitations), so these run
# once per evaluation with their own context.

def run_subselect(d: Int, sub: Int, ar: Int, outer: Int) -> Int:
    if d == 0:
        return 0
    if sub == 0:
        return 0
    mut params := 0
    if outer != 0:
        params = eval.cx_params(outer)
    return do_select_in(d, sub, ar, params, outer)

# (SELECT ...) used as a value: first column of the first row, else NULL.
def subquery_scalar(d: Int, sub: Int, ar: Int, outer: Int) -> Int:
    r := run_subselect(d, sub, ar, outer)
    if r == 0:
        return value.v_null()
    mut out := 0
    if rowset.rs_err(r) == 1:
        out = value.v_null()
    elif rowset.rs_nrows(r) == 0:
        out = value.v_null()
    elif rowset.rs_ncols(r) == 0:
        out = value.v_null()
    else:
        out = value.v_clone(rowset.rs_cell(r, 0, 0))
    rowset.rs_free(r)
    return out

# EXISTS (SELECT ...) -> 1 if the subquery returns any row.
def subquery_exists(d: Int, sub: Int, ar: Int, outer: Int) -> Int:
    r := run_subselect(d, sub, ar, outer)
    if r == 0:
        return value.v_from_int(0)
    mut n := 0
    if rowset.rs_err(r) == 0:
        n = rowset.rs_nrows(r)
    rowset.rs_free(r)
    if n > 0:
        return value.v_from_int(1)
    return value.v_from_int(0)

# expr IN (SELECT ...) with SQL's NULL semantics.
def subquery_in(d: Int, sub: Int, ar: Int, outer: Int, lhs: Int, neg: Int) -> Int:
    v := eval.eval(ar, lhs, outer)
    r := run_subselect(d, sub, ar, outer)
    if r == 0:
        value.v_free(v)
        return value.v_null()
    if rowset.rs_err(r) == 1:
        rowset.rs_free(r)
        value.v_free(v)
        return value.v_null()
    n := rowset.rs_nrows(r)
    if value.v_is_null(v) == 1:
        rowset.rs_free(r)
        value.v_free(v)
        if n == 0:
            return value.v_from_int(neg)
        return value.v_null()
    mut found := 0
    mut sawnull := 0
    mut i := 0
    while i < n:
        cell := rowset.rs_cell(r, i, 0)
        if value.v_is_null(cell) == 1:
            sawnull = 1
        elif eval.compare_operands(v, cell) == 0:
            found = 1
        i = i + 1
    rowset.rs_free(r)
    value.v_free(v)
    if found == 1:
        if neg == 1:
            return value.v_from_int(0)
        return value.v_from_int(1)
    if sawnull == 1:
        return value.v_null()
    if neg == 1:
        return value.v_from_int(1)
    return value.v_from_int(0)


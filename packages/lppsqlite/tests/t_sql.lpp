import mem
import strbuf
import value
import rowset
import exec
import tap

# Render a result set as "a|b|c;d|e|f" for compact assertions.
def dump(r: Int) -> Str:
    if rowset.rs_err(r) == 1:
        return str_concat("ERROR: ", rowset.rs_errmsg(r))
    sb := strbuf.sb_new()
    n := rowset.rs_nrows(r)
    nc := rowset.rs_ncols(r)
    mut i := 0
    while i < n:
        if i > 0:
            strbuf.sb_add_ch(sb, 59)
        mut j := 0
        while j < nc:
            if j > 0:
                strbuf.sb_add_ch(sb, 124)
            strbuf.sb_add(sb, value.v_display(rowset.rs_cell(r, i, j)))
            j = j + 1
        i = i + 1
    s := strbuf.sb_str(sb)
    strbuf.sb_free(sb)
    return s

def q(T: Int, d: Int, label: Str, sql: Str, want: Str):
    r := exec.exec(d, sql)
    tap.eq_s(T, label, dump(r), want)
    rowset.rs_free(r)

def run(d: Int, sql: Str):
    r := exec.exec(d, sql)
    rowset.rs_free(r)

def main():
    T := tap.t_new()
    delete_file("sql_test.db")
    d := exec.open_db("sql_test.db")

    run(d, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER, score REAL)")
    q(T, d, "insert 1", "INSERT INTO users VALUES (1, 'Alice', 30, 91.5)", "")
    run(d, "INSERT INTO users VALUES (2, 'Bob', 25, 82.25)")
    run(d, "INSERT INTO users VALUES (3, 'Carol', 35, 78.0)")
    run(d, "INSERT INTO users VALUES (4, 'Dave', 28, 88.5)")
    run(d, "INSERT INTO users (id, name, age, score) VALUES (5, 'Eve', 22, 95.0)")

    q(T, d, "select all names", "SELECT name FROM users", "Alice;Bob;Carol;Dave;Eve")
    q(T, d, "select star row1", "SELECT * FROM users WHERE id = 1", "1|Alice|30|91.5")
    q(T, d, "count", "SELECT COUNT(*) FROM users", "5")
    q(T, d, "sum age", "SELECT SUM(age) FROM users", "140")
    q(T, d, "avg age", "SELECT AVG(age) FROM users", "28.0")
    q(T, d, "min max", "SELECT MIN(age), MAX(age) FROM users", "22|35")
    q(T, d, "where gt", "SELECT name FROM users WHERE age > 28", "Alice;Carol")
    q(T, d, "where and", "SELECT name FROM users WHERE age >= 25 AND age <= 30", "Alice;Bob;Dave")
    q(T, d, "where or", "SELECT name FROM users WHERE age = 22 OR age = 35", "Carol;Eve")
    q(T, d, "order asc", "SELECT name FROM users ORDER BY age", "Eve;Bob;Dave;Alice;Carol")
    q(T, d, "order desc", "SELECT name FROM users ORDER BY age DESC", "Carol;Alice;Dave;Bob;Eve")
    q(T, d, "limit", "SELECT name FROM users ORDER BY id LIMIT 2", "Alice;Bob")
    q(T, d, "limit offset", "SELECT name FROM users ORDER BY id LIMIT 2 OFFSET 2", "Carol;Dave")
    q(T, d, "expr", "SELECT age * 2 FROM users WHERE id = 1", "60")
    q(T, d, "concat", "SELECT name || '!' FROM users WHERE id = 2", "Bob!")
    q(T, d, "real col", "SELECT score FROM users WHERE id = 2", "82.25")
    q(T, d, "like", "SELECT name FROM users WHERE name LIKE 'A%'", "Alice")
    q(T, d, "like underscore", "SELECT name FROM users WHERE name LIKE 'B_b'", "Bob")
    q(T, d, "in list", "SELECT name FROM users WHERE id IN (1, 3)", "Alice;Carol")
    q(T, d, "not in", "SELECT name FROM users WHERE id NOT IN (1,2,3,4)", "Eve")
    q(T, d, "between", "SELECT name FROM users WHERE age BETWEEN 25 AND 30", "Alice;Bob;Dave")
    q(T, d, "is null none", "SELECT COUNT(*) FROM users WHERE name IS NULL", "0")
    q(T, d, "upper fn", "SELECT upper(name) FROM users WHERE id = 1", "ALICE")
    q(T, d, "length fn", "SELECT length(name) FROM users WHERE id = 3", "5")
    q(T, d, "substr fn", "SELECT substr(name, 1, 3) FROM users WHERE id = 1", "Ali")
    q(T, d, "abs fn", "SELECT abs(-42)", "42")
    q(T, d, "coalesce", "SELECT coalesce(NULL, NULL, 7)", "7")
    q(T, d, "typeof", "SELECT typeof(age), typeof(name), typeof(score) FROM users WHERE id=1", "integer|text|real")
    q(T, d, "case", "SELECT CASE WHEN age > 30 THEN 'old' ELSE 'young' END FROM users WHERE id = 3", "old")
    q(T, d, "cast", "SELECT CAST('42abc' AS INTEGER)", "42")
    q(T, d, "arith no from", "SELECT 2 + 3 * 4", "14")
    q(T, d, "distinct", "SELECT DISTINCT age > 27 FROM users ORDER BY 1", "0;1")
    q(T, d, "group by", "SELECT age > 27, COUNT(*) FROM users GROUP BY age > 27 ORDER BY 1", "0|2;1|3")
    q(T, d, "having", "SELECT age > 27, COUNT(*) FROM users GROUP BY age > 27 HAVING COUNT(*) > 2", "1|3")
    q(T, d, "rowid", "SELECT rowid FROM users WHERE name = 'Carol'", "3")

    # UPDATE / DELETE
    r1 := exec.exec(d, "UPDATE users SET age = 31 WHERE name = 'Alice'")
    tap.eq_i(T, "update changes", rowset.rs_changes(r1), 1)
    rowset.rs_free(r1)
    q(T, d, "update applied", "SELECT age FROM users WHERE name = 'Alice'", "31")

    r2 := exec.exec(d, "DELETE FROM users WHERE id = 5")
    tap.eq_i(T, "delete changes", rowset.rs_changes(r2), 1)
    rowset.rs_free(r2)
    q(T, d, "count after delete", "SELECT COUNT(*) FROM users", "4")

    # second table + join
    run(d, "CREATE TABLE orders (oid INTEGER PRIMARY KEY, uid INTEGER, amount INTEGER)")
    run(d, "INSERT INTO orders VALUES (1, 1, 100), (2, 1, 250), (3, 2, 75)")
    q(T, d, "join", "SELECT users.name, orders.amount FROM users JOIN orders ON users.id = orders.uid ORDER BY orders.oid", "Alice|100;Alice|250;Bob|75")
    q(T, d, "join agg", "SELECT users.name, SUM(orders.amount) FROM users JOIN orders ON users.id = orders.uid GROUP BY users.name ORDER BY users.name", "Alice|350;Bob|75")
    q(T, d, "left join", "SELECT users.name FROM users LEFT JOIN orders ON users.id = orders.uid WHERE orders.oid IS NULL ORDER BY users.name", "Carol;Dave")

    # errors
    re := exec.exec(d, "SELECT * FROM nosuch")
    tap.eq_i(T, "missing table errors", rowset.rs_err(re), 1)
    rowset.rs_free(re)
    re2 := exec.exec(d, "SELECT bogus FROM users")
    tap.eq_i(T, "missing column errors", rowset.rs_err(re2), 1)
    rowset.rs_free(re2)

    exec.close_db(d)

    # reopen and confirm persistence
    d2 := exec.open_db("sql_test.db")
    q(T, d2, "persist count", "SELECT COUNT(*) FROM users", "4")
    q(T, d2, "persist row", "SELECT name, age FROM users WHERE id = 1", "Alice|31")
    q(T, d2, "persist orders", "SELECT COUNT(*) FROM orders", "3")
    exec.close_db(d2)

    tap.t_report(T, "sql")

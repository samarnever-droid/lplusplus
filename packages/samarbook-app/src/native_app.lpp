def render_canvas_card(win: Int, card: CanvasNode, is_selected: Bool):
    # Drop shadow
    gui_draw_rounded_rect(win, card.x + 4, card.y + 4, card.width, card.height, 12, 0x05070d)
    
    mut border_col := card.color_border
    if is_selected:
        border_col = 0x38bdf8
    
    gui_draw_rounded_rect(win, card.x, card.y, card.width, card.height, 12, border_col)
    gui_draw_rounded_rect(win, card.x + 2, card.y + 2, card.width - 4, card.height - 4, 10, card.color_bg)

    # Header bar
    gui_draw_rounded_rect(win, card.x + 2, card.y + 2, card.width - 4, 32, 8, 0x1a2538)
    gui_draw_text(win, card.x + 14, card.y + 8, card.title, 0xf0f4fc)

    # Type Badge
    if card.node_type == "MATH":
        gui_draw_rounded_rect(win, card.x + card.width - 70, card.y + 6, 60, 20, 6, 0x10b981)
        gui_draw_text(win, card.x + card.width - 64, card.y + 8, "L++ Math", 0x000000)
    elif card.node_type == "PDF":
        gui_draw_rounded_rect(win, card.x + card.width - 60, card.y + 6, 50, 20, 6, 0x6366f1)
        gui_draw_text(win, card.x + card.width - 52, card.y + 8, "PDF 1.7", 0xffffff)
    else:
        gui_draw_rounded_rect(win, card.x + card.width - 60, card.y + 6, 50, 20, 6, 0x38bdf8)
        gui_draw_text(win, card.x + card.width - 54, card.y + 8, "Note", 0x000000)

    # Card Body Text
    gui_draw_text(win, card.x + 14, card.y + 44, card.content, 0x94a3b8)

    # Port Dots
    gui_draw_circle(win, card.x, card.y + (card.height / 2), 6, 0x38bdf8)
    gui_draw_circle(win, card.x + card.width, card.y + (card.height / 2), 6, 0x38bdf8)


def main():
    print_str("Starting Pure Native SamarBook Desktop Spatial Knowledge Workstation...")

    # Create 1280x768 Native Windows Window
    win := gui_window_create("SamarBook — Pure Native L++ Spatial Knowledge Network", 1280, 768)
    if win < 0:
        print_str("Error: Failed to create native desktop window.")
        return

    print_str("Desktop window created successfully. Running continuous 60fps event loop...")

    # Active State
    mut active_tab := "Home"
    mut selected_card := 1
    mut is_dragging := false
    mut drag_offset_x := 0
    mut drag_offset_y := 0

    # Knowledge Graph Cards
    mut c1 := CanvasNode(1, "Cosmos Architecture", "Pure native L++ engine.\nSpatial graph topology & zero webview.", 300, 160, 320, 160, "NOTE", 0x0f172a, 0x334155)
    mut c2 := CanvasNode(2, "Symbolic Linear Solver", "Equation: 3x + 12 = 36\nStep 1: 3x = 24\nStep 2: x = 8", 740, 220, 320, 180, "MATH", 0x064e3b, 0x059669)
    mut c3 := CanvasNode(3, "PDF Vector Document", "File: cosmos_whitepaper.pdf\nVector rendering: Valid 1.7\nPages: 12 vector sheets", 420, 440, 320, 160, "PDF", 0x1e1b4b, 0x4338ca)

    # Check if running in automated test harness mode
    mut max_frames := 0
    test_mode := env_get("LPP_TEST_MODE")
    if test_mode == "1":
        max_frames = 5

    mut current_frame := 0
    mut is_running := 1
    while is_running == 1:
        # 1. Poll Native OS Events
        is_open := gui_window_poll_events(win)
        if is_open == 0:
            is_running = 0
            break

        if max_frames > 0:
            current_frame = current_frame + 1
            if current_frame >= max_frames:
                is_running = 0

        mx := gui_mouse_x(win)
        my := gui_mouse_y(win)
        m_down := gui_mouse_down(win)

        # 2. Sidebar Tab Navigation Hit-Testing
        if m_down == 1:
            if mx >= 16 and mx <= 204:
                if my >= 80 and my <= 116:
                    active_tab = "Home"
                elif my >= 124 and my <= 160:
                    active_tab = "Canvas"
                elif my >= 168 and my <= 204:
                    active_tab = "Notebooks"
                elif my >= 212 and my <= 248:
                    active_tab = "Assets"
                elif my >= 256 and my <= 292:
                    active_tab = "Settings"

            # Homepage Quick Action Buttons
            if active_tab == "Home":
                if mx >= 436 and mx <= 586 and my >= 104 and my <= 146:
                    active_tab = "Canvas"
                elif mx >= 260 and mx <= 590 and my >= 205 and my <= 335:
                    active_tab = "Canvas" # Click notebook to open canvas

            # Canvas Drag-and-Drop Hit-Testing
            if active_tab == "Canvas":
                if not is_dragging:
                    if mx >= c1.x and mx <= c1.x + c1.width and my >= c1.y and my <= c1.y + c1.height:
                        selected_card = 1
                        is_dragging = true
                        drag_offset_x = mx - c1.x
                        drag_offset_y = my - c1.y
                    elif mx >= c2.x and mx <= c2.x + c2.width and my >= c2.y and my <= c2.y + c2.height:
                        selected_card = 2
                        is_dragging = true
                        drag_offset_x = mx - c2.x
                        drag_offset_y = my - c2.y
                    elif mx >= c3.x and mx <= c3.x + c3.width and my >= c3.y and my <= c3.y + c3.height:
                        selected_card = 3
                        is_dragging = true
                        drag_offset_x = mx - c3.x
                        drag_offset_y = my - c3.y
                else:
                    if selected_card == 1:
                        c1.x = mx - drag_offset_x
                        c1.y = my - drag_offset_y
                    elif selected_card == 2:
                        c2.x = mx - drag_offset_x
                        c2.y = my - drag_offset_y
                    elif selected_card == 3:
                        c3.x = mx - drag_offset_x
                        c3.y = my - drag_offset_y
        else:
            is_dragging = false

        # 3. Render Active View
        if active_tab == "Home":
            render_homepage(win, mx, my)
        elif active_tab == "Canvas":
            # Clear Canvas Area
            gui_draw_rect(win, 221, 0, 1059, 768, 0x090d16)

            # Draw Dot Matrix Grid
            mut gx := 240
            while gx < 1280:
                mut gy := 20
                while gy < 768:
                    gui_draw_circle(win, gx, gy, 1, 0x1e293b)
                    gy = gy + 32
                gx = gx + 32

            # Draw Real-Time Cubic Bezier Links
            # Card 1 -> Card 2
            p1_x := c1.x + c1.width
            p1_y := c1.y + (c1.height / 2)
            p2_x := c2.x
            p2_y := c2.y + (c2.height / 2)
            draw_bezier_segment(win, p1_x, p1_y, p2_x, p2_y, 3, 0x38bdf8)

            # Card 1 -> Card 3
            p3_x := c3.x
            p3_y := c3.y + (c3.height / 2)
            draw_bezier_segment(win, p1_x, p1_y, p3_x, p3_y, 3, 0x10b981)

            # Draw Cards
            render_canvas_card(win, c1, selected_card == 1)
            render_canvas_card(win, c2, selected_card == 2)
            render_canvas_card(win, c3, selected_card == 3)

            # Top Floating Canvas Toolbar
            gui_draw_rounded_rect(win, 320, 16, 760, 48, 24, 0x1e293b)
            gui_draw_rounded_rect(win, 322, 18, 756, 44, 22, 0x0f172a)

            gui_draw_text(win, 340, 30, "✨ Canvas", 0x38bdf8)

            gui_draw_rounded_rect(win, 430, 24, 75, 32, 16, 0x38bdf8)
            gui_draw_text(win, 445, 31, "+ Note", 0x000000)

            gui_draw_rounded_rect(win, 515, 24, 75, 32, 16, 0x1e293b)
            gui_draw_text(win, 530, 31, "+ Math", 0xf0f4fc)

            gui_draw_rounded_rect(win, 600, 24, 70, 32, 16, 0x1e293b)
            gui_draw_text(win, 615, 31, "+ PDF", 0xf0f4fc)

            gui_draw_rounded_rect(win, 680, 24, 85, 32, 16, 0x1e293b)
            gui_draw_text(win, 690, 31, "⚡ Arrange", 0xf0f4fc)

            gui_draw_rounded_rect(win, 775, 24, 100, 32, 16, 0x1e293b)
            gui_draw_text(win, 785, 31, "📄 Export PDF", 0xf0f4fc)

            gui_draw_rounded_rect(win, 885, 24, 105, 32, 16, 0x10b981)
            gui_draw_text(win, 895, 31, "💾 Save .sbook", 0x000000)

            # Canvas Bottom Status Bar
            gui_draw_rect(win, 221, 740, 1059, 28, 0x0b101b)
            gui_draw_text(win, 240, 746, "60 FPS Native Window  |  Cards: 3  |  Links: 2  |  Drag cards with mouse", 0x64748b)

        elif active_tab == "Notebooks":
            gui_draw_rect(win, 221, 0, 1059, 768, 0x090d16)
            gui_draw_text(win, 260, 40, "Notebooks Collections", 0xf0f4fc)
            gui_draw_text(win, 260, 70, "Manage all your spatial notebooks and divider sections", 0x8ba2c7)

        elif active_tab == "Assets":
            gui_draw_rect(win, 221, 0, 1059, 768, 0x090d16)
            gui_draw_text(win, 260, 40, "Asset Library & Files", 0xf0f4fc)
            gui_draw_text(win, 260, 70, "Embedded images, PDF documents, and math formulas", 0x8ba2c7)

        elif active_tab == "Settings":
            gui_draw_rect(win, 221, 0, 1059, 768, 0x090d16)
            gui_draw_text(win, 260, 40, "Settings & Preferences", 0xf0f4fc)
            gui_draw_text(win, 260, 70, "Theme: Midnight Dark  |  Engine: Pure L++ AOT Direct GPU/GDI", 0x8ba2c7)

        # 4. Render Left Sidebar Navigation
        render_sidebar(win, active_tab, mx, my)

        # 5. Present Backbuffer to Screen
        gui_present(win)

    gui_window_close(win)
    print_str("SamarBook session closed cleanly.")

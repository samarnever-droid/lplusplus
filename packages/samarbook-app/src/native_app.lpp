# SamarBook: Pure Native Desktop Spatial Knowledge Application & Workstation
# 100% Pure Native GUI — No Browser, No Webview, No Electron
# Full Cosmos Canvas recreation: Homepage, Sidebar, Infinite Canvas, Notebooks & Tools

struct NotebookItem:
    id: Int
    name: Str
    note_count: Int
    color_bg: Int
    color_fg: Int
    updated_str: Str

struct CanvasNode:
    id: Int
    title: Str
    content: Str
    x: Int
    y: Int
    width: Int
    height: Int
    node_type: Str # "NOTE", "MATH", "PDF"
    color_bg: Int
    color_border: Int

def draw_bezier_segment(win: Int, x1: Int, y1: Int, x2: Int, y2: Int, thick: Int, color: Int):
    mut dx := x2 - x1
    if dx < 0:
        dx = 0 - dx
    mut curve := dx / 2
    if curve < 40:
        curve = 40

    cp1_x := x1 + curve
    cp1_y := y1
    cp2_x := x2 - curve
    cp2_y := y2

    mut prev_x := x1
    mut prev_y := y1
    mut t := 1
    while t <= 12:
        cur_x := x1 + (x2 - x1) * t / 12
        mut cur_y := y1 + (y2 - y1) * t / 12
        if t < 6:
            cur_y = y1 + (cp1_y - y1) * t / 6
        else:
            cur_y = cp2_y + (y2 - cp2_y) * (t - 6) / 6

        gui_draw_line(win, prev_x, prev_y, cur_x, cur_y, thick, color)
        prev_x = cur_x
        prev_y = cur_y
        t = t + 1


def draw_tab_button(win: Int, name: Str, ty: Int, active_tab: Str, mx: Int, my: Int):
    mut is_active := 0
    if name == active_tab:
        is_active = 1

    mut btn_bg := 0x0c111d
    mut text_col := 0x94a3b8
    if is_active == 1:
        btn_bg = 0x1e293b
        text_col = 0x38bdf8
    elif mx >= 16 and mx <= 204 and my >= ty and my <= ty + 36:
        btn_bg = 0x141d2d
        text_col = 0xf0f4fc

    gui_draw_rounded_rect(win, 16, ty, 188, 36, 8, btn_bg)
    if is_active == 1:
        gui_draw_rounded_rect(win, 16, ty + 6, 4, 24, 2, 0x38bdf8)

    gui_draw_text(win, 36, ty + 10, name, text_col)


def render_sidebar(win: Int, active_tab: Str, mx: Int, my: Int):
    # Sidebar Background
    gui_draw_rect(win, 0, 0, 220, 768, 0x0c111d)
    gui_draw_line(win, 220, 0, 220, 768, 1, 0x1e293b)

    # App Brand Header
    gui_draw_circle(win, 32, 36, 12, 0x38bdf8)
    gui_draw_text(win, 54, 28, "SamarBook", 0xf0f4fc)
    gui_draw_text(win, 138, 30, "L++ Native", 0x38bdf8)

    # Navigation Tabs
    draw_tab_button(win, "Home", 80, active_tab, mx, my)
    draw_tab_button(win, "Canvas", 124, active_tab, mx, my)
    draw_tab_button(win, "Notebooks", 168, active_tab, mx, my)
    draw_tab_button(win, "Assets", 212, active_tab, mx, my)
    draw_tab_button(win, "Settings", 256, active_tab, mx, my)

    # Bottom Profile / Workspace Status
    gui_draw_rounded_rect(win, 16, 696, 188, 54, 8, 0x141c2c)
    gui_draw_circle(win, 38, 723, 14, 0x6366f1)
    gui_draw_text(win, 34, 715, "S", 0xffffff)
    gui_draw_text(win, 62, 712, "Samar Workspace", 0xf0f4fc)
    gui_draw_text(win, 62, 728, "Local .sbook • 60 FPS", 0x64748b)



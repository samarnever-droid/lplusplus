# main.lpp — c2lpp v0.4.0 CLI, Self-Test, and Native Speed Benchmark.
#
# Usage:
#   c2lpp <input.h|input.c> [-o output.lpp]
#   c2lpp --selftest
#   c2lpp --bench

import cspan
import native_types
import translator
import c_func_translator
import clang_ast_translator
import stream_ast
import llvm_ir_translator

extern "C":
    def system(cmd: Str) -> Int

def path_stem(p: Str) -> Str:
    mut last_sep := -1
    mut i := 0
    n := str_len(p)
    while i < n:
        ch := str_substr(p, i, 1)
        if ch == "/" || ch == "\\":
            last_sep = i
        i = i + 1
    base := str_substr(p, last_sep + 1, n - last_sep - 1)
    dot := str_find(base, ".")
    if dot > 0:
        return str_substr(base, 0, dot)
    return base

def path_dir(p: Str) -> Str:
    mut last_sep := -1
    mut i := 0
    n := str_len(p)
    while i < n:
        ch := str_substr(p, i, 1)
        if ch == "/" || ch == "\\":
            last_sep = i
        i = i + 1
    if last_sep < 0:
        return "."
    return str_substr(p, 0, last_sep)

def discover_source_deps(in_path: Str, raw_c: Str, inc_dirs: List[Str]) -> List[Str]:
    # Discover local `#include "foo.h"` headers that have a sibling `foo.c` source file available!
    mut deps := list_new()
    mut seen := map_new()
    self_stem := path_stem(in_path)
    map_put(seen, self_stem, 1)
    base_dir := path_dir(in_path)
    lines := str_lines(raw_c)
    mut i := 0
    n := len(lines)
    while i < n:
        t := str_trim(lines[i])
        i = i + 1
        if str_starts_with(t, "#include \""):
            rest := str_substr(t, 10, str_len(t) - 10)
            q := str_find(rest, "\"")
            if q > 2:
                hdr := str_substr(rest, 0, q)
                if str_ends_with(hdr, ".h"):
                    c_rel := str_concat(str_substr(hdr, 0, str_len(hdr) - 2), ".c")
                    dstem := path_stem(c_rel)
                    if !map_has(seen, dstem):
                        cand0 := str_concat(base_dir, str_concat("/", c_rel))
                        if file_exists(cand0) != 0:
                            map_put(seen, dstem, 1)
                            list_push(deps, cand0)
                        else:
                            mut di := 0
                            while di < len(inc_dirs):
                                cand := str_concat(inc_dirs[di], str_concat("/", c_rel))
                                if file_exists(cand) != 0:
                                    map_put(seen, dstem, 1)
                                    list_push(deps, cand)
                                    break
                                di = di + 1
    return deps

def path_with_h(p: Str) -> Str:
    if str_ends_with(p, ".c"):
        return str_concat(str_substr(p, 0, str_len(p) - 2), ".h")
    return ""

def run_selftest() -> Int:
    # 1. Verify compact 16-byte CSpan layout (vs legacy 64-byte CPtr + 88-byte side record)
    span_size := size_of[CSpan]()
    if span_size != 16:
        print_str("FAIL: CSpan size must be 16 bytes")
        return 1

    # 2. Verify 8-byte packed FastHandle round-trip
    h := fast_handle_pack(12345, 99)
    if fast_handle_index(h) != 12345 || fast_handle_gen(h) != 99:
        print_str("FAIL: FastHandle pack/unpack mismatch")
        return 1

    # 3. Verify CSpan native checked reads/writes & subspan
    buf := cspan_alloc_i32(8)
    mut i := 0
    while i < 8:
        cspan_set_i32(buf, i, (i * 10 + 3) as I32)
        i = i + 1
    sub := cspan_sub(buf, 8, 16)
    v2 := cspan_get_i32(sub, 0) as Int
    v5 := cspan_get_i32(sub, 3) as Int
    cspan_free(buf)
    if v2 != 23 || v5 != 53:
        print_str("FAIL: CSpan subspan read mismatch")
        return 1

    # 3b. Verify CSpan double (Float) + 8-byte alignment safety
    fbuf := cspan_alloc_f64(4)
    cspan_set_f64(fbuf, 0, 3.14159)
    cspan_set_f64(fbuf, 3, -42.5)
    fv0 := cspan_get_f64(fbuf, 0)
    fv3 := cspan_get_f64(fbuf, 3)
    cspan_free(fbuf)
    if fv0 < 3.14 || fv0 > 3.15 || fv3 > -42.0 || fv3 < -43.0:
        print_str("FAIL: CSpan f64/double read mismatch")
        return 1

    # 4. Verify direct native C-to-L++ type mapping (zero Int erasure)
    if c_type_to_native_lpp("int32_t", false) != "I32":
        print_str("FAIL: int32_t mapping")
        return 1
    if c_type_to_native_lpp("uint64_t", false) != "U64":
        print_str("FAIL: uint64_t mapping")
        return 1
    if c_type_to_native_lpp("size_t", false) != "USize":
        print_str("FAIL: size_t mapping")
        return 1
    if c_type_to_native_lpp("int *", false) != "Ptr[I32]":
        print_str("FAIL: int* mapping")
        return 1
    if c_type_to_native_lpp("void *", false) != "RawPtr":
        print_str("FAIL: void* mapping")
        return 1
    if c_type_to_native_lpp("const char *", true) != "Str":
        print_str("FAIL: const char* extern mapping")
        return 1

    # 5. Verify end-to-end C header + function translation
    sample := "#define MAGIC 42\ntypedef struct {\n    int32_t x;\n    uint64_t y;\n} Point;\nint32_t c_add(int32_t a, int32_t b);\nint32_t sum_pair(int32_t a, int32_t b) {\n    int32_t total = a + b;\n    return total;\n}\n"
    out := c2lpp_translate(sample)
    if !str_contains(out, "const MAGIC = 42"):
        print_str("FAIL: missing const MAGIC")
        return 1
    if !str_contains(out, "@repr(C)\nstruct Point:\n    x: I32\n    y: U64"):
        print_str("FAIL: missing @repr(C) Point")
        return 1
    if !str_contains(out, "def c_add(a: I32, b: I32) -> I32"):
        print_str("FAIL: missing extern c_add")
        return 1
    if !str_contains(out, "def sum_pair(a: Int, b: Int) -> Int:"):
        print_str("FAIL: missing translated sum_pair")
        return 1

    # 6. Verify pure-L++ C implementation translator (recursive structs + null sentinel)
    c_impl := "typedef struct Node {\n    struct Node* next;\n    int val;\n} Node;\nstatic int list_len(const Node* n) {\n    int count = 0;\n    while (n != NULL) {\n        count++;\n        n = n->next;\n    }\n    return count;\n}\n"
    impl_out := c2lpp_translate_impl(c_impl)
    if !str_contains(impl_out, "def Node_null() -> Node:") || !str_contains(impl_out, "while !n.is_null:"):
        print_str("FAIL: c2lpp_translate_impl recursive struct translation")
        return 1

    print_str("c2lpp v0.9.0 selftest OK (CSpan=16B+f64+align, FastHandle=8B, Pure-L++ Streaming Clang AST + Full LLVM-IR-to-L++ + Auto-Deps + OS Bridge)")
    return 0

def run_bench() -> Int:
    n := 2000000
    buf := cspan_alloc_i64(n)
    p := cspan_as_i64_ptr(buf)
    t0 := time_ms()
    mut i := 0
    while i < n:
        cptr_set_i64(p, n, i, i * 3 + 1)
        i = i + 1
    mut acc := 0
    i = 0
    while i < n:
        acc = acc + cptr_get_i64(p, n, i)
        i = i + 1
    t1 := time_ms()
    cspan_free(buf)
    print_str(str_concat("c2lpp checked 2M i64 write+read checksum=", int_to_str(acc)))
    print_str(str_concat("elapsed_ms=", int_to_str(t1 - t0)))
    return 0

def main():
    argc := args_count()
    if argc <= 1:
        code := run_selftest()
        if code != 0:
            exit(code)
        return

    first := args_get(1)
    if first == "--selftest":
        code := run_selftest()
        if code != 0:
            exit(code)
        return
    if first == "--bench":
        run_bench()
        return

    if first == "--from-ll" && argc >= 5 && args_get(3) == "-o":
        mut safety := false
        mut si := 5
        while si < argc:
            sa := args_get(si)
            if sa == "--safety" || sa == "--safety=true" || sa == "--safety=True" || sa == "--Safety=True":
                safety = true
            elif sa == "--safety=false" || sa == "--safety=False":
                safety = false
            elif (sa == "--safety" || sa == "--Safety") && si + 1 < argc:
                sv := args_get(si + 1)
                if sv == "true" || sv == "True" || sv == "1":
                    safety = true
                si = si + 1
            si = si + 1
        rc := ll_translate_file(args_get(2), args_get(4), safety)
        if rc != 0:
            exit(rc)
        return

    if first == "--full" && argc >= 3:
        in_path := args_get(2)
        mut out_path := str_concat(path_stem(in_path), ".lpp")
        mut safety := false
        mut clang_flags := list_new()
        mut ai := 3
        while ai < argc:
            a := args_get(ai)
            if a == "-o" && ai + 1 < argc:
                out_path = args_get(ai + 1)
                ai = ai + 2
                continue
            if a == "--safety=true" || a == "--safety=True" || a == "--Safety=True":
                safety = true
                ai = ai + 1
                continue
            if a == "--safety=false" || a == "--safety=False":
                safety = false
                ai = ai + 1
                continue
            if a == "--safety" || a == "--Safety":
                safety = true
                if ai + 1 < argc:
                    nxt := args_get(ai + 1)
                    if nxt == "true" || nxt == "True" || nxt == "1":
                        ai = ai + 2
                        continue
                    if nxt == "false" || nxt == "False" || nxt == "0":
                        safety = false
                        ai = ai + 2
                        continue
                ai = ai + 1
                continue
            list_push(clang_flags, a)
            ai = ai + 1
        flags_str := str_join(clang_flags, " ")
        tmp_ll := "/tmp/c2lpp_full_ir.ll"
        cmd := str_concat("clang -O0 -S -emit-llvm ", str_concat(flags_str, str_concat(" ", str_concat(in_path, str_concat(" -o ", tmp_ll)))))
        rc := system(cmd)
        if rc != 0:
            print_str("FAIL: clang -S -emit-llvm failed")
            exit(1)
        trc := ll_translate_file(tmp_ll, out_path, safety)
        if trc != 0:
            exit(trc)
        return

    if first == "--translate" && argc >= 3:
        in_path := args_get(2)
        mut out_path := ""
        mut auto_deps := false
        mut clang_flags := list_new()
        mut inc_dirs := list_new()
        mut ai := 3
        while ai < argc:
            a := args_get(ai)
            if a == "-o" && ai + 1 < argc:
                out_path = args_get(ai + 1)
                ai = ai + 2
                continue
            if a == "--auto-deps":
                auto_deps = true
                ai = ai + 1
                continue
            if str_starts_with(a, "-I") && str_len(a) > 2:
                list_push(inc_dirs, str_substr(a, 2, str_len(a) - 2))
            list_push(clang_flags, a)
            ai = ai + 1
        flags_str := str_join(clang_flags, " ")
        tmp_ast := "/tmp/c2lpp_clang_ast.json"
        cmd := str_concat("clang -Xclang -ast-dump=json -fsyntax-only ", str_concat(flags_str, str_concat(" ", str_concat(in_path, str_concat(" > ", str_concat(tmp_ast, " 2>/dev/null"))))))
        rc := system(cmd)
        raw_c := read_file(in_path)
        mut translated := ""
        if rc == 0 && file_exists(tmp_ast) != 0:
            h_path := path_with_h(in_path)
            mut raw_h := ""
            if str_len(h_path) > 0 && file_exists(h_path) != 0:
                raw_h = read_file(h_path)
            # Use constant-memory streaming AST translator for large amalgamations (>16MB AST, e.g. full sqlite3.c)
            if file_size(tmp_ast) > 16000000 && str_len(out_path) > 0:
                src_rc := sa_translate_streaming(tmp_ast, path_stem(in_path), raw_c, raw_h, out_path)
                if src_rc == 0:
                    print_str(str_concat("wrote ", out_path))
                    return
            ast_json := read_file(tmp_ast)
            translated = clang_ast_translate(ast_json, path_stem(in_path), raw_c, raw_h)
            if auto_deps:
                deps := discover_source_deps(in_path, raw_c, inc_dirs)
                mut imported_fns := map_new()
                mut import_mods := list_new()
                mut di := 0
                while di < len(deps):
                    dep_c := deps[di]
                    dep_stem := path_stem(dep_c)
                    dep_ast := "/tmp/c2lpp_dep_ast.json"
                    dep_cmd := str_concat("clang -Xclang -ast-dump=json -fsyntax-only ", str_concat(flags_str, str_concat(" ", str_concat(dep_c, str_concat(" > ", str_concat(dep_ast, " 2>/dev/null"))))))
                    drc := system(dep_cmd)
                    if drc == 0 && file_exists(dep_ast) != 0:
                        d_json := read_file(dep_ast)
                        d_raw_c := read_file(dep_c)
                        d_h := path_with_h(dep_c)
                        mut d_raw_h := ""
                        if str_len(d_h) > 0 && file_exists(d_h) != 0:
                            d_raw_h = read_file(d_h)
                        dep_lpp := clang_ast_translate(d_json, dep_stem, d_raw_c, d_raw_h)
                        cat_collect_translated_fn_names(dep_lpp, imported_fns)
                        list_push(import_mods, str_concat(dep_stem, ""))
                        mut dep_out := str_concat(path_dir(out_path), str_concat("/", str_concat(dep_stem, ".lpp")))
                        if str_len(out_path) == 0:
                            dep_out = str_concat(dep_stem, ".lpp")
                        write_file(dep_out, dep_lpp)
                        print_str(str_concat("auto-translated C dependency -> ", dep_out))
                    di = di + 1
                if len(import_mods) > 0:
                    translated = cat_strip_imported_externs(translated, imported_fns, import_mods)
        else:
            translated = c2lpp_translate_impl(raw_c)
        if str_len(out_path) > 0:
            write_file(out_path, translated)
            print_str(str_concat("wrote ", out_path))
        else:
            print_str(translated)
        return

    src := read_file(first)
    translated := c2lpp_translate(src)
    if argc >= 4 && args_get(2) == "-o":
        write_file(args_get(3), translated)
        print_str(str_concat("wrote ", args_get(3)))
    else:
        print_str(translated)

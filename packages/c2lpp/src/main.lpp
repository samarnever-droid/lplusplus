# main.lpp — c2lpp pure-L++ entry point

import header_parser
import source_translator

def c2lpp_fail(message: Str) -> Void:
    print_str(str_concat("c2lpp error: ", message))

def c2lpp_package_manifest(name: Str, library: Str) -> Str:
    mut out := "[package]\n"
    out = str_concat(out, str_concat("name = \"", str_concat(name, "\"\n")))
    out = str_concat(out, "version = \"0.1.0\"\n")
    out = str_concat(out, "edition = \"2026\"\n\n")
    out = str_concat(out, "[native]\n")
    out = str_concat(out, str_concat("link = \"", str_concat(library, "\"\n")))
    return out

def c2lpp_pure_manifest(name: Str) -> Str:
    mut out := "[package]\n"
    out = str_concat(out, str_concat("name = \"", str_concat(name, "\"\n")))
    out = str_concat(out, "version = \"0.2.0-experimental\"\n")
    out = str_concat(out, "edition = \"2026\"\n")
    return out

def c2lpp_make_output_dir(output_dir: Str) -> Int:
    os_name := env_get("OS")
    mut command := str_concat("mkdir -p ", str_concat(output_dir, "/src"))
    if str_find(os_name, "Windows") >= 0:
        command = str_concat("mkdir ", str_concat(output_dir, "\\src"))
    return command_exec(command)

def c2lpp_translation_readme(name: Str, source: Str) -> Str:
    mut out := str_concat("# ", str_concat(name, " experimental pure-L++ translation\n\n"))
    out = str_concat(out, str_concat("Translated from `", str_concat(source, "` by c2lpp Phase 2.\n\n")))
    out = str_concat(out, "Only the audited scalar subset is translated. Search for `c2lpp phase2 unsupported` before using the result.\n")
    return out

def c2lpp_package_readme(name: Str, header: Str, library: Str) -> Str:
    mut out := str_concat("# ", str_concat(name, " L++ native bindings\n\n"))
    out = str_concat(out, "Generated by c2lpp from a C header.\n\n")
    out = str_concat(out, str_concat("- Header: `", str_concat(header, "`\n")))
    out = str_concat(out, str_concat("- Native library: `", str_concat(library, "`\n")))
    out = str_concat(out, "- Import `src/bindings.lpp` from an L++ project.\n")
    out = str_concat(out, "- Review generated `c2lpp skipped` comments before production use.\n")
    return out

def main():
    mut mode := env_get("C2LPP_MODE")
    if str_len(mode) == 0:
        mode = "bindings"

    mut input_path := env_get("C2LPP_HEADER")
    if text_eq(mode, "translate"):
        source_path := env_get("C2LPP_SOURCE")
        if str_len(source_path) > 0:
            input_path = source_path
    if str_len(input_path) == 0:
        c2lpp_fail("set C2LPP_HEADER, or C2LPP_SOURCE in translate mode")
        return
    if !text_safe_shell_atom(input_path):
        c2lpp_fail("input path contains unsupported shell characters or spaces")
        return

    mut package_name := env_get("C2LPP_NAME")
    if str_len(package_name) == 0:
        package_name = "clib"
    if !text_is_identifier(package_name):
        c2lpp_fail("C2LPP_NAME must be an identifier")
        return

    mut library := env_get("C2LPP_LIB")
    if str_len(library) == 0:
        library = package_name
    if !text_safe_shell_atom(library):
        c2lpp_fail("C2LPP_LIB contains unsupported characters")
        return

    mut output_dir := env_get("C2LPP_OUT")
    if str_len(output_dir) == 0:
        output_dir = str_concat("generated/", package_name)
    if !text_safe_shell_atom(output_dir):
        c2lpp_fail("C2LPP_OUT contains unsupported shell characters or spaces")
        return

    raw_header := read_file(input_path)
    if str_len(raw_header) == 0:
        c2lpp_fail(str_concat("could not read input: ", input_path))
        return

    if c2lpp_make_output_dir(output_dir) != 0:
        c2lpp_fail("could not create output directory")
        return

    if text_eq(mode, "translate"):
        translated := c_translate_source(raw_header)
        unsupported := text_count(translated, "c2lpp phase2 unsupported")
        translated_path := str_concat(output_dir, "/src/translated.lpp")
        root_translated_path := str_concat(output_dir, "/translated.lpp")
        report_path := str_concat(output_dir, "/c2lpp.translation-report.txt")
        report := str_concat("unsupported_constructs=", str_concat(int_to_str(unsupported), "\n"))
        if write_file(translated_path, translated) != 0:
            c2lpp_fail("failed to write translated L++ source")
            return
        write_file(root_translated_path, translated)
        write_file(report_path, report)
        write_file(str_concat(output_dir, "/lpp.toml"), c2lpp_pure_manifest(package_name))
        write_file(str_concat(output_dir, "/README.md"), c2lpp_translation_readme(package_name, input_path))
        print_str(str_concat("c2lpp Phase 2 generated: ", translated_path))
        print_str(str_concat("unsupported constructs: ", int_to_str(unsupported)))
        if text_eq(env_get("C2LPP_STRICT"), "1") && unsupported > 0:
            c2lpp_fail("strict translation rejected unsupported constructs")
        return

    if !text_eq(mode, "bindings"):
        c2lpp_fail("C2LPP_MODE must be bindings or translate")
        return

    mut declaration_header := raw_header
    use_cpp := env_get("C2LPP_CPP")
    if !text_eq(use_cpp, "0"):
        mut cc := env_get("C2LPP_CC")
        if str_len(cc) == 0:
            cc = "cc"
        if !text_safe_shell_atom(cc):
            c2lpp_fail("C2LPP_CC contains unsupported characters")
            return
        cpp_command := str_concat(cc, str_concat(" -E ", input_path))
        preprocessed := command_output(cpp_command)
        filtered := c_filter_preprocessed(preprocessed, input_path)
        if str_len(str_trim(filtered)) > 0:
            declaration_header = filtered
        else:
            print_str("c2lpp warning: preprocessor returned no text; parsing raw header")

    bindings := c_generate_bindings(raw_header, declaration_header, library)
    dependencies := c_emit_dependencies(raw_header)

    bindings_path := str_concat(output_dir, "/src/bindings.lpp")
    root_bindings_path := str_concat(output_dir, "/bindings.lpp")
    manifest_path := str_concat(output_dir, "/lpp.toml")
    readme_path := str_concat(output_dir, "/README.md")
    deps_path := str_concat(output_dir, "/c2lpp.dependencies.txt")

    if write_file(bindings_path, bindings) != 0:
        c2lpp_fail("failed to write generated bindings")
        return
    write_file(root_bindings_path, bindings)
    write_file(manifest_path, c2lpp_package_manifest(package_name, library))
    write_file(readme_path, c2lpp_package_readme(package_name, input_path, library))
    write_file(deps_path, dependencies)

    print_str(str_concat("c2lpp generated package: ", output_dir))
    print_str(str_concat("bindings: ", bindings_path))

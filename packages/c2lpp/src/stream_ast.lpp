# stream_ast.lpp — Constant-Memory Streaming Clang 18 JSON AST Translator for Massive C Codebases
#
# Streams 500MB–2GB Clang JSON AST dumps (e.g. full 261,454-line SQLite `sqlite3.c`
# amalgamation, PostgreSQL backend modules) line-by-line with < 50 MB peak RAM:
# - Pass 1: Collects all target structs, typedefs, globals, and function signatures
#           while skipping `"range"` and `"CompoundStmt"` blocks on the fly.
# - Pass 2: Streams one `FunctionDecl` at a time into `jl_parse_node`, translates it
#           with `CatCtx` / `cat_lower_stmt`, and writes directly to the output file.

import cspan
import json_ast
import clang_ast_translator
import c_runtime_shims
import native_types
import translator

extern "C":
    def fopen(path: Str, mode: Str) -> RawPtr
    def fgets(buf: Ptr[U8], n: I32, fp: RawPtr) -> RawPtr
    def fputs(s: Str, fp: RawPtr) -> I32
    def fclose(fp: RawPtr) -> I32
    def lpp_str_trim(s: Ptr[U8]) -> Str

def sa_read_top_block(fp: RawPtr, buf: Ptr[U8], first_line: Str) -> List[Str]:
    # Read lines of one top-level `    { ...    }` declaration, skipping `"range": { ... }`
    # blocks on the fly to cut memory and parse time by ~4x.
    mut out := list_new()
    list_push(out, first_line)
    mut skip_range := false
    mut rdepth := 0
    while true:
        unsafe:
            res := fgets(buf, 8192 as I32, fp)
            if ptr_is_null(res as Ptr[U8]):
                break
            t := lpp_str_trim(buf)
            if skip_range:
                if str_ends_with(t, "{") || str_ends_with(t, "["):
                    rdepth = rdepth + 1
                if str_starts_with(t, "}") || str_starts_with(t, "]"):
                    rdepth = rdepth - 1
                    if rdepth <= 0:
                        skip_range = false
                continue
            if t == "\"range\": {":
                skip_range = true
                rdepth = 1
                continue
            # Detect exact 4-space closing brace `    }` or `    },`
            mut is_top_close := false
            b0 := ptr_read[U8](buf) as Int
            b1 := ptr_read[U8](ptr_add[U8](buf, 1 as USize)) as Int
            b2 := ptr_read[U8](ptr_add[U8](buf, 2 as USize)) as Int
            b3 := ptr_read[U8](ptr_add[U8](buf, 3 as USize)) as Int
            b4 := ptr_read[U8](ptr_add[U8](buf, 4 as USize)) as Int
            if b0 == 32 && b1 == 32 && b2 == 32 && b3 == 32 && b4 == 125:
                is_top_close = true
            list_push(out, t)
            if is_top_close:
                break
    return out

def sa_is_top_open(buf: Ptr[U8]) -> Bool:
    unsafe:
        b0 := ptr_read[U8](buf) as Int
        b1 := ptr_read[U8](ptr_add[U8](buf, 1 as USize)) as Int
        b2 := ptr_read[U8](ptr_add[U8](buf, 2 as USize)) as Int
        b3 := ptr_read[U8](ptr_add[U8](buf, 3 as USize)) as Int
        b4 := ptr_read[U8](ptr_add[U8](buf, 4 as USize)) as Int
        return b0 == 32 && b1 == 32 && b2 == 32 && b3 == 32 && b4 == 123

def sa_translate_streaming(ast_path: Str, stem: Str, raw_c: Str, raw_h: Str, out_path: Str) -> Int:
    c_suffix := str_concat(stem, ".c")
    h_suffix := str_concat(stem, ".h")

    mut consts_list := list_new()
    mut emitted_consts := map_new()
    mut count_defines := cat_collect_defines(raw_h, emitted_consts, consts_list)
    count_defines = count_defines + cat_collect_defines(raw_c, emitted_consts, consts_list)

    mut str_pool := list_new()
    mut anon_names := map_new()
    mut defined_structs := map_new()
    mut field_types := map_new()
    mut fn_ret_types := map_new()
    mut fn_param_types := map_new()
    mut global_types := map_new()
    mut struct_parts := list_new()
    mut struct_count := 0

    buf_span := cspan_alloc_bytes(8192)
    buf := cspan_as_u8_ptr(buf_span)

    # --- PASS 1: Stream top-level declarations to collect structs, globals, and function signatures ---
    mut fp1 := cspan_empty().base
    unsafe:
        fp1 = fopen(ast_path, "r")
        if ptr_is_null(fp1 as Ptr[U8]):
            cspan_free(buf_span)
            return 1

    mut cur_file := ""
    mut in_target := false
    mut top_kind := ""
    mut top_id := ""
    mut top_name := ""
    mut top_implicit := false
    mut in_record_block := false
    mut rec_lines := list_new()
    mut in_fn_sig := false
    mut fn_sig_name := ""
    mut fn_sig_qt := ""
    mut fn_sig_dt := ""
    mut fn_param_idx := 0
    mut in_parm := false
    mut parm_qt := ""
    mut parm_dt := ""
    mut in_typedef := false
    mut td_name := ""

    while true:
        mut eof := false
        mut is_open := false
        mut t := ""
        unsafe:
            res := fgets(buf, 8192 as I32, fp1)
            if ptr_is_null(res as Ptr[U8]):
                eof = true
            else:
                is_open = sa_is_top_open(buf)
                t = lpp_str_trim(buf)
        if eof:
            break

        if is_open:
            # Flush previous RecordDecl if any
            if in_record_block && len(rec_lines) > 2:
                mut rnodes := list_new()
                rr := jl_parse_node(rec_lines, 0, rnodes)
                rnd := rnodes[rr.0]
                if !rnd.is_implicit:
                    mut has_f := false
                    mut ci := 0
                    while ci < len(rnd.children):
                        if rnodes[rnd.children[ci]].kind == "FieldDecl":
                            has_f = true
                            break
                        ci = ci + 1
                    if has_f:
                        mut sname := rnd.name
                        if str_len(sname) == 0 && map_has(anon_names, rnd.id_str):
                            sname = sm_get(anon_names, str_pool, rnd.id_str)
                        if str_len(sname) > 0 && !map_has(defined_structs, sname):
                            map_put(defined_structs, sname, 1)
                            mut f_lines := list_new()
                            mut null_args := list_new()
                            mut new_args := list_new()
                            ci = 0
                            while ci < len(rnd.children):
                                cnd := rnodes[rnd.children[ci]]
                                if cnd.kind == "FieldDecl" && str_len(cnd.name) > 0:
                                    fname := tr_escape_ident(cnd.name)
                                    fty := cat_map_type(cnd.desug_type, cnd.qual_type, defined_structs)
                                    sm_put(field_types, str_pool, str_concat(sname, str_concat(".", fname)), fty)
                                    list_push(f_lines, str_concat("    ", str_concat(fname, str_concat(": ", str_concat(fty, "\n")))))
                                    if map_has(defined_structs, fty):
                                        list_push(null_args, "0")
                                        list_push(new_args, cat_default_expr(fty))
                                    else:
                                        def_e := cat_default_expr(fty)
                                        list_push(null_args, str_concat(def_e, ""))
                                        list_push(new_args, def_e)
                                ci = ci + 1
                            if len(f_lines) > 0:
                                list_push(f_lines, "    is_null: Bool\n")
                                na_true := str_concat(str_join(null_args, ", "), ", true")
                                na_false := str_concat(str_join(new_args, ", "), ", false")
                                list_push(struct_parts, str_concat("struct ", str_concat(sname, str_concat(":\n", str_concat(str_join(f_lines, ""), "\n")))))
                                list_push(struct_parts, str_concat("def ", str_concat(sname, str_concat("_null() -> ", str_concat(sname, str_concat(":\n    return ", str_concat(sname, str_concat("(", str_concat(na_true, ")\n\n")))))))))
                                list_push(struct_parts, str_concat("def ", str_concat(sname, str_concat("_new() -> ", str_concat(sname, str_concat(":\n    return ", str_concat(sname, str_concat("(", str_concat(na_false, ")\n\n")))))))))
                                struct_count = struct_count + 1
            in_record_block = false
            in_fn_sig = false
            in_parm = false
            in_typedef = false
            top_kind = ""
            top_id = ""
            top_name = ""
            top_implicit = false
            continue

        if in_record_block:
            list_push(rec_lines, t)
            continue

        # Track top-level loc.file (8-space indent)
        if str_starts_with(t, "\"file\": \""):
            unsafe:
                b0 := ptr_read[U8](buf) as Int
                b7 := ptr_read[U8](ptr_add[U8](buf, 7 as USize)) as Int
                b8 := ptr_read[U8](ptr_add[U8](buf, 8 as USize)) as Int
                if b0 == 32 && b7 == 32 && b8 == 34 && !top_implicit:
                    cur_file = jl_extract_val(t)
                    in_target = str_ends_with(cur_file, c_suffix) || str_ends_with(cur_file, h_suffix)
            continue

        # Check 6-space top-level properties
        mut is_col6 := false
        unsafe:
            c0 := ptr_read[U8](buf) as Int
            c5 := ptr_read[U8](ptr_add[U8](buf, 5 as USize)) as Int
            c6 := ptr_read[U8](ptr_add[U8](buf, 6 as USize)) as Int
            if c0 == 32 && c5 == 32 && c6 == 34:
                is_col6 = true

        if is_col6:
            if str_starts_with(t, "\"id\":"):
                top_id = jl_extract_val(t)
            elif str_starts_with(t, "\"kind\":"):
                top_kind = jl_extract_val(t)
                if in_target && top_kind == "RecordDecl":
                    in_record_block = true
                    rec_lines = list_new()
                    list_push(rec_lines, "{")
                    list_push(rec_lines, str_concat("\"id\": \"", str_concat(top_id, "\",")))
                    list_push(rec_lines, t)
                elif in_target && top_kind == "FunctionDecl":
                    in_fn_sig = true
                    fn_sig_name = ""
                    fn_sig_qt = ""
                    fn_sig_dt = ""
                    fn_param_idx = 0
                elif in_target && top_kind == "TypedefDecl":
                    in_typedef = true
                    td_name = ""
            elif str_starts_with(t, "\"isImplicit\":") || str_starts_with(t, "\"implicit\":"):
                if jl_extract_val(t) == "true":
                    top_implicit = true
            elif str_starts_with(t, "\"name\":"):
                top_name = jl_extract_val(t)
                if in_fn_sig:
                    fn_sig_name = top_name
                elif in_typedef:
                    td_name = top_name
            continue

        if in_typedef && str_starts_with(t, "\"id\":") && str_len(td_name) > 0:
            sm_put(anon_names, str_pool, jl_extract_val(t), td_name)
            continue

        if in_fn_sig:
            if str_starts_with(t, "\"qualType\":") && str_len(fn_sig_qt) == 0 && !in_parm:
                fn_sig_qt = jl_extract_val(t)
                if str_len(fn_sig_name) > 0:
                    safe_fn := cat_escape_fn(fn_sig_name)
                    mut rqual := fn_sig_qt
                    lp := str_find(rqual, "(")
                    if lp > 0:
                        rqual = str_trim(str_substr(rqual, 0, lp))
                    rty := cat_map_type(rqual, rqual, defined_structs)
                    sm_put(fn_ret_types, str_pool, safe_fn, rty)
            elif t == "\"kind\": \"ParmVarDecl\",":
                in_parm = true
                parm_qt = ""
                parm_dt = ""
            elif in_parm && str_starts_with(t, "\"qualType\":"):
                parm_qt = jl_extract_val(t)
                if str_len(fn_sig_name) > 0:
                    safe_fn := cat_escape_fn(fn_sig_name)
                    pty := cat_map_type(parm_qt, parm_qt, defined_structs)
                    sm_put(fn_param_types, str_pool, str_concat(safe_fn, str_concat("#", int_to_str(fn_param_idx))), pty)
                    fn_param_idx = fn_param_idx + 1
                    in_parm = false
            elif t == "\"kind\": \"CompoundStmt\",":
                in_fn_sig = false

    unsafe:
        fclose(fp1)

    # --- PASS 2: Stream one FunctionDecl at a time and emit translated L++ to a temp body file ---
    body_tmp := "/tmp/c2lpp_stream_body.lpp"
    mut fp_body := cspan_empty().base
    mut fp2 := cspan_empty().base
    unsafe:
        fp_body = fopen(body_tmp, "w")
        fp2 = fopen(ast_path, "r")
        if ptr_is_null(fp_body as Ptr[U8]) || ptr_is_null(fp2 as Ptr[U8]):
            cspan_free(buf_span)
            return 1

    mut ctx := CatCtx(list_new(), str_pool, defined_structs, field_types, fn_ret_types, fn_param_types, global_types, map_new(), "", 0, list_new(), list_new(), map_new(), false, map_new(), list_new())
    mut emitted_fns := map_new()
    mut count_seen := 0
    mut count_translated := 0
    cur_file = ""
    in_target = false

    while true:
        mut eof := false
        mut is_open := false
        mut t := ""
        unsafe:
            res := fgets(buf, 8192 as I32, fp2)
            if ptr_is_null(res as Ptr[U8]):
                eof = true
            else:
                is_open = sa_is_top_open(buf)
                t = lpp_str_trim(buf)
        if eof:
            break

        if !is_open:
            continue

        # Peek the first few lines of this top-level node to see if it's a target FunctionDecl or VarDecl
        blk := sa_read_top_block(fp2, buf, "{")
        mut blk_kind := ""
        mut blk_file := ""
        mut blk_implicit := false
        mut blk_has_body := false
        mut bi := 1
        bn := len(blk)
        while bi < bn && bi < 40:
            bl := blk[bi]
            if str_starts_with(bl, "\"kind\":") && str_len(blk_kind) == 0:
                blk_kind = jl_extract_val(bl)
            elif str_starts_with(bl, "\"file\":") && str_len(blk_file) == 0:
                blk_file = jl_extract_val(bl)
            elif str_starts_with(bl, "\"isImplicit\":") || str_starts_with(bl, "\"implicit\":"):
                if jl_extract_val(bl) == "true":
                    blk_implicit = true
            bi = bi + 1
        if !blk_implicit && str_len(blk_file) > 0:
            cur_file = blk_file
            in_target = str_ends_with(cur_file, c_suffix) || str_ends_with(cur_file, h_suffix)
        if !in_target || blk_implicit:
            continue
        if blk_kind == "FunctionDecl":
            # Check if this FunctionDecl has a CompoundStmt body
            mut ci := 0
            while ci < bn:
                if blk[ci] == "\"kind\": \"CompoundStmt\",":
                    blk_has_body = true
                    break
                ci = ci + 1
            if !blk_has_body:
                continue
            count_seen = count_seen + 1
            mut fnodes := list_new()
            pr := jl_parse_node(blk, 0, fnodes)
            fnd := fnodes[pr.0]
            if str_len(fnd.name) == 0:
                continue
            safe_fn := cat_escape_fn(fnd.name)
            if map_has(emitted_fns, safe_fn):
                continue
            map_put(emitted_fns, safe_fn, 1)

            mut rty := "Int"
            if map_has(ctx.fn_ret_types, safe_fn):
                rty = sm_get(ctx.fn_ret_types, ctx.str_pool, safe_fn)
            mut pnames := list_new()
            mut ptypes := list_new()
            mut local_types := map_new()
            mut body_id := -1
            ci = 0
            while ci < len(fnd.children):
                cnd := fnodes[fnd.children[ci]]
                if cnd.kind == "ParmVarDecl":
                    mut pn := tr_escape_ident(cnd.name)
                    if str_len(pn) == 0:
                        pn = str_concat("_p", int_to_str(len(pnames)))
                    pty := cat_map_type(cnd.desug_type, cnd.qual_type, ctx.defined_structs)
                    sm_put(local_types, ctx.str_pool, pn, pty)
                    list_push(pnames, str_concat(pn, ""))
                    list_push(ptypes, str_concat(pty, ""))
                elif cnd.kind == "CompoundStmt":
                    body_id = fnd.children[ci]
                ci = ci + 1
            if body_id < 0:
                continue

            ctx.nodes = fnodes
            body_node := ctx.nodes[body_id]
            mut label_positions := list_new()
            mut goto_labels := map_new()
            mut si := 0
            while si < len(body_node.children):
                snd := ctx.nodes[body_node.children[si]]
                if snd.kind == "LabelStmt":
                    lid_num := len(label_positions) + 1
                    list_push(label_positions, si)
                    if str_len(snd.val_str) > 0:
                        map_put(goto_labels, snd.val_str, lid_num)
                si = si + 1

            ctx.local_types = local_types
            ctx.cur_ret_ty = rty
            ctx.temp_id = 0
            ctx.pre_stmts = list_new()
            ctx.post_stmts = list_new()
            ctx.goto_labels = goto_labels
            ctx.has_goto = len(label_positions) > 0
            mut body_lines := list_new()
            if len(label_positions) > 0:
                first_lpos := label_positions[0]
                list_push(body_lines, "    mut _goto_target: Int = 0\n")
                mut first_non_decl := 0
                while first_non_decl < first_lpos && ctx.nodes[body_node.children[first_non_decl]].kind == "DeclStmt":
                    cat_lower_stmt(ctx, body_node.children[first_non_decl], body_lines, 1)
                    first_non_decl = first_non_decl + 1
                list_push(body_lines, "    while true:\n")
                mut k := first_non_decl
                while k < first_lpos:
                    cat_lower_stmt(ctx, body_node.children[k], body_lines, 2)
                    k = k + 1
                list_push(body_lines, "        break\n")
                ctx.has_goto = false
                mut li := 0
                nlabels := len(label_positions)
                while li < nlabels:
                    lstart := label_positions[li]
                    mut lend := len(body_node.children)
                    if li + 1 < nlabels:
                        lend = label_positions[li + 1]
                    lid_num := li + 1
                    if li == 0:
                        list_push(body_lines, str_concat("    if _goto_target == ", str_concat(int_to_str(lid_num), " || _goto_target == 0:\n")))
                    else:
                        list_push(body_lines, str_concat("    elif _goto_target == ", str_concat(int_to_str(lid_num), ":\n")))
                    mut m := lstart
                    while m < lend:
                        cat_lower_stmt(ctx, body_node.children[m], body_lines, 2)
                        m = m + 1
                    li = li + 1
                if rty != "Void":
                    list_push(body_lines, str_concat("    return ", str_concat(cat_default_expr(rty), "\n")))
            else:
                mut k := 0
                while k < len(body_node.children):
                    cat_lower_stmt(ctx, body_node.children[k], body_lines, 1)
                    k = k + 1

            body_text := str_join(body_lines, "")
            mut p_sig := list_new()
            mut mut_prelude := list_new()
            mut pk := 0
            while pk < len(pnames):
                pn_i := pnames[pk]
                pt_i := ptypes[pk]
                needs_mut := str_contains(body_text, str_concat("    ", str_concat(pn_i, " = "))) || str_contains(body_text, str_concat("    ", str_concat(pn_i, "."))) || str_contains(body_text, str_concat("c2lpp_cur_write_inc(", pn_i)) || str_contains(body_text, str_concat("c2lpp_cur_read_inc(", pn_i)) || str_contains(body_text, str_concat("c2lpp_cur_set(", pn_i))
                if needs_mut:
                    arg_n := str_concat(pn_i, "_arg")
                    list_push(p_sig, str_concat(arg_n, str_concat(": ", pt_i)))
                    if pt_i == "ByteCursor":
                        list_push(mut_prelude, str_concat("    mut ", str_concat(pn_i, str_concat(": ByteCursor = c2lpp_cur_add(", str_concat(arg_n, ", 0)\n")))))
                    else:
                        list_push(mut_prelude, str_concat("    mut ", str_concat(pn_i, str_concat(": ", str_concat(pt_i, str_concat(" = ", str_concat(arg_n, "\n")))))))
                else:
                    list_push(p_sig, str_concat(pn_i, str_concat(": ", pt_i)))
                pk = pk + 1

            mut sig := str_concat("def ", str_concat(safe_fn, str_concat("(", str_concat(str_join(p_sig, ", "), ")"))))
            if rty != "Void":
                sig = str_concat(sig, str_concat(" -> ", rty))
            sig = str_concat(sig, ":\n")
            unsafe:
                fputs(sig, fp_body)
                fputs(str_join(mut_prelude, ""), fp_body)
                if str_len(str_trim(body_text)) == 0:
                    if rty == "Void":
                        fputs("    _ := 0\n\n", fp_body)
                    else:
                        fputs(str_concat("    return ", str_concat(cat_default_expr(rty), "\n\n")), fp_body)
                else:
                    fputs(str_concat(body_text, "\n"), fp_body)
            count_translated = count_translated + 1

    unsafe:
        fclose(fp2)
        fclose(fp_body)

    # --- Assemble final output file: header + consts + extern "C" bridge + shims + structs + streamed functions ---
    structs_str := str_join(struct_parts, "")
    body_all := read_file(body_tmp)
    shims_str := c2lpp_emit_runtime_shims(str_concat(structs_str, body_all))

    mut fp_out := cspan_empty().base
    unsafe:
        fp_out = fopen(out_path, "w")
        if ptr_is_null(fp_out as Ptr[U8]):
            cspan_free(buf_span)
            return 1
        if len(ctx.ext_calls_decls) > 0:
            fputs("# Translated to native L++ by c2lpp v0.8.0 (Pure-L++ Streaming Clang AST Frontend + Auto OS/C-Lib Bridge)\n", fp_out)
        else:
            fputs("# Translated to pure safe L++ by c2lpp v0.8.0 (Pure-L++ Streaming Clang AST Frontend, Zero extern \"C\", Zero unsafe)\n", fp_out)
        fputs(str_concat("# stats: defines=", str_concat(int_to_str(count_defines), str_concat(" structs=", str_concat(int_to_str(struct_count), str_concat(" funcs_translated=", str_concat(int_to_str(count_translated), str_concat(" funcs_seen=", str_concat(int_to_str(count_seen), str_concat(" os_externs=", str_concat(int_to_str(len(ctx.ext_calls_decls)), "\n\n")))))))))), fp_out)
        if len(consts_list) > 0:
            fputs(str_join(consts_list, ""), fp_out)
            fputs("\n", fp_out)
        if len(ctx.ext_calls_decls) > 0:
            fputs("# Auto-bridged OS / external C library calls (no local .c source available)\nextern \"C\":\n", fp_out)
            fputs(str_join(ctx.ext_calls_decls, ""), fp_out)
            fputs("\n", fp_out)
        if str_len(shims_str) > 0:
            fputs(shims_str, fp_out)
        if str_len(structs_str) > 0:
            fputs(structs_str, fp_out)
        fputs(body_all, fp_out)
        fclose(fp_out)

    cspan_free(buf_span)
    return 0

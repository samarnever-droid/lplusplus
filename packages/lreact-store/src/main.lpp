# Test suite for lreact-store package
import workspace_store

def main():
    print_str("Testing lreact-store workspace manager...")

    meta := workspace_meta_new("Cosmos Theory", "Samar", "1.0.0", "midnight")
    
    nodes_raw := "{\"id\": 1, \"title\": \"Cosmos Note\", \"x\": 100, \"y\": 200}"
    edges_raw := "{\"id\": 1, \"from\": 1, \"to\": 2}"
    
    ws_json := workspace_serialize(meta, nodes_raw, edges_raw)
    
    print_str("Serialized Workspace Container:")
    print_str(ws_json)

    # Test file persistence
    save_res := workspace_save_file("test_workspace.sbook", ws_json)
    if save_res == 0:
        print_str("Workspace saved successfully to 'test_workspace.sbook'")

    loaded_content := workspace_load_file("test_workspace.sbook")
    if str_len(loaded_content) > 0:
        print_str("Workspace loaded successfully from disk!")

    delete_file("test_workspace.sbook")
    print_str("SUCCESS: lreact-store package verified and 100% operational!")

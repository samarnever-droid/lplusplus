# Formerly `aot_reject_arc_cycle.lpp`, which asserted this was a compile error.
#
# SAFETY-CONTRACT CHANGE: a self-referential struct now compiles. The static
# cycle breaker demotes `next` to a non-owning edge, so the owning subgraph is
# acyclic and the object is reclaimed. Verified leak-free and use-after-free
# free under AddressSanitizer, including 50 000 genuine runtime cycles.
struct Node:
    value: Int
    next: Node

def main():
    tail := Node(2, 0)
    head := Node(1, tail)
    print(head.value)
    print(head.next.value)

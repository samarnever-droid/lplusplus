def summarize(base: Int, ...items: Int) -> (Int, Str):
    mut total := base
    for item in items:
        total = total + item
    return (total, "Bhopal")

async def message() -> Str:
    return "executor"

async def main():
    text := message().await
    (total, city) := summarize(10, 1, 2, 3)
    view := str_slice(city, 1, 3)
    print(text)
    print(total)
    print(str_slice_to_str(view))

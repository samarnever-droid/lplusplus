# Recursive data structures.
#
# The types below can form runtime reference cycles, so the ownership plan
# classifies them Shared (collectible). Every edge stays owning: acyclic
# values free promptly by refcount, and unreachable cycles are reclaimed by
# the runtime trial-deletion collector (documentation/CYCLE_BREAKING.md).
# This file pins that declaring and building these structures is accepted
# and evaluates correctly; cycle *reclamation* evidence lives in
# crates/lpp-ownership/tests/cycle_breaking.rs and tests/cycle_churn.lpp
# (ASan/LSan + flat RSS over 200k churned cycles).

struct TreeNode:
    value: Int
    left: TreeNode
    right: TreeNode

struct Cell:
    value: Int
    next: Cell

struct Child:
    tag: Int
    parent: Parent

struct Parent:
    tag: Int
    kid: Child

def tree_root() -> Int:
    l := TreeNode(1, 0, 0)
    r := TreeNode(2, 0, 0)
    root := TreeNode(10, l, r)
    return root.value + root.left.value + root.right.value

def list_sum() -> Int:
    c3 := Cell(3, 0)
    c2 := Cell(2, c3)
    c1 := Cell(1, c2)
    return c1.value + c1.next.value + c1.next.next.value

def main():
    print(tree_root())
    print(list_sum())

    # Mutual reference between two distinct types.
    c := Child(2, 0)
    p := Parent(1, c)
    print(p.tag)
    print(p.kid.tag)

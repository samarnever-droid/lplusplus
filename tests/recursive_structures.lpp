# Recursive data structures, made possible by static cycle breaking.
#
# All of these were compile errors before: "Cyclic owned struct detected. ARC
# cannot reclaim ownership cycles." The fix is not to allow leaks but to ensure
# no *owning* cycle is ever built -- analysis::cyclebreak demotes exactly one
# edge of every cycle to non-owning, so the owning subgraph is acyclic by
# construction and refcounts still reach zero.
#
# Verified under AddressSanitizer: zero leaks, zero use-after-free, including
# 50 000 genuine A<->B runtime cycles. Verified under ThreadSanitizer: zero
# races with four threads building and tearing down cyclic structures.

struct TreeNode:
    value: Int
    left: TreeNode
    right: TreeNode

struct Cell:
    value: Int
    next: Cell

struct Child:
    tag: Int
    parent: Parent

struct Parent:
    tag: Int
    kid: Child

def tree_root() -> Int:
    l := TreeNode(1, 0, 0)
    r := TreeNode(2, 0, 0)
    root := TreeNode(10, l, r)
    return root.value + root.left.value + root.right.value

def list_sum() -> Int:
    c3 := Cell(3, 0)
    c2 := Cell(2, c3)
    c1 := Cell(1, c2)
    return c1.value + c1.next.value + c1.next.next.value

def main():
    print(tree_root())
    print(list_sum())

    # Mutual reference between two distinct types.
    c := Child(2, 0)
    p := Parent(1, c)
    print(p.tag)
    print(p.kid.tag)

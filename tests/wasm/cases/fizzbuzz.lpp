# fizzbuzz.lpp — while + if/elif/else + mixed int/string printing.

def main():
    mut i := 1
    while i <= 15:
        if i % 15 == 0:
            print_str("FizzBuzz")
        elif i % 3 == 0:
            print_str("Fizz")
        elif i % 5 == 0:
            print_str("Buzz")
        else:
            print(i)
        i = i + 1

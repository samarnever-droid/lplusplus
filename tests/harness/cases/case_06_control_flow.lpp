def compute_matrix_sum(rows: Int, cols: Int) -> Int:
    mut total := 0
    mut r := 0
    while r < rows:
        mut c := 0
        while c < cols:
            val := (r + 1) * (c + 1)
            total = total + val
            c = c + 1
        r = r + 1
    return total

def main():
    res := compute_matrix_sum(5, 5)
    print_str("Matrix 5x5 sum:\n")
    print(res)
    if res == 225:
        print_str("PASS_CONTROL_FLOW\n")
    else:
        print_str("FAIL_CONTROL_FLOW\n")

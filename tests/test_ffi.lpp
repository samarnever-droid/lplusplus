# FFI — calling C functions directly

extern "C":
    def abs(x: Int) -> Int
    def strlen(s: Str) -> Int

def main():
    # Call C stdlib abs()
    n := abs(-42)
    print(n)

    # Call C stdlib strlen() with borrowed Str
    n_len := strlen("ffi works!")
    print(n_len)

    print("ffi works!")

# lreact.lpp — Lreact (React + L++ Native Framework) in Pure L++
# Built 100% in pure L++ using native sockets, HTTP, and JSON builtins.

import json

struct LreactRequest:
    req_id: Str
    command: Str
    payload: Str

def start_server(port: Int) -> Int:
    listener := net_listen(port)
    if listener <= 0:
        print_str("[Lreact] Error: Failed to bind IPC socket port")
        return -1
    print_str(str_concat("[Lreact] Pure L++ IPC Bridge listening on port ", int_to_str(port)))
    return listener

def make_json_response(body: Str) -> Str:
    len_str := int_to_str(str_len(body))
    mut resp := "HTTP/1.1 200 OK\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Allow-Headers: *\r\nContent-Type: application/json\r\nContent-Length: "
    resp = str_concat(resp, len_str)
    resp = str_concat(resp, "\r\n\r\n")
    resp = str_concat(resp, body)
    return resp

def make_html_response(body: Str) -> Str:
    len_str := int_to_str(str_len(body))
    mut resp := "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: "
    resp = str_concat(resp, len_str)
    resp = str_concat(resp, "\r\n\r\n")
    resp = str_concat(resp, body)
    return resp

def handle_request(client_fd: Int, request_raw: Str) -> Str:
    # Parse HTTP body
    body_idx := str_find(request_raw, "\r\n\r\n")
    if body_idx < 0:
        return "400 Bad Request"

    body := str_substr(request_raw, body_idx + 4, str_len(request_raw) - body_idx - 4)

    # Parse JSON payload: {"id":"1","cmd":"open_file","args":"/path"}
    h_json := json_parse(body)
    if h_json == 0:
        return "400 Invalid JSON"

    req_id := json_get_str(h_json, "id")
    cmd := json_get_str(h_json, "cmd")
    args_str := json_get_str(h_json, "args")

    json_free(h_json)

    # Format result response payload
    return str_concat(req_id, str_concat("|", str_concat(cmd, str_concat("|", args_str))))

def create_response(req_id: Str, json_result: Str) -> Str:
    mut body := str_concat("{\"id\":\"", req_id)
    body = str_concat(body, "\",\"result\":")
    body = str_concat(body, json_result)
    body = str_concat(body, "}")

    mut http_res := "HTTP/1.1 200 OK\r\n"
    http_res = str_concat(http_res, "Content-Type: application/json\r\n")
    http_res = str_concat(http_res, "Access-Control-Allow-Origin: *\r\n")
    http_res = str_concat(http_res, str_concat("Content-Length: ", int_to_str(str_len(body))))
    http_res = str_concat(http_res, "\r\n\r\n")
    http_res = str_concat(http_res, body)
    return http_res

def launch_frontend(url: Str) -> Void:
    print_str(str_concat("[Lreact] Opening frontend container at ", url))
    status := command_exec(str_concat("explorer \"", str_concat(url, "\"")))

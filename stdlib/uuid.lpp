# stdlib/uuid.lpp — UUID v4 generation (random-based)

def uuid4() -> Str:
    # Generate a random UUID v4: xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx
    hex_chars := "0123456789abcdef"
    mut result := ""
    for i in range(32):
        if i == 8 || i == 12 || i == 16 || i == 20:
            result = str_concat(result, "-")
        if i == 12:
            result = str_concat(result, "4")
        elif i == 16:
            # y must be 8, 9, a, or b
            r := random_range(8, 12)
            result = str_concat(result, char_at(hex_chars, r))
        else:
            r := random_range(0, 16)
            result = str_concat(result, char_at(hex_chars, r))
    return result

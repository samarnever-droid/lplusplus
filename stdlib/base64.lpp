# stdlib/base64.lpp — Base64 encoding (pure L++)

const B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

def base64_encode(input: Str) -> Str:
    mut result := ""
    mut i := 0
    len := str_len(input)
    while i < len:
        b0 := ord(char_at(input, i))
        b1 := 0
        b2 := 0
        pad := 0
        if i + 1 < len:
            b1 = ord(char_at(input, i + 1))
        else:
            pad = 2
        if i + 2 < len:
            b2 = ord(char_at(input, i + 2))
        elif pad == 0:
            pad = 1
        # 3 bytes → 4 base64 chars
        idx0 := (b0 >> 2) & 63
        idx1 := ((b0 & 3) << 4) | ((b1 >> 4) & 15)
        idx2 := ((b1 & 15) << 2) | ((b2 >> 6) & 3)
        idx3 := b2 & 63
        result = str_concat(result, char_at(B64_CHARS, idx0))
        result = str_concat(result, char_at(B64_CHARS, idx1))
        if pad >= 2:
            result = str_concat(result, "==")
        elif pad == 1:
            result = str_concat(result, char_at(B64_CHARS, idx2))
            result = str_concat(result, "=")
        else:
            result = str_concat(result, char_at(B64_CHARS, idx2))
            result = str_concat(result, char_at(B64_CHARS, idx3))
        i += 3
    return result

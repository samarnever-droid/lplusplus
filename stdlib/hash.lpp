# stdlib/hash.lpp — Hash functions (pure L++)

def hash_djb2(s: Str) -> Int:
    # DJB2 hash — fast, good distribution for strings
    mut hash := 5381
    for c in s:
        hash = hash * 33 + ord(c)
    # Keep positive
    if hash < 0:
        hash = 0 - hash
    return hash

def hash_fnv1a(s: Str) -> Int:
    # FNV-1a hash — excellent distribution
    mut hash := 2166136261
    for c in s:
        hash = hash ^ ord(c)
        hash = hash * 16777619
    if hash < 0:
        hash = 0 - hash
    return hash

def hash_simple(n: Int) -> Int:
    # Integer hash (splitmix-style)
    mut x := n
    x = x ^ (x >> 16)
    x = x * 73244475
    x = x ^ (x >> 16)
    if x < 0:
        x = 0 - x
    return x

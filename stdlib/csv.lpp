# stdlib/csv.lpp — CSV parser (pure L++)

def csv_split_line(line: Str, sep: Str = ",") -> Int:
    # Split a CSV line into a list of field strings
    fields := list_new()
    mut start := 0
    mut in_quotes := 0
    for i in range(str_len(line)):
        c := char_at(line, i)
        if c == "\"":
            in_quotes = 1 - in_quotes
        elif c == sep && in_quotes == 0:
            field := str_substr(line, start, i - start)
            list_push(fields, field)
            start = i + 1
    # Last field
    if start <= str_len(line):
        field := str_substr(line, start, str_len(line) - start)
        list_push(fields, field)
    return fields

def csv_parse_file(path: Str) -> Int:
    # Parse a CSV file into a list of row-lists
    content := read_file(path)
    rows := list_new()
    mut start := 0
    for i in range(str_len(content)):
        c := char_at(content, i)
        if c == "\n":
            mut line := str_substr(content, start, i - start)
            if str_len(line) > 0 && char_at(line, str_len(line) - 1) == "\r":
                line = str_substr(line, 0, str_len(line) - 1)
            if str_len(line) > 0:
                list_push(rows, csv_split_line(line))
            start = i + 1
    if start < str_len(content):
        line := str_substr(content, start, str_len(content) - start)
        if str_len(line) > 0:
            list_push(rows, csv_split_line(line))
    return rows

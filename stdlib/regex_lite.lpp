# stdlib/regex_lite.lpp — Simple pattern matching (not full regex)
# Supports: * (any chars), ? (single char), literal match

def pattern_match(text: Str, pattern: Str) -> Int:
    # Simple glob-style matching: * = any, ? = single char
    tlen := str_len(text)
    plen := str_len(pattern)
    mut ti := 0
    mut pi := 0
    mut star_pi := -1
    mut star_ti := -1

    while ti < tlen:
        if pi < plen && (char_at(pattern, pi) == char_at(text, ti) || char_at(pattern, pi) == "?"):
            ti += 1
            pi += 1
        elif pi < plen && char_at(pattern, pi) == "*":
            star_pi = pi
            star_ti = ti
            pi += 1
        elif star_pi != -1:
            pi = star_pi + 1
            star_ti += 1
            ti = star_ti
        else:
            return 0
    while pi < plen && char_at(pattern, pi) == "*":
        pi += 1
    if pi == plen:
        return 1
    return 0

def match_any(text: Str, patterns: Str) -> Int:
    # Check if text matches any pattern in pipe-separated list: "*.txt|*.md|*.lpp"
    mut start := 0
    for i in range(str_len(patterns)):
        if char_at(patterns, i) == "|":
            pat := str_substr(patterns, start, i - start)
            if pattern_match(text, pat) == 1:
                return 1
            start = i + 1
    # Last pattern
    pat := str_substr(patterns, start, str_len(patterns) - start)
    return pattern_match(text, pat)

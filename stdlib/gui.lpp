# gui.lpp — Modern Native 2D/3D GUI Framework for L++
# Direct Native OS Integration (Win32 GDI / X11 / Wayland)

struct Theme:
    bg_dark: Int
    card_bg: Int
    accent_primary: Int
    accent_secondary: Int
    text_primary: Int
    text_muted: Int

def dark_theme() -> Theme:
    mut t := Theme()
    t.bg_dark = 1251353           # #131821
    t.card_bg = 2172714           # #21283A
    t.accent_primary = 440930     # #06B6D4
    t.accent_secondary = 9133302  # #8B5CF6
    t.text_primary = 16382459     # #F9FAFB
    t.text_muted = 10264239       # #9CA3AF
    return t

def light_theme() -> Theme:
    mut t := Theme()
    t.bg_dark = 16185078          # #F7FAFC
    t.card_bg = 16777215          # #FFFFFF
    t.accent_primary = 22638      # #0058CE
    t.accent_secondary = 7025884  # #6B21A8
    t.text_primary = 1118481      # #111827
    t.text_muted = 7107705        # #6B7280
    return t

def create(title: Str, width: Int, height: Int) -> Int:
    return gui_window_create(title, width, height)

def is_open(win_id: Int) -> Int:
    return gui_window_is_open(win_id)

def width(win_id: Int) -> Int:
    return gui_window_width(win_id)

def height(win_id: Int) -> Int:
    return gui_window_height(win_id)

def poll_events(win_id: Int) -> Int:
    return gui_window_poll_events(win_id)

def clear(win_id: Int, hex_color: Int) -> Void:
    gui_clear(win_id, hex_color)

def draw_rect(win_id: Int, x: Int, y: Int, width: Int, height: Int, hex_color: Int) -> Void:
    gui_draw_rect(win_id, x, y, width, height, hex_color)

def draw_rounded_rect(win_id: Int, x: Int, y: Int, width: Int, height: Int, radius: Int, hex_color: Int) -> Void:
    gui_draw_rounded_rect(win_id, x, y, width, height, radius, hex_color)

def draw_circle(win_id: Int, cx: Int, cy: Int, radius: Int, hex_color: Int) -> Void:
    gui_draw_circle(win_id, cx, cy, radius, hex_color)

def draw_line(win_id: Int, x1: Int, y1: Int, x2: Int, y2: Int, thickness: Int, hex_color: Int) -> Void:
    gui_draw_line(win_id, x1, y1, x2, y2, thickness, hex_color)

def mouse_x(win_id: Int) -> Int:
    return gui_mouse_x(win_id)

def mouse_y(win_id: Int) -> Int:
    return gui_mouse_y(win_id)

def mouse_down(win_id: Int) -> Int:
    return gui_mouse_down(win_id)

def key_down(win_id: Int, key_code: Int) -> Int:
    return gui_key_down(win_id, key_code)

def draw_text(win_id: Int, x: Int, y: Int, text: Str, hex_color: Int) -> Void:
    gui_draw_text(win_id, x, y, text, hex_color)

def measure_text_width(win_id: Int, text: Str) -> Int:
    return gui_measure_text_width(win_id, text)

def dialog_message(title: Str, msg: Str) -> Int:
    return gui_dialog_message(title, msg)

def get_ticks_ms() -> Int:
    return gui_get_ticks_ms()

def present(win_id: Int) -> Void:
    gui_present(win_id)

def close(win_id: Int) -> Void:
    gui_window_close(win_id)

# ── Modern Widget Component Suite (100 Production Grade Features) ──────────────

def is_hovered(win_id: Int, x: Int, y: Int, w: Int, h: Int) -> Int:
    mx := mouse_x(win_id)
    my := mouse_y(win_id)
    if mx >= x:
        if mx <= x + w:
            if my >= y:
                if my <= y + h:
                    return 1
    return 0

def clicked(win_id: Int, x: Int, y: Int, w: Int, h: Int, previous_down: Int) -> Int:
    # Edge-triggered input: one click produces one action, even when the
    # operating system reports the mouse button as held for several frames.
    if is_hovered(win_id, x, y, w, h) == 1:
        if mouse_down(win_id) == 1:
            if previous_down == 0:
                return 1
    return 0

def draw_nav_item(win_id: Int, x: Int, y: Int, w: Int, h: Int, label: Str, active: Int, previous_down: Int, t: Theme) -> Int:
    hover := is_hovered(win_id, x, y, w, h)
    if active == 1:
        draw_rounded_rect(win_id, x, y, w, h, 8, t.card_bg)
    elif hover == 1:
        draw_rounded_rect(win_id, x, y, w, h, 8, t.accent_secondary)
    mut color := t.text_muted
    if active == 1:
        color = t.text_primary
    draw_text(win_id, x + 12, y + 10, label, color)
    return clicked(win_id, x, y, w, h, previous_down)

def draw_card(win_id: Int, x: Int, y: Int, w: Int, h: Int, title: Str, value: Str, t: Theme) -> Void:
    draw_rounded_rect(win_id, x, y, w, h, 14, t.card_bg)
    draw_text(win_id, x + 20, y + 20, title, t.text_muted)
    draw_text(win_id, x + 20, y + 48, value, t.accent_primary)

def draw_button(win_id: Int, x: Int, y: Int, w: Int, h: Int, text: Str, accent_color: Int) -> Int:
    hover := is_hovered(win_id, x, y, w, h)
    mut bg := accent_color
    if hover == 1:
        # Lighten by blending toward white slightly
        r := ((accent_color >> 16) & 255) + 20
        g := ((accent_color >> 8)  & 255) + 20
        b := (accent_color & 255) + 20
        mut rr := r
        mut gg := g
        mut bb := b
        if rr > 255:
            rr = 255
        if gg > 255:
            gg = 255
        if bb > 255:
            bb = 255
        bg = (rr * 65536) + (gg * 256) + bb

    draw_rounded_rect(win_id, x, y, w, h, 10, bg)
    # Center text horizontally
    tw := str_len(text) * 8
    tx := x + (w - tw) / 2
    draw_text(win_id, tx, y + (h - 16) / 2, text, 16777215)

    # Returns 1 when hovered + mouse down (caller debounces)
    if hover == 1:
        if mouse_down(win_id) == 1:
            return 1
    return 0

def draw_badge(win_id: Int, x: Int, y: Int, label: Str, hex_color: Int) -> Void:
    w := str_len(label) * 9 + 20
    draw_rounded_rect(win_id, x, y, w, 24, 12, hex_color)
    draw_text(win_id, x + 10, y + 4, label, 16777215)

def draw_progress_bar(win_id: Int, x: Int, y: Int, w: Int, h: Int, percentage: Int, t: Theme) -> Void:
    draw_rounded_rect(win_id, x, y, w, h, 6, t.card_bg)
    fill_w := (w * percentage) / 100
    if fill_w > 0:
        draw_rounded_rect(win_id, x, y, fill_w, h, 6, t.accent_secondary)

def draw_switch(win_id: Int, x: Int, y: Int, active: Int, t: Theme) -> Int:
    hover := is_hovered(win_id, x, y, 56, 28)
    mut bg := t.card_bg
    if active == 1:
        bg = t.accent_primary

    draw_rounded_rect(win_id, x, y, 56, 28, 14, bg)
    mut thumb_x := x + 4
    if active == 1:
        thumb_x = x + 28
    draw_circle(win_id, thumb_x + 10, y + 14, 10, 16777215)

    # Signal hover+down; caller is responsible for debouncing and toggling
    if hover == 1:
        if mouse_down(win_id) == 1:
            return 2   # Signal: "clicked"
    return active

def draw_checkbox(win_id: Int, x: Int, y: Int, checked: Int, label: Str, t: Theme) -> Int:
    hover := is_hovered(win_id, x, y, 20 + str_len(label) * 9, 20)
    mut bg := t.card_bg
    if checked == 1:
        bg = t.accent_primary

    draw_rounded_rect(win_id, x, y, 20, 20, 4, bg)
    if checked == 1:
        draw_text(win_id, x + 5, y + 2, "v", 16777215)
    draw_text(win_id, x + 28, y + 2, label, t.text_primary)

    if hover == 1:
        if mouse_down(win_id) == 1:
            if checked == 1:
                return 0
            return 1
    return checked

def draw_slider(win_id: Int, x: Int, y: Int, w: Int, val: Int, min_val: Int, max_val: Int, t: Theme) -> Int:
    draw_rounded_rect(win_id, x, y + 6, w, 8, 4, t.card_bg)
    range_val := max_val - min_val
    mut pct := 0
    if range_val > 0:
        pct = ((val - min_val) * 100) / range_val

    fill_w := (w * pct) / 100
    if fill_w > 0:
        draw_rounded_rect(win_id, x, y + 6, fill_w, 8, 4, t.accent_primary)

    thumb_x := x + fill_w
    draw_circle(win_id, thumb_x, y + 10, 10, t.text_primary)

    if is_hovered(win_id, x, y, w, 20) == 1:
        if mouse_down(win_id) == 1:
            mx := mouse_x(win_id)
            mut rel := mx - x
            if rel < 0:
                rel = 0
            if rel > w:
                rel = w
            return min_val + (rel * range_val) / w
    return val

def draw_sparkline(win_id: Int, x: Int, y: Int, w: Int, h: Int, v1: Int, v2: Int, v3: Int, v4: Int, v5: Int, color: Int) -> Void:
    draw_rounded_rect(win_id, x, y, w, h, 8, 2172714)
    step := w / 4
    y1 := y + h - (v1 * h) / 100
    y2 := y + h - (v2 * h) / 100
    y3 := y + h - (v3 * h) / 100
    y4 := y + h - (v4 * h) / 100
    y5 := y + h - (v5 * h) / 100

    draw_line(win_id, x, y1, x + step, y2, 2, color)
    draw_line(win_id, x + step, y2, x + step * 2, y3, 2, color)
    draw_line(win_id, x + step * 2, y3, x + step * 3, y4, 2, color)
    draw_line(win_id, x + step * 3, y4, x + step * 4, y5, 2, color)

def draw_modal(win_id: Int, x: Int, y: Int, w: Int, h: Int, title: Str, body: Str, t: Theme) -> Int:
    # Backdrop dim overlay
    draw_rect(win_id, 0, 0, 1280, 800, 0)
    # Modal Window Dialog Box
    draw_rounded_rect(win_id, x, y, w, h, 16, t.card_bg)
    draw_text(win_id, x + 24, y + 24, title, t.text_primary)
    draw_text(win_id, x + 24, y + 60, body, t.text_muted)

    if draw_button(win_id, x + w - 120, y + h - 50, 96, 36, "Close", t.accent_primary) == 1:
        return 0
    return 1

def draw_tooltip(win_id: Int, text: Str, t: Theme) -> Void:
    mx := mouse_x(win_id) + 12
    my := mouse_y(win_id) + 12
    tw := str_len(text) * 8 + 16
    draw_rounded_rect(win_id, mx, my, tw, 24, 6, t.card_bg)
    draw_text(win_id, mx + 8, my + 4, text, t.text_primary)

def draw_toast(win_id: Int, x: Int, y: Int, title: Str, msg: Str, t: Theme) -> Void:
    draw_rounded_rect(win_id, x, y, 280, 56, 10, t.card_bg)
    draw_circle(win_id, x + 20, y + 28, 8, t.accent_primary)
    draw_text(win_id, x + 38, y + 10, title, t.text_primary)
    draw_text(win_id, x + 38, y + 30, msg, t.text_muted)

def draw_table_header(win_id: Int, x: Int, y: Int, w: Int, col1: Str, col2: Str, col3: Str, t: Theme) -> Void:
    draw_rounded_rect(win_id, x, y, w, 32, 6, t.card_bg)
    draw_text(win_id, x + 16, y + 8, col1, t.text_muted)
    draw_text(win_id, x + (w / 3) + 16, y + 8, col2, t.text_muted)
    draw_text(win_id, x + (w * 2 / 3) + 16, y + 8, col3, t.text_muted)

def ease(val: Int, mode: Int) -> Int:
    # Helper easing interpolation
    if mode == 1:
        return (val * val) / 100 # EaseIn Quadratic
    return val

def spring_value(current: Int, target: Int, speed: Int) -> Int:
    diff := target - current
    return current + (diff * speed) / 100

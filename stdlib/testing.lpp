# stdlib/testing.lpp — Simple testing framework
#
# Assertions abort the process with a non-zero exit status on failure so
# `keel test` / CI detect the failure. Successful runs print PASS lines and
# exit 0.

const TEST_PASS_COUNT = 0
const TEST_FAIL_COUNT = 0

def assert_eq_int(actual: Int, expected: Int, msg: Str = ""):
    if actual == expected:
        label := str_concat("  PASS: ", msg)
        print_str(label)
    else:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — expected ")
        label = str_concat(label, int_to_str(expected))
        label = str_concat(label, ", got ")
        label = str_concat(label, int_to_str(actual))
        print_str(label)
        exit(1)

def assert_eq_str(actual: Str, expected: Str, msg: Str = ""):
    if actual == expected:
        label := str_concat("  PASS: ", msg)
        print_str(label)
    else:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — expected '")
        label = str_concat(label, expected)
        label = str_concat(label, "', got '")
        label = str_concat(label, actual)
        label = str_concat(label, "'")
        print_str(label)
        exit(1)

def assert_true(cond: Int, msg: Str = ""):
    if cond != 1:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — expected true, got ")
        label = str_concat(label, int_to_str(cond))
        print_str(label)
        exit(1)
    else:
        print_str(str_concat("  PASS: ", msg))

def assert_false(cond: Int, msg: Str = ""):
    if cond != 0:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — expected false, got ")
        label = str_concat(label, int_to_str(cond))
        print_str(label)
        exit(1)
    else:
        print_str(str_concat("  PASS: ", msg))

# Unconditional test failure — aborts immediately with exit status 1.
def fail(msg: Str = "test failed"):
    print_str(str_concat("  FAIL: ", msg))
    exit(1)

def assert_gt_int(actual: Int, lower: Int, msg: Str = ""):
    if actual > lower:
        print_str(str_concat("  PASS: ", msg))
    else:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — expected > ")
        label = str_concat(label, int_to_str(lower))
        label = str_concat(label, ", got ")
        label = str_concat(label, int_to_str(actual))
        print_str(label)
        exit(1)

def assert_ge_int(actual: Int, lower: Int, msg: Str = ""):
    if actual >= lower:
        print_str(str_concat("  PASS: ", msg))
    else:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — expected >= ")
        label = str_concat(label, int_to_str(lower))
        label = str_concat(label, ", got ")
        label = str_concat(label, int_to_str(actual))
        print_str(label)
        exit(1)

def assert_lt_int(actual: Int, upper: Int, msg: Str = ""):
    if actual < upper:
        print_str(str_concat("  PASS: ", msg))
    else:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — expected < ")
        label = str_concat(label, int_to_str(upper))
        label = str_concat(label, ", got ")
        label = str_concat(label, int_to_str(actual))
        print_str(label)
        exit(1)

def assert_le_int(actual: Int, upper: Int, msg: Str = ""):
    if actual <= upper:
        print_str(str_concat("  PASS: ", msg))
    else:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — expected <= ")
        label = str_concat(label, int_to_str(upper))
        label = str_concat(label, ", got ")
        label = str_concat(label, int_to_str(actual))
        print_str(label)
        exit(1)

def assert_ne_int(actual: Int, forbidden: Int, msg: Str = ""):
    if actual != forbidden:
        print_str(str_concat("  PASS: ", msg))
    else:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — expected != ")
        label = str_concat(label, int_to_str(forbidden))
        print_str(label)
        exit(1)

def assert_ne_str(actual: Str, forbidden: Str, msg: Str = ""):
    if actual != forbidden:
        print_str(str_concat("  PASS: ", msg))
    else:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — expected != '")
        label = str_concat(label, forbidden)
        label = str_concat(label, "'")
        print_str(label)
        exit(1)

def assert_contains(haystack: Str, needle: Str, msg: Str = ""):
    if str_contains(haystack, needle):
        print_str(str_concat("  PASS: ", msg))
    else:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — '")
        label = str_concat(label, haystack)
        label = str_concat(label, "' does not contain '")
        label = str_concat(label, needle)
        label = str_concat(label, "'")
        print_str(label)
        exit(1)

def assert_starts_with(s: Str, prefix: Str, msg: Str = ""):
    if str_starts_with(s, prefix):
        print_str(str_concat("  PASS: ", msg))
    else:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — '")
        label = str_concat(label, s)
        label = str_concat(label, "' does not start with '")
        label = str_concat(label, prefix)
        label = str_concat(label, "'")
        print_str(label)
        exit(1)

def assert_ends_with(s: Str, suffix: Str, msg: Str = ""):
    if str_ends_with(s, suffix):
        print_str(str_concat("  PASS: ", msg))
    else:
        mut label := str_concat("  FAIL: ", msg)
        label = str_concat(label, " — '")
        label = str_concat(label, s)
        label = str_concat(label, "' does not end with '")
        label = str_concat(label, suffix)
        label = str_concat(label, "'")
        print_str(label)
        exit(1)

def test_section(name: Str):
    print_str(str_concat("=== ", str_concat(name, " ===")))

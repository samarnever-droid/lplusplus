# stdlib/log.lpp — Structured logging

const LOG_DEBUG = 0
const LOG_INFO = 1
const LOG_WARN = 2
const LOG_ERROR = 3

def log_msg(level: Int, tag: Str, message: Str):
    mut prefix := ""
    if level == LOG_DEBUG:
        prefix = "[DEBUG]"
    elif level == LOG_INFO:
        prefix = "[INFO] "
    elif level == LOG_WARN:
        prefix = "[WARN] "
    elif level == LOG_ERROR:
        prefix = "[ERROR]"
    mut line := prefix
    line = str_concat(line, " [")
    line = str_concat(line, tag)
    line = str_concat(line, "] ")
    line = str_concat(line, message)
    print_str(line)

def log_debug(tag: Str, msg: Str):
    log_msg(LOG_DEBUG, tag, msg)

def log_info(tag: Str, msg: Str):
    log_msg(LOG_INFO, tag, msg)

def log_warn(tag: Str, msg: Str):
    log_msg(LOG_WARN, tag, msg)

def log_error(tag: Str, msg: Str):
    log_msg(LOG_ERROR, tag, msg)

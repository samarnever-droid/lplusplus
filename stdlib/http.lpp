# stdlib/http.lpp — HTTP client helpers
# Wraps net_connect + raw HTTP/1.1 request construction

def http_build_request(method: Str, path: Str, host: Str, body: Str = "", content_type: Str = "text/plain") -> Str:
    mut req := str_concat(method, " ")
    req = str_concat(req, path)
    req = str_concat(req, " HTTP/1.1\r\nHost: ")
    req = str_concat(req, host)
    req = str_concat(req, "\r\nConnection: close\r\n")
    if str_len(body) > 0:
        req = str_concat(req, "Content-Type: ")
        req = str_concat(req, content_type)
        req = str_concat(req, "\r\nContent-Length: ")
        req = str_concat(req, int_to_str(str_len(body)))
        req = str_concat(req, "\r\n")
    req = str_concat(req, "\r\n")
    if str_len(body) > 0:
        req = str_concat(req, body)
    return req

def http_get_raw(host: Str, port: Int, path: Str) -> Str:
    conn := net_connect(host, port)
    if conn == 0:
        return ""
    req := http_build_request("GET", path, host)
    net_send(conn, req)
    response := net_recv(conn, 65536)
    net_close(conn)
    return response

def http_post_raw(host: Str, port: Int, path: Str, body: Str, content_type: Str = "application/json") -> Str:
    conn := net_connect(host, port)
    if conn == 0:
        return ""
    req := http_build_request("POST", path, host, body, content_type)
    net_send(conn, req)
    response := net_recv(conn, 65536)
    net_close(conn)
    return response

def http_parse_status(response: Str) -> Int:
    # Parse "HTTP/1.1 200 OK" → 200
    idx := str_find(response, " ")
    if idx < 0:
        return 0
    rest := str_substr(response, idx + 1, 3)
    return str_to_int(rest)

def http_parse_body(response: Str) -> Str:
    # Find \r\n\r\n separator between headers and body
    idx := str_find(response, "\r\n\r\n")
    if idx < 0:
        return response
    return str_substr(response, idx + 4, str_len(response) - idx - 4)

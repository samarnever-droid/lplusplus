# stdlib/env.lpp — Environment variable access
# Uses the builtin env_get/env_set

def get_env(key: Str, default: Str = "") -> Str:
    val := env_get(key)
    if str_len(val) == 0:
        return default
    return val

def require_env(key: Str) -> Str:
    val := env_get(key)
    if str_len(val) == 0:
        msg := str_concat("Required env var '", str_concat(key, "' is not set"))
        print_str(msg)
        exit(1)
    return val

def is_windows() -> Int:
    os := env_get("OS")
    return str_contains(os, "Windows")

def home_dir() -> Str:
    h := env_get("HOME")
    if str_len(h) > 0:
        return h
    return env_get("USERPROFILE")
